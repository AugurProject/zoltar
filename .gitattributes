# Generated outputs should stay untracked. These attributes keep accidental
# tracked diffs out of normal review views.
/shared/js/** linguist-generated=true
/solidity/artifacts/** linguist-generated=true
/solidity/ts/types/contractArtifact.ts linguist-generated=true
/ui/js/** linguist-generated=true
/ui/ts/abis.ts linguist-generated=true
/ui/ts/contractArtifact.ts linguist-generated=true
/ui/ts/deploymentArtifacts.ts linguist-generated=true
/ui/ts/deploymentsArtifacts.ts linguist-generated=true

# Bundled UI dependencies are build outputs, not source.
/ui/vendor/** linguist-vendored=true

# This vendored deployment input has a pinned canonical-text digest.
/scripts/artifacts/uniswap-deployment.json text eol=lf

# Third-party Solidity sources are intentionally vendored for compilation.
/solidity/contracts/statoblast/openOracle/openzeppelin/** linguist-vendored=true

# Solidity source bytes affect compiler metadata and deterministic deployment hashes.
*.sol text eol=lf

# Shell entrypoints must retain Unix line endings so their shebangs are executable
# inside Linux containers, including when the repository is checked out on Windows.
*.sh text eol=lf

# This vendored artifact is checked byte-for-byte against a pinned SHA-256 digest.
/scripts/artifacts/uniswap-deployment.json text eol=lf
