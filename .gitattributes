# Linguist attributes for generated and vendored outputs mirror tooling/repo/generated-artifacts.ts;
# `bun run check:generated-policy` keeps them in sync. Ignored outputs are marked so accidental tracked
# diffs stay out of normal review views; tracked outputs are collapsed because their generators own them.

# Ignored build outputs.
/shared/*/js/** linguist-generated=true
/solidity/artifacts/** linguist-generated=true
/solidity/ts/types/contractArtifact.ts linguist-generated=true
/ui/*/js/** linguist-generated=true
/ui/*/dist/** linguist-generated=true
/ui/coreShared/ts/abis.ts linguist-generated=true
/ui/coreShared/ts/contractArtifact.ts linguist-generated=true
/ui/statoblastShared/ts/contractArtifact.ts linguist-generated=true
/ui/trading/ts/generated/contractArtifact.ts linguist-generated=true
/ui/*/vendor/** linguist-vendored=true

# Tracked generated outputs, each with a freshness check.
/docs/assets/js/*.js linguist-generated=true
/docs/reference/contracts.html linguist-generated=true
/docs/reference/contracts/*.html linguist-generated=true
/docs/assets/screenshots/** linguist-generated=true
/bots/shared/src/contracts/abi.generated.ts linguist-generated=true
/bots/open-oracle-arbitrager/src/contracts/artifacts.generated.ts linguist-generated=true
/bots/open-oracle-arbitrager/tests/contracts/harness-artifacts.generated.ts linguist-generated=true
/bots/open-oracle-arbitrager/src/contracts/executor-abi.generated.ts linguist-generated=true
/bots/open-oracle-arbitrager/docs/chart-runtime.js linguist-generated=true
/augurScan/config/dependency-abis.json linguist-vendored=true

# This vendored artifact is checked byte-for-byte against a pinned SHA-256 digest, so it keeps LF endings.
/scripts/artifacts/uniswap-deployment.json linguist-generated=true text eol=lf

# Third-party Solidity sources are intentionally vendored for compilation.
/solidity/contracts/statoblast/openOracle/openzeppelin/** linguist-vendored=true

# Solidity source bytes affect compiler metadata and deterministic deployment hashes.
*.sol text eol=lf

# Shell entrypoints must retain Unix line endings so their shebangs are executable
# inside Linux containers, including when the repository is checked out on Windows.
*.sh text eol=lf
