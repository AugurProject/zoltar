{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": ["ESNext", "DOM"],
		"types": ["bun-types", "node"],
		"paths": {
			"@zoltar/ui-core-shared/*": ["./ui/coreShared/ts/*"],
			"@zoltar/ui-zoltar-shared/*": ["./ui/zoltarShared/ts/*"],
			"@zoltar/ui-statoblast-shared/*": ["./ui/statoblastShared/ts/*"]
		}
	},
	"include": ["bun-test-setup*.ts", "scripts/**/*.mts", "scripts/**/*.ts", "solidity/ts/types/index.d.ts", "tooling/**/*.mts", "tooling/**/*.ts"],
	"exclude": ["tooling/ui/browserSmoke.test.ts", "tooling/ui/productionBuild.test.ts"]
}
