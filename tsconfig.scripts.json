{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": ["ESNext", "DOM"],
		"types": ["bun-types", "node"],
		"paths": {
			"@zoltar/ui-core-shared/*": ["./ui/coreShared/ts/*"],
			"@zoltar/ui-zoltar/*": ["./ui/zoltar/ts/*"],
			"@zoltar/ui-statoblast/*": ["./ui/statoblast/ts/*"]
		}
	},
	"include": ["bun-test-setup*.ts", "scripts/**/*.mts", "scripts/**/*.ts", "ui/coreShared/build/**/*.mts", "ui/coreShared/dev-server.ts"]
}
