{
	"workspaces": {
		".": {
			"entry": ["docs/charts/chartRuntime.ts", "solidity/ts/compile.ts", "solidity/ts/gas-costs.ts", "solidity/ts/tests/**/*.ts", "solidity/ts/fuzz/**/*.ts", "solidity/ts/types/bun-test.d.ts", "solidity/ts/types/index.d.ts", "tooling/**/*.test.ts", "tooling/repo/ensure-shared-package-fresh.mts"],
			"project": ["docs/charts/**/*.ts", "tooling/**/*.ts", "tooling/**/*.mts", "solidity/ts/**/*.ts"],
			"ignoreIssues": {
				"solidity/ts/**/*.ts": ["unlisted"]
			},
			"ignore": ["docs/charts/virtualModules.d.ts"]
		},
		"ui/coreShared": {
			"entry": ["ts/tests/**/*.ts", "ts/tests/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["./ts/*"]
			},
			"ignore": ["ts/simulation/tevmWorker.ts", "ts/simulation/tevmEngine.ts"]
		},
		"ui/zoltarDomain": {
			"entry": ["ts/**/*.ts", "ts/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["./ts/*"]
			},
			"ignoreDependencies": ["bun-types"]
		},
		"ui/statoblastDomain": {
			"entry": ["ts/**/*.ts", "ts/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-statoblast-domain/*": ["./ts/*"]
			},
			"ignoreDependencies": ["bun-types"]
		},
		"ui/tradingDomain": {
			"entry": ["ts/**/*.ts", "ts/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-trading-domain/*": ["./ts/*"]
			},
			"ignoreDependencies": ["bun-types"]
		},
		"ui/zoltar": {
			"entry": ["ts/tests/**/*.ts", "ts/tests/**/*.tsx", "ts/index.ts"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-zoltar/*": ["./ts/*"]
			},
			"ignore": ["ts/index.dev.ts", "ts/simulation/tevmWorker.ts"]
		},
		"ui/statoblast": {
			"entry": ["ts/tests/**/*.ts", "ts/tests/**/*.tsx", "ts/index.ts"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-statoblast-domain/*": ["../statoblastDomain/ts/*"],
				"@zoltar/ui-statoblast/*": ["./ts/*"]
			},
			"ignore": ["ts/index.dev.ts", "ts/simulation/tevmWorker.ts"]
		},
		"ui/trading": {
			"entry": ["ts/tests/**/*.ts", "ts/tests/**/*.tsx", "ts/index.ts", "ts/simulation/tevmWorker.ts"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-statoblast-domain/*": ["../statoblastDomain/ts/*"],
				"@zoltar/ui-trading-domain/*": ["../tradingDomain/ts/*"],
				"@zoltar/ui-trading/*": ["./ts/*"]
			},
			"ignore": ["ts/index.dev.ts"],
			"ignoreDependencies": ["bun-types"]
		}
	},
	"ignoreDependencies": ["better-typescript-lib", "@preact/signals", "tevm", "@noble/curves", "@noble/hashes", "micro-eth-signer", "micro-packed", "funtypes", "solc-0-8-28"],
	"ignoreUnresolved": ["./bun-test-setup-ui.ts"]
}
