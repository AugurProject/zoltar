{
	"workspaces": {
		".": {
			"entry": [
				"docs/charts/chartRuntime.ts!",
				"docs/runtime/{auctionClearing,deploymentMaskDecoder,docsShell,responsiveDocs,interactiveTools,invariantExplorer,mmrProofPlanner,openOracleTools}.ts!",
				"tooling/**/*.test.ts",
				"bun-test-setup*.ts",
				"docs/{charts/virtualModules,runtime/globals}.d.ts!",
				"tooling/repo/knip-baseline.mts"
			],
			"project": ["docs/runtime/**/*.ts!", "docs/charts/**/*.ts", "tooling/**/*.{ts,mts}", "bun-test-setup*.ts"],
			"ignoreDependencies": ["@preact/signals", "tevm"]
		},
		"ui/coreShared": {
			"entry": ["ts/tests/**/*.{ts,tsx}"],
			"project": ["ts/**/*.{ts,tsx}!"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["@noble/curves", "@noble/hashes", "micro-eth-signer", "micro-packed"],
			"ignoreUnresolved": ["./bun-test-setup-solidity.ts"]
		},
		"ui/zoltarDomain": {
			"entry": ["ts/**/*.ts", "ts/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["bun-types"]
		},
		"ui/statoblastDomain": {
			"entry": ["ts/**/*.ts", "ts/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-statoblast-domain/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["bun-types"]
		},
		"ui/tradingDomain": {
			"entry": ["ts/**/*.ts", "ts/**/*.tsx"],
			"project": ["ts/**/*.ts", "ts/**/*.tsx"],
			"paths": {
				"@zoltar/ui-trading-domain/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["bun-types"]
		},
		"ui/zoltar": {
			"entry": ["ts/tests/**/*.{ts,tsx}", "ts/index.ts!", "ts/index.dev.ts!", "ts/simulation/tevmWorker.ts!"],
			"project": ["ts/**/*.{ts,tsx}!"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-zoltar/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["tevm"],
			"ignoreUnresolved": ["./bun-test-setup-solidity.ts"]
		},
		"ui/statoblast": {
			"entry": ["ts/tests/**/*.{ts,tsx}", "ts/index.ts!", "ts/index.dev.ts!", "ts/simulation/tevmWorker.ts!"],
			"project": ["ts/**/*.{ts,tsx}!"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-statoblast-domain/*": ["../statoblastDomain/ts/*"],
				"@zoltar/ui-statoblast/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["tevm"],
			"ignoreUnresolved": ["./bun-test-setup-solidity.ts"]
		},
		"ui/trading": {
			"entry": ["ts/tests/**/*.{ts,tsx}", "ts/index.ts!", "ts/index.dev.ts!", "ts/simulation/tevmWorker.ts!"],
			"project": ["ts/**/*.{ts,tsx}!"],
			"paths": {
				"@zoltar/ui-core-shared/*": ["../coreShared/ts/*"],
				"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/ts/*"],
				"@zoltar/ui-statoblast-domain/*": ["../statoblastDomain/ts/*"],
				"@zoltar/ui-trading-domain/*": ["../tradingDomain/ts/*"],
				"@zoltar/ui-trading/*": ["./ts/*"],
				"@zoltar/shared/*": ["../../shared/ts/*"]
			},
			"ignoreDependencies": ["tevm", "@preact/signals", "bun-types"]
		},
		"solidity": {
			"entry": ["ts/compile.ts!", "ts/gas-costs.ts!", "ts/trading/deploy/*.mts!", "ts/tests/**/*.ts", "ts/fuzz/**/*.ts", "ts/types/*.d.ts"],
			"project": ["ts/**/*.{ts,mts}!", "!ts/testSupport/**!", "!ts/tests/**!"]
		},
		"shared": {
			"entry": ["ts/**/*.test.ts"],
			"project": ["ts/**/*.ts!"],
			"ignoreUnresolved": ["./bun-test-setup-solidity.ts"]
		},
		"augurScan": {
			"entry": ["src/server.ts!", "src/indexer-process.ts!", "browser/app.ts!", "tests/**/*.ts", "scripts/{build-browser,check-ethereum-imports,check-import-boundaries,check-project-metadata,dev,serve-demo,snapshot-project-metadata,verify-compose-source,verify-export-page}.ts!"],
			"project": ["{src,browser,scripts}/**/*.ts!", "tests/**/*.ts"]
		},
		"bots/shared": {
			"entry": ["tests/**/*.ts"],
			"project": ["src/**/*.ts!", "tests/**/*.ts"]
		},
		"bots/chaos": {
			"entry": ["src/cli/*.ts!", "scripts/*.mts!", "tests/**/*.ts", "src/dashboard/dashboard.ts!"],
			"project": ["src/**/*.ts!", "scripts/*.{ts,mts}!", "tests/**/*.ts"]
		},
		"bots/liquidator": {
			"entry": ["src/cli/*.ts!", "scripts/*.mts!", "tests/**/*.ts", "src/dashboard/dashboard.ts!"],
			"project": ["src/**/*.ts!", "scripts/*.{ts,mts}!", "tests/**/*.ts"]
		},
		"bots/open-oracle-arbitrager": {
			"entry": ["src/cli/*.ts!", "scripts/*.mts!", "tests/**/*.ts", "src/dashboard/dashboard.ts!", "docs/chart-runtime.ts!", "src/config/execution-manifest.ts!"],
			"project": ["src/**/*.ts!", "scripts/*.{ts,mts}!", "tests/**/*.ts", "docs/*.ts!"]
		}
	},
	"ignoreDependencies": ["better-typescript-lib"]
}
