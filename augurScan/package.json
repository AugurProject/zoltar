{
	"name": "augur-scan",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"start": "bun src/server.ts",
		"migrate": "bun src/migrate.ts",
		"metadata:snapshot": "bun scripts/snapshot-project-metadata.ts",
		"qa:serve": "bun scripts/serve-demo.ts",
		"test": "bun test",
		"test:integration": "bun test tests/postgres.integration.test.ts",
		"typecheck": "bun x tsc --noEmit",
		"check:ethereum-imports": "bun scripts/check-ethereum-imports.ts",
		"check": "bun run check:ethereum-imports && bun x biome check .",
		"format": "bun x biome check --write ."
	},
	"dependencies": {
		"@noble/hashes": "2.2.0",
		"micro-eth-signer": "0.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/bun": "1.3.11",
		"solc": "0.8.35",
		"typescript": "5.8.2"
	},
	"knip": {
		"entry": [
			"scripts/*.ts",
			"public/app.js",
			"tests/*.test.ts"
		],
		"project": [
			"src/**/*.ts",
			"scripts/**/*.ts",
			"public/**/*.js",
			"tests/**/*.ts"
		]
	}
}
