{
	"name": "augur-scan",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun scripts/build-browser.ts",
		"dev": "bun scripts/dev.ts",
		"start": "bun run build && bun src/server.ts",
		"start:indexer": "bun src/indexer-process.ts",
		"schema:init": "bun src/schema.ts",
		"metadata:snapshot": "bun scripts/snapshot-project-metadata.ts",
		"metadata:check": "bun scripts/check-project-metadata.ts",
		"qa:serve": "bun run build && bun scripts/serve-demo.ts",
		"test": "bun run test:unit && bun run test:api && bun run test:replay && bun run test:integration",
		"test:unit": "bun test tests/unit",
		"test:api": "bun test tests/api",
		"test:replay": "bun test tests/replay",
		"test:integration": "bun test tests/integration",
		"typecheck": "cd .. && bun install --frozen-lockfile && cd augurScan && bun x tsc --noEmit",
		"check:ethereum-imports": "bun scripts/check-ethereum-imports.ts",
		"check:boundaries": "bun scripts/check-import-boundaries.ts",
		"check": "bun run check:ethereum-imports && bun run check:boundaries && bun run metadata:check && bun x biome check .",
		"format": "bun x biome check --write ."
	},
	"dependencies": {
		"@noble/hashes": "2.2.0",
		"micro-eth-signer": "0.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/bun": "1.3.11",
		"typescript": "5.8.2"
	},
	"knip": {
		"entry": [
			"scripts/*.ts",
			"browser/app.ts",
			"tests/**/*.test.ts"
		],
		"project": [
			"src/**/*.ts",
			"scripts/**/*.ts",
			"browser/**/*.ts",
			"tests/**/*.ts"
		]
	}
}
