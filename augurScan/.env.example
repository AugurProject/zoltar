POSTGRES_PASSWORD=change-me
# Bundled PostgreSQL WAL budget for backfill. Leave disk headroom: this is a soft limit.
# Apply changes with `docker compose up -d postgres`; indexed data stays in its named volume.
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_URL=postgres://augurscan:change-me@postgres:5432/augurscan
PORT=3000
NETWORKS=mainnet,sepolia
MAINNET_RPC_URL=https://mainnet.gateway.tenderly.co
MAINNET_START_BLOCK=0
# Optional additional TwoWayConstantProductFactory. Canonical Trading roots are derived automatically; adding a source can replay the network.
MAINNET_AMM_FACTORY_ADDRESS=
# Uniswap activity sources: leave empty to use the network default, set an address to override it (for example on a fork), or set `none` to disable it. Enabling a source the database has not indexed before can replay that network.
MAINNET_UNISWAP_V2_FACTORY_ADDRESS=
MAINNET_UNISWAP_V3_FACTORY_ADDRESS=
MAINNET_UNISWAP_V4_POOL_MANAGER_ADDRESS=
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
SEPOLIA_START_BLOCK=0
# Optional additional TwoWayConstantProductFactory. Canonical Trading roots are derived automatically; adding a source can replay the network.
SEPOLIA_AMM_FACTORY_ADDRESS=
# Same rules as the mainnet Uniswap variables above.
SEPOLIA_UNISWAP_V2_FACTORY_ADDRESS=
SEPOLIA_UNISWAP_V3_FACTORY_ADDRESS=
SEPOLIA_UNISWAP_V4_POOL_MANAGER_ADDRESS=
POLL_INTERVAL_MS=12000
LOG_SCAN_RANGE_SIZE=100000
# Process-local limit per client IP. Set 0 only when an upstream limiter is authoritative.
API_RATE_LIMIT_PER_MINUTE=600
# Set 1 for an API-only standby that never competes for a network writer lease.
DISABLE_INDEXER=0
