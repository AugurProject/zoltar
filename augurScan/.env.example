POSTGRES_PASSWORD=change-me
POSTGRES_URL=postgres://augurscan:change-me@postgres:5432/augurscan
PORT=3000
NETWORKS=mainnet,sepolia
MAINNET_RPC_URL=https://mainnet.gateway.tenderly.co
MAINNET_START_BLOCK=0
# Optional deployed TwoWayConstantProductFactory. Rebuild the database after adding it to an indexed network.
MAINNET_AMM_FACTORY_ADDRESS=
# Canonical mainnet defaults are built in. Set an empty value to disable a venue or override for a fork.
MAINNET_UNISWAP_V2_FACTORY_ADDRESS=0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
MAINNET_UNISWAP_V3_FACTORY_ADDRESS=0x1F98431c8aD98523631AE4a59f267346ea31F984
MAINNET_UNISWAP_V4_POOL_MANAGER_ADDRESS=0x000000000004444c5dc75cB358380D2e3dE08A90
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
SEPOLIA_START_BLOCK=0
# Optional deployed TwoWayConstantProductFactory. Rebuild the database after adding it to an indexed network.
SEPOLIA_AMM_FACTORY_ADDRESS=
SEPOLIA_UNISWAP_V2_FACTORY_ADDRESS=
SEPOLIA_UNISWAP_V3_FACTORY_ADDRESS=0x0227628f3F023bb0B980b67D528571c95c6DaC1c
# Set this to the PoolManager deployed by this repository's testnet deployment.
SEPOLIA_UNISWAP_V4_POOL_MANAGER_ADDRESS=
POLL_INTERVAL_MS=12000
LOG_SCAN_RANGE_SIZE=2000
# Optional browser-compatible HTTP Basic protection. Configure both values or neither.
AUGURSCAN_ACCESS_USERNAME=
AUGURSCAN_ACCESS_PASSWORD=
# Process-local limit per client IP. Set 0 only when an upstream limiter is authoritative.
API_RATE_LIMIT_PER_MINUTE=600
# Set 1 for an API-only standby that never competes for a network writer lease.
DISABLE_INDEXER=0
