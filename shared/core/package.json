			"default": "./js/deployment/deploymentAddresses.js"
		},
		"./deployment/protocolConfig": {
			"types": "./ts/deployment/protocolConfig.ts",
			"bun": "./ts/deployment/protocolConfig.ts",
			"default": "./js/deployment/protocolConfig.js"
		},
		"./evm/ethereum": {
			"types": "./ts/evm/ethereum.ts",
