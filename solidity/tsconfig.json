{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@zoltar/core-shared/*": [
				"../shared/core/ts/*"
			],
			"@zoltar/zoltar-shared/*": [
				"../shared/zoltar/ts/*"
			],
			"@zoltar/open-oracle-shared/*": [
				"../shared/openOracle/ts/*"
			],
			"@zoltar/statoblast-shared/*": [
				"../shared/statoblast/ts/*"
			],
			"@zoltar/trading-shared/*": [
				"../shared/trading/ts/*"
			]
		},
		"rootDir": "ts",
		"outDir": "js",
		"sourceMap": false,
		"inlineSources": false,
		"declaration": false,
		"declarationMap": false,
		"noEmit": false,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"lib": [
			"ESNext",
			"DOM"
		],
		"skipLibCheck": true,
		"types": [
			"bun-types"
		]
	},
	"include": [
		"./ts/**/*.ts"
	]
}
