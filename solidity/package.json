{
	"version": "1.0.0",
	"name": "@zoltar/contracts",
	"private": true,
	"type": "module",
	"description": "Zoltar Contracts",
	"scripts": {
		"preinstall": "bun ../tooling/repo/link-shared-node-modules.mts",
		"check:shared-dependency": "bun ../tooling/repo/ensure-shared-package-fresh.mts",
		"refresh:shared-dependency": "bun ../tooling/repo/ensure-shared-package-fresh.mts --refresh",
		"shared": "cd .. && bun run shared:build",
		"ensure-contract-artifacts": "bun ../tooling/contracts/ensure-contract-artifacts.mts",
		"setup": "bun ../tooling/repo/install-frozen.mts . && bun run compile-contracts",
		"generate:contract-artifacts": "bun run compile-contracts",
		"compile-contracts": "bun run shared && bun run refresh:shared-dependency && bun run compile-contracts:current",
		"compile-contracts:current": "bun tsc --project tsconfig-compile.json && bun ./js/compile.js && cd .. && bun run generate:ui-contract-artifact && bun ./tooling/contracts/ensure-contract-artifacts.mts --sync-contract-freshness",
		"gas-costs": "cd .. && bun run ensure-shared-build && cd solidity && bun run ./ts/gas-costs.ts",
		"test": "bun run ensure-contract-artifacts && bun tsc && bun test --timeout 300000 ./js/tests/"
	},
	"keywords": [],
	"author": "",
	"license": "Unlicense",
	"dependencies": {
		"@zoltar/core-shared": "file:../shared/core",
		"@zoltar/open-oracle-shared": "file:../shared/openOracle",
		"@zoltar/statoblast-shared": "file:../shared/statoblast",
		"@zoltar/trading-shared": "file:../shared/trading"
	},
	"devDependencies": {
		"funtypes": "5.1.1",
		"knip": "6.17.1",
		"bun-types": "1.4.2",
		"micro-eth-signer": "0.18.1",
		"solc": "0.8.35",
		"solc-0-8-28": "npm:solc@0.8.28",
		"typescript": "5.8.2",
		"@zoltar/zoltar-shared": "file:../shared/zoltar"
	},
	"overrides": {
		"tmp": "0.2.7",
		"ws": "8.21.0",
		"@zoltar/core-shared": "file:../shared/core",
		"@zoltar/open-oracle-shared": "file:../shared/openOracle",
		"@zoltar/statoblast-shared": "file:../shared/statoblast",
		"@zoltar/trading-shared": "file:../shared/trading",
		"@zoltar/zoltar-shared": "file:../shared/zoltar"
	}
}
