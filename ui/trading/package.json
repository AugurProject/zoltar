{
	"description": "Statoblast conditional prediction-market trading interface",
	"name": "@zoltar/ui-trading",
	"private": true,
	"repository": {},
	"license": "Unlicense",
	"type": "module",
	"devDependencies": {
		"better-typescript-lib": "2.11.0",
		"bun-types": "1.4.2",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@preact/signals": "2.0.1",
		"@zoltar/ui-core-shared": "file:../coreShared",
		"@zoltar/ui-statoblast-shared": "file:../statoblastShared",
		"preact": "10.26.4",
		"tevm": "1.0.0-rc.151",
		"@zoltar/core-shared": "file:../../shared/core",
		"@zoltar/trading-shared": "file:../../shared/trading",
		"@zoltar/zoltar-shared": "file:../../shared/zoltar"
	},
	"overrides": {
		"@tevm/actions": "1.0.0-rc.151",
		"@tevm/node": "1.0.0-rc.151",
		"@tevm/server": "1.0.0-rc.151",
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.6",
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"tmp": "0.2.7",
		"ws": "8.21.0",
		"@zoltar/ui-core-shared": "file:../coreShared",
		"@zoltar/core-shared": "file:../../shared/core",
		"@zoltar/zoltar-shared": "file:../../shared/zoltar",
		"@zoltar/ui-statoblast-shared": "file:../statoblastShared",
		"@zoltar/ui-zoltar-shared": "file:../zoltarShared",
		"@zoltar/open-oracle-shared": "file:../../shared/openOracle",
		"@zoltar/statoblast-shared": "file:../../shared/statoblast",
		"@zoltar/trading-shared": "file:../../shared/trading"
	},
	"scripts": {
		"generate": "bun ../../tooling/contracts/build-app-contracts.mts trading && bun ../../tooling/repo/build-shared.mts trading && bun ../../tooling/ui/vendor.mts trading --scoped-artifacts",
		"vendor": "bun ../../tooling/ui/vendor.mts trading",
		"build:workers": "bun ../../tooling/ui/workers.mts trading",
		"build:tests": "bun ../../tooling/ui/tests.mts trading",
		"test": "bun run generate && bun test --isolate ./ts/tests",
		"build": "bun ../../tooling/ui/apps.mts trading",
		"build:prod": "bun run build && bun ../../tooling/ui/production.mts trading",
		"watch": "bun run generate && bun ../../tooling/ui/watch.mts trading",
		"serve": "bun ../../tooling/ui/dev-server.ts trading",
		"qa:browser": "bun ./scripts/browser-qa.mts",
		"docker:build": "docker build --file ../Dockerfile --target local-runtime-trading --tag zoltar-trading ../..",
		"docker:run": "docker run --rm --env UI_APP=trading --publish 4163:8080 zoltar-trading"
	}
}
