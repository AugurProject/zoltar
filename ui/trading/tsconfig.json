{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@zoltar/shared/*": ["../../shared/js/*"],
			"@zoltar/ui-core-shared/*": ["../coreShared/js/*"],
			"@zoltar/ui-statoblast-domain/*": ["../statoblastDomain/js/*"],
			"@zoltar/ui-trading-domain": ["../tradingDomain/js/index.d.ts"],
			"@zoltar/ui-trading-domain/*": ["../tradingDomain/js/*"],
			"@zoltar/ui-zoltar-domain/*": ["../zoltarDomain/js/*"]
		},
		"rootDir": "./ts",
		"outDir": "./js"
	},
	"include": ["./ts/**/*.ts", "./ts/**/*.tsx"],
	"exclude": ["./ts/tests/**/*.ts", "./ts/tests/**/*.tsx"]
}
