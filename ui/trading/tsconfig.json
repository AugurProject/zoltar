{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@zoltar/shared/*": ["../../shared/js/*"],
			"@zoltar/ui-core-shared/*": ["../coreShared/js/*"],
			"@zoltar/ui-statoblast-shared/*": ["../statoblastShared/js/*"],
			"@zoltar/ui-trading-shared": ["../tradingShared/js/index.d.ts"],
			"@zoltar/ui-trading-shared/*": ["../tradingShared/js/*"],
			"@zoltar/ui-zoltar-shared/*": ["../zoltarShared/js/*"]
		},
		"rootDir": "./ts",
		"outDir": "./js"
	},
	"include": ["./ts/**/*.ts", "./ts/**/*.tsx"],
	"exclude": ["./ts/tests/**/*.ts", "./ts/tests/**/*.tsx"]
}
