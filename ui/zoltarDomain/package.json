{
	"description": "Reusable Zoltar protocol and workflow UI capabilities",
	"name": "@zoltar/ui-zoltar-domain",
	"private": true,
	"repository": {},
	"license": "Unlicense",
	"type": "module",
	"devDependencies": {
		"better-typescript-lib": "2.11.0",
		"bun-types": "1.3.11",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@preact/signals": "2.0.1",
		"@zoltar/shared": "file:../../shared",
		"@zoltar/ui-core-shared": "file:../coreShared",
		"preact": "10.26.4",
		"tevm": "1.0.0-rc.151"
	},
	"overrides": {
		"@tevm/actions": "1.0.0-rc.151",
		"@tevm/node": "1.0.0-rc.151",
		"@tevm/server": "1.0.0-rc.151",
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.6",
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"tmp": "0.2.7",
		"ws": "8.21.0"
	},
	"scripts": {
		"build": "bun x tsc --project tsconfig.json",
		"typecheck": "bun x tsc --project tsconfig.json --noEmit"
	},
	"types": "./js/protocol/index.d.ts",
	"exports": {
		"./copy/*": "./js/copy/*.js",
		"./features/*": "./js/features/*.js",
		"./lib/*": "./js/lib/*.js",
		"./protocol/*": "./js/protocol/*.js",
		"./simulation/*": "./js/simulation/*.js",
		"./types/*": "./js/types/*.js"
	}
}
