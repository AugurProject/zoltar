{
	"description": "Augur Statoblast prediction-market operations interface",
	"name": "@zoltar/ui-statoblast",
	"private": true,
	"repository": {},
	"license": "Unlicense",
	"type": "module",
	"devDependencies": {
		"better-typescript-lib": "2.11.0",
		"bun-types": "1.4.2",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@preact/signals": "2.0.1",
		"@zoltar/shared": "file:../../shared",
		"@zoltar/ui-core-shared": "file:../coreShared",
		"@zoltar/ui-statoblast-domain": "file:../statoblastDomain",
		"@zoltar/ui-zoltar-domain": "file:../zoltarDomain",
		"preact": "10.26.4",
		"tevm": "1.0.0-rc.151"
	},
	"overrides": {
		"@tevm/actions": "1.0.0-rc.151",
		"@tevm/node": "1.0.0-rc.151",
		"@tevm/server": "1.0.0-rc.151",
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.6",
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"tmp": "0.2.7",
		"ws": "8.21.0"
	},
	"scripts": {
		"generate": "bun ../../tooling/ui/projectArtifacts.mts && bun ../../tooling/ui/vendor.mts statoblast",
		"vendor": "bun ../../tooling/ui/vendor.mts statoblast",
		"build:workers": "bun ../../tooling/ui/workers.mts statoblast",
		"build:tests": "bun ../../tooling/ui/tests.mts statoblast",
		"build": "bun run generate && bun x tsc --project tsconfig.json && bun run build:workers",
		"build:prod": "bun run generate && bun ../../tooling/ui/production.mts statoblast",
		"watch": "bun ../../tooling/ui/watch.mts statoblast",
		"serve": "bun ../../tooling/ui/dev-server.ts statoblast"
	}
}
