{
	"description": "Augur Statoblast prediction-market operations interface",
	"name": "@zoltar/ui-statoblast",
	"private": true,
	"repository": {},
	"license": "Unlicense",
	"type": "module",
	"devDependencies": {
		"better-typescript-lib": "2.11.0",
		"bun-types": "1.4.2",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@preact/signals": "2.0.1",
		"@zoltar/ui-core-shared": "workspace:1.0.0",
		"@zoltar/ui-statoblast-shared": "workspace:1.0.0",
		"@zoltar/ui-zoltar-shared": "workspace:1.0.0",
		"preact": "10.26.4",
		"@tevm/memory-client": "1.0.0-rc.151",
		"@tevm/common": "1.0.0-rc.151",
		"@zoltar/core-shared": "workspace:1.0.0",
		"@zoltar/open-oracle-shared": "workspace:1.0.0",
		"@zoltar/statoblast-shared": "workspace:1.0.0"
	},
	"scripts": {
		"generate": "bun ../../tooling/contracts/build-app-contracts.mts statoblast && bun ../../tooling/repo/build-shared.mts statoblast && bun ../../tooling/ui/vendor.mts statoblast --scoped-artifacts",
		"vendor": "bun ../../tooling/ui/vendor.mts statoblast",
		"build:workers": "bun ../../tooling/ui/workers.mts statoblast",
		"build:tests": "bun ../../tooling/ui/tests.mts statoblast",
		"build": "bun ../../tooling/ui/apps.mts statoblast",
		"build:prod": "bun run build && bun ../../tooling/ui/production.mts statoblast",
		"watch": "bun ../../tooling/ui/watch.mts statoblast",
		"serve": "bun ../../tooling/ui/dev-server.ts statoblast"
	},
	"version": "1.0.0"
