{
	"extends": "../shared/tsconfig.strict.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"inlineSources": true,
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"lib": ["ESNext", "DOM"],
		"typeRoots": ["../node_modules/@types"],
		"types": []
	}
}
