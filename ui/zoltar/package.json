	"type": "module",
	"devDependencies": {
		"better-typescript-lib": "2.11.0",
		"bun-types": "1.4.2",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@preact/signals": "2.0.1",
		"@zoltar/ui-core-shared": "file:../coreShared",
		"@zoltar/ui-zoltar-shared": "file:../zoltarShared",
		"preact": "10.26.4",
		"tevm": "1.0.0-rc.151",
		"@zoltar/core-shared": "file:../../shared/core",
		"@zoltar/zoltar-shared": "file:../../shared/zoltar"
	},
	"overrides": {
		"@tevm/actions": "1.0.0-rc.151",
		"@tevm/node": "1.0.0-rc.151",
		"@tevm/server": "1.0.0-rc.151",
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.6",
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"tmp": "0.2.7",
		"ws": "8.21.0",
		"@zoltar/core-shared": "file:../../shared/core",
		"@zoltar/zoltar-shared": "file:../../shared/zoltar",
		"@zoltar/ui-core-shared": "file:../coreShared",
		"@zoltar/ui-zoltar-shared": "file:../zoltarShared"
	},
	"scripts": {
		"generate": "bun ../../tooling/contracts/build-app-contracts.mts zoltar && bun ../../tooling/repo/build-shared.mts zoltar && bun ../../tooling/ui/vendor.mts zoltar --scoped-artifacts",
		"vendor": "bun ../../tooling/ui/vendor.mts zoltar",
		"build:workers": "bun ../../tooling/ui/workers.mts zoltar",
		"build:tests": "bun ../../tooling/ui/tests.mts zoltar",
		"build": "bun ../../tooling/ui/apps.mts zoltar",
		"build:prod": "bun run build && bun ../../tooling/ui/production.mts zoltar",
		"watch": "bun ../../tooling/ui/watch.mts zoltar",
		"serve": "bun ../../tooling/ui/dev-server.ts zoltar"
	},
	"types": "./js/index.d.ts",
	"exports": {
		"./*": "./js/*.js"
	}
}
