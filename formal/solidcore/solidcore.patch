--- /dev/null
+++ b/prototypes/source/calldata_word.py
@@ -0,0 +1,125 @@
+"""Compare raw and typed calldata reads of the boolean used by Multicall3."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    path = 'solidity/contracts/statoblast/Multicall3.sol'
+    source = (repo / path).read_text()
+    unit = compile_solc(compiler, {'M.sol': source}, {'*': {'': ['ast']}})['sources'][
+        'M.sol'
+    ]['ast']
+    contract = next(v for v in unit['nodes'] if v.get('name') == 'Multicall3')
+    decl = next(v for v in contract['nodes'] if v.get('name') == 'Call3')
+    start, length, _ = map(int, decl['src'].split(':'))
+    probe = (
+        'pragma solidity 0.8.35; contract Probe {'
+        + source.encode()[start : start + length].decode()
+        + """
+    function raw(Call3 calldata item) external pure returns(uint result) {
+        assembly { result := calldataload(add(item,32)) }
+    }
+    function typed(Call3 calldata item) external pure returns(bool) {return item.allowFailure;}
+    function first(Call3[] calldata items) external pure returns(uint result) {
+        Call3 calldata item=items[0];
+        assembly {result:=calldataload(add(item,32))}
+    }
+}"""
+    )
+    out = compile_solc(
+        compiler,
+        {'C.sol': probe},
+        {
+            '*': {
+                '': ['ast'],
+                'Probe': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    evm = out['contracts']['C.sol']['Probe']['evm']
+    model = importer.render_module(
+        lower_assembly(project(out['sources']['C.sol']['ast'], 'Probe')),
+        path,
+        'Probe',
+        'SolidCore.Solidity.CallWord',
+        True,
+    )
+
+    def word(n):
+        return n.to_bytes(32, 'big')
+
+    rows = []
+    with replay.local_chain(anvil) as url:
+        addr = '0x' + 'ac' * 20
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for method, sel in evm['methodIdentifiers'].items():
+            for flag in (0, 1, 2, 2**255, 2**256 - 1):
+                raw = (
+                    bytes.fromhex(sel)
+                    + word(32)
+                    + (word(1) + word(32) if method.startswith('first') else b'')
+                    + word(17)
+                    + word(flag)
+                    + word(96)
+                    + word(0)
+                )
+                good = not method.startswith('typed') or flag < 2
+                try:
+                    result = replay.rpc(
+                        url,
+                        'eth_call',
+                        [{'to': addr, 'data': '0x' + raw.hex()}, 'latest'],
+                    )
+                except RuntimeError as exc:
+                    if good or "'data': '0x'" not in str(exc):
+                        raise
+                else:
+                    if not good or result != '0x' + word(flag).hex():
+                        raise AssertionError((method, flag, result))
+                rows.append(
+                    f'({list(raw)},{str(good).lower()},{list(word(flag)) if good else []})'
+                )
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'CallWord.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract CallWord.importedSourceUnit "Probe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (input,success,want) in (["""
+            + ',\n'.join(rows)
+            + """] : List (List Nat × Bool × List Nat)) do
+    let some r := TypeCheck.CheckedContract.callCalldata? 20000 c Source.State.empty input
+      | throw (IO.userError "missing ABI dispatch")
+    unless r.success == success && r.output == want do
+      throw (IO.userError s!"wrong raw/typed calldata read for {input.take 4}: {r.success}, {r.output}")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(rows)} typed and raw calldata word reads matched Anvil')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, args.anvil)
