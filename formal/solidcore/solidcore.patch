+    function left(uint x, Pool pool) external view returns(uint) { return consume(x+1 != read(), pool.next()); }
+    function earlier(uint x, Pool pool) external view returns(uint) { return reverse(pool.next(), read() != x+1); }
+    function andSkip(uint x, Pool pool) external view returns(uint) { return consume(false && read() != x+1, pool.next()); }
+    function orSkip(uint x, Pool pool) external view returns(uint) { return consume(true || read() != x+1, pool.next()); }
