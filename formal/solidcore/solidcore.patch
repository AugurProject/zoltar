@@ -0,0 +1,128 @@
+"""Compare raw carry-event payloads and topics with receipts from the EVM."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import time
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    original = (
+        repo / 'solidity/contracts/statoblast/EscalationGameCarry.sol'
+    ).read_text()
+    fn = original.split('function _emitCarryDepositConsumed(', 1)[1].split('\n\t}', 1)[
+        0
+    ]
+    blocks = re.findall(r'assembly\s*\([^)]*\)\s*\{[^{}]*\}', fn)
+    if len(blocks) != 1:
+        raise ValueError('expected one carry event assembly block')
+    source = (
+        """
+pragma solidity 0.8.35;
+contract LogProbe {
+    function note(bytes memory eventData, bytes32 eventSignature, uint256 parentDepositIndex, uint256 sourceNodeId, address depositor) external {
+"""
+        + blocks[0]
+        + '\n    }\n}'
+    )
+    r = compile_solc(
+        compiler,
+        {'L.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                'LogProbe': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    unit = lower_assembly(project(r['sources']['L.sol']['ast'], 'LogProbe'))
+    model = importer.render_module(
+        unit, 'L.sol', 'LogProbe', 'SolidCore.Solidity.RawLogProbe', True
+    )
+    evm = r['contracts']['L.sol']['LogProbe']['evm']
+    selector = evm['methodIdentifiers']['note(bytes,bytes32,uint256,uint256,address)']
+    values = [
+        (b'', [0, 0, 0, 0]),
+        (b'\xff', [1, 2, 3, 4]),
+        (bytes(range(65)), [(1 << 256) - 1, 1 << 255, 255, (1 << 160) - 1]),
+        (bytes(range(192)), [17, 8, 8, 8]),
+    ]
+    addr = '0x' + '53' * 20
+    with replay.local_chain(anvil) as url:
+        sender = replay.rpc(url, 'eth_accounts', [])[0]
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for data, words in values:
+            head = ''.join(f'{v:064x}' for v in [160, *words, len(data)])
+            payload = data.hex().ljust(((len(data) + 31) // 32) * 64, '0')
+            tx = replay.rpc(
+                url,
+                'eth_sendTransaction',
+                [
+                    {
+                        'from': sender,
+                        'to': addr,
+                        'gas': '0x80000',
+                        'data': '0x' + selector + head + payload,
+                    }
+                ],
+            )
+            for _ in range(100):
+                receipt = replay.rpc(url, 'eth_getTransactionReceipt', [tx])
+                if receipt:
+                    break
+                time.sleep(0.05)
+            if (
+                not receipt
+                or int(receipt['status'], 16) != 1
+                or len(receipt['logs']) != 1
+            ):
+                raise AssertionError(receipt)
+            event = receipt['logs'][0]
+            if (
+                event['address'].lower() != addr
+                or event['data'] != '0x' + data.hex()
+                or [int(w, 16) for w in event['topics']] != words
+            ):
+                raise AssertionError(event)
+    with tempfile.TemporaryDirectory() as tmp:
+        probe = Path(tmp) / 'RawLog.lean'
+        probe.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract RawLogProbe.importedSourceUnit "LogProbe" with
+    | .ok c => pure c
+    | .error err => throw (IO.userError (reprStr err))
+  for (data,words) in (["""
+            + ',\n'.join(f'({list(data)}, {words})' for data, words in values)
+            + """] : List (List Nat × List Nat)) do
+    let [t0,t1,t2,t3] := words | throw (IO.userError "bad fixture")
+    let args := [Source.Value.bytes data, .fixedBytes 32 t0, .word t1, .word t2, .word t3]
+    match TypeCheck.CheckedContract.callFunctionWithContext 10000 c "note" c.core.context Source.State.empty args with
+    | .ok (.returned state []) =>
+      let [ev] := state.events | throw (IO.userError "wrong log count")
+      unless ev.topics == words && ev.dataBytes == data do throw (IO.userError s!"wrong log: {repr ev}")
+    | _ => throw (IO.userError "emit failed")
+"""
+        )
+        subprocess.run(['lake', 'env', 'lean', '--run', probe], cwd=ROOT, check=True)
+    print(f'{len(values)} carry-event log payloads and topic arrays matched Anvil')
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('repo', type=Path)
+    p.add_argument('--solc', required=True)
+    p.add_argument('--anvil', required=True)
+    a = p.parse_args()
+    run(a.repo.resolve(), a.solc, a.anvil)
