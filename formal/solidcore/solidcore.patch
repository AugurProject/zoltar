index 0000000000000000000000000000000000000000..803d4bd26c95bd109594fde103f8cb664cf86762
--- /dev/null
+++ b/prototypes/mul512/Proof.lean.in
@@ -0,0 +1,48 @@
+-- Recover the high limb from residues modulo w and w-1.
+private theorem recover (w p : Nat) (positive : 1 < w) (bound : p ≤ (w-1)*(w-1)) :
+    let low := p%w
+    let mm := p%(w-1)
+    ((mm+w-low)%w + w - (if mm < low then 1 else 0)) % w = p/w := by
+  let q := p/w
+  let l := p%w
+  let mm := p%(w-1)
+  have decomp : w*q+l = p := Nat.div_add_mod p w
+  have low : l < w := Nat.mod_lt _ (by omega)
+  have high : q < w-1 := by
+    apply (Nat.div_lt_iff_lt_mul (by omega : 0 < w)).mpr
+    exact Nat.lt_of_le_of_lt bound (Nat.mul_lt_mul_of_pos_left (by omega) (by omega))
+  have modEq : mm = (q+l)%(w-1) := by
+    change p%(w-1) = _
+    have decomp' : p = q+l + q*(w-1) := by
+      rw [Nat.mul_comm q (w-1), Nat.sub_mul, Nat.one_mul]
+      have le : q ≤ w*q := by simpa using Nat.mul_le_mul_right q (show 1 ≤ w by omega)
+      omega
+    rw [decomp', Nat.mul_comm q (w-1), Nat.add_mul_mod_self_left]
+  change ((mm + w - l) % w + w - (if mm < l then 1 else 0)) % w = q
+  by_cases small : q+l < w-1
+  · rw [Nat.mod_eq_of_lt small] at modEq
+    have ge : ¬mm < l := by rw [modEq]; exact Nat.not_lt.mpr (Nat.le_add_left l q)
+    rw [if_neg ge]
+    have h : mm+w-l = q+w := by omega
+    rw [h]
+    simp [Nat.mod_eq_of_lt (by omega : q < w)]
+  · have small' : q+l-(w-1) < w-1 := by omega
+    rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt small'] at modEq
+    have lt : mm < l := by omega
+    rw [if_pos lt]
+    have h : mm+w-l = q+1 := by omega
+    rw [h, Nat.mod_eq_of_lt (by omega : q+1 < w)]
+    have h' : q+1+w-1 = q+w := by omega
+    rw [h']
+    simp [Nat.mod_eq_of_lt (by omega : q < w)]
+
+private theorem exactAt (w a b : Nat) (large : 1 < w) (ha : a < w) (hb : b < w) :
+    blockResultAt w a b = (a*b / w, a*b % w) := by
+  have bound : a*b ≤ (w-1)*(w-1) := Nat.mul_le_mul (by omega) (by omega)
+  have nonzero : w-1 ≠ 0 := by omega
+  simp [blockResultAt, imported, run, Term.eval, nonzero]
+  exact recover w (a*b) large bound
+
+theorem exactLimbs (a b : Nat) (ha : a < modulus) (hb : b < modulus) :
+    blockResultAt modulus a b = (a*b / modulus, a*b % modulus) :=
+  exactAt modulus a b (by decide) ha hb
diff --git a/prototypes/mul512/WordBlock.lean b/prototypes/mul512/WordBlock.lean
new file mode 100644
index 0000000000000000000000000000000000000000..b996fb295ca3b788fdcfd2df04eb7f9650e4ec76
--- /dev/null
+++ b/prototypes/mul512/WordBlock.lean
@@ -0,0 +1,60 @@
+import SolidCore.Solidity.Checked
+
+/-! Straight-line, side-effect-free Yul word expressions. Reads and writes cross
+the Solidity boundary only for checked uint256 locals. No memory or world state. -/
+namespace SolidCore.Solidity.WordBlock
+
+inductive Term where
+  | lit (n : Nat)
+  | var (name : String)
+  | mul (a b : Term)
+  | sub (a b : Term)
+  | lt (a b : Term)
+  | not (a : Term)
+  | mulmod (a b m : Term)
+  deriving Repr
+
+inductive Step where
+  | declare (name : String) (rhs : Term)
+  | assign (name : String) (rhs : Term)
+  deriving Repr
+
+def modulus : Nat := 2^256
+
+def Term.eval (w : Nat) (env : String → Nat) : Term → Nat
+  | .lit n => n % w
+  | .var name => env name
+  | .mul a b => (a.eval w env * b.eval w env) % w
+  | .sub a b => (a.eval w env + w - b.eval w env) % w
+  | .lt a b => if a.eval w env < b.eval w env then 1 else 0
+  | .not a => w - 1 - a.eval w env
+  | .mulmod a b m =>
+    let v := m.eval w env
+    if v = 0 then 0 else (a.eval w env * b.eval w env) % v
+
+def run (w : Nat) (steps : List Step) (env : String → Nat) : String → Nat :=
+  steps.foldl (fun state step => match step with
+    | .declare name rhs | .assign name rhs =>
+      fun key => if key = name then rhs.eval w state else state key) env
+
+private def uintLit (n : Nat) : Expr :=
+  .call (.typeName (.uint 256)) [.positional (.literal (.number (toString n)))]
+
+def Term.toExpr : Term → Expr
+  | .lit n => uintLit n
+  | .var name => .ident name
+  | .mul a b => .binary .mul a.toExpr b.toExpr
+  | .sub a b => .binary .sub a.toExpr b.toExpr
+  | .lt a b => .ternary (.binary .lt a.toExpr b.toExpr) (uintLit 1) (uintLit 0)
+  | .not a => .unary .bitNot a.toExpr
+  | .mulmod a b m =>
+    -- EVM MULMOD returns zero for modulus zero; Solidity's builtin can revert.
+    .ternary (.binary .eq m.toExpr (uintLit 0)) (uintLit 0)
+      (.call (.ident "mulmod") [.positional a.toExpr, .positional b.toExpr, .positional m.toExpr])
+
+def lower (steps : List Step) : Stmt :=
+  .unchecked (.block (steps.map fun step => match step with
+    | .declare name rhs => .varDecl [{name := some name, ty := some (.uint 256)}] (some rhs.toExpr)
+    | .assign name rhs => .expr (.assign (.ident name) .assign rhs.toExpr)))
+
+end SolidCore.Solidity.WordBlock
diff --git a/prototypes/mul512/import_word.py b/prototypes/mul512/import_word.py
new file mode 100644
index 0000000000000000000000000000000000000000..51813dfb37cedea638b91911cf65a6867d88564b
--- /dev/null
+++ b/prototypes/mul512/import_word.py
@@ -0,0 +1,83 @@
+"""Import one analyzed function consisting of one straight-line Yul word block."""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'scripts'))
+from solc_ast_to_lean_source import function_decl_from_node, lean_string
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def import_block(function):
+    params = function['parameters']['parameters']
+    returns = function['returnParameters']['parameters']
+    require(function['stateMutability'] == 'pure' and not function['modifiers'],
+            'expected an unmodified pure function')
+    require(all(p['typeDescriptions']['typeString'] == 'uint256' and p['name']
+                for p in params + returns), 'only named uint256 bindings are supported')
+    statements = function['body']['statements']
+    require(len(statements) == 1 and statements[0]['nodeType'] == 'InlineAssembly',
+            'expected exactly one assembly block')
+    block = statements[0]
+    require(block['AST']['nodeType'] == 'YulBlock' and
+            set(block.get('flags', [])) <= {'memory-safe'}, 'unsupported block')
+    bindings = {p['id']: p['name'] for p in params + returns}
+    refs = {}
+    for ref in block['externalReferences']:
+        require(ref['declaration'] in bindings and ref['valueSize'] == 1 and
+                not ref['isSlot'] and not ref['isOffset'] and not ref.get('suffix'),
+                'unsupported outer binding')
+        require(ref['src'] not in refs, 'duplicate external reference')
+        refs[ref['src']] = bindings[ref['declaration']]
+    locals_ = set()
+    used_refs = set()
+
+    def resolve(node):
+        name = node['name']
+        require(node['nodeType'] == 'YulIdentifier', 'expected word identifier')
+        if node['src'] in refs:
+            require(refs[node['src']] == name, 'outer declaration/name mismatch')
+            used_refs.add(node['src'])
+        else:
+            require(name in locals_, f'unresolved Yul local {name}')
+        return lean_string(name)
+
+    def expr(node):
+        kind = node['nodeType']
+        if kind == 'YulIdentifier':
+            return '(.var ' + resolve(node) + ')'
+        if kind == 'YulLiteral':
+            require(node['kind'] == 'number', 'only word literals are supported')
+            n = int(node['value'], 0)
+            require(0 <= n < 2**256, 'literal does not fit uint256')
+            return f'(.lit {n})'
+        require(kind == 'YulFunctionCall', f'unsupported expression {kind}')
+        op = node['functionName']['name']
+        args = node['arguments']
+        require(op in {'mul', 'sub', 'lt', 'not', 'mulmod'}, f'unsupported builtin {op}')
+        require(len(args) == {'not': 1, 'mulmod': 3}.get(op, 2), 'wrong builtin arity')
+        return '(.' + op + ' ' + ' '.join(map(expr, args)) + ')'
+
+    steps = []
+    for stmt in block['AST']['statements']:
+        kind = stmt['nodeType']
+        require(kind in ('YulVariableDeclaration', 'YulAssignment'), f'unsupported statement {kind}')
+        rhs = expr(stmt['value'])
+        if kind == 'YulVariableDeclaration':
+            var, = stmt['variables']
+            name = var['name']
+            require(var['nodeType'] == 'YulTypedName' and not var.get('type') and
+                    name not in locals_ and name not in bindings.values(), 'invalid local')
+            locals_.add(name)
+            steps.append('.declare ' + lean_string(name) + ' ' + rhs)
+        else:
+            target, = stmt['variableNames']
+            steps.append('.assign ' + resolve(target) + ' ' + rhs)
+    require(used_refs == set(refs), 'unused external reference')
+    # Preserve the original Solidity function header; install its imported block in Lean.
+    header = function_decl_from_node({**function, 'body': None})
+    return '[' + ',\n    '.join(steps) + ']', header
diff --git a/prototypes/mul512/replay.py b/prototypes/mul512/replay.py
new file mode 100644
index 0000000000000000000000000000000000000000..dc3a3e591479ee39df229099a524ad1b38bf8b2a
--- /dev/null
+++ b/prototypes/mul512/replay.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Run with Python 3.10+, solc 0.8.35, Anvil and SolidCore's pinned Lake/Lean.
+From the SolidCore checkout, run:
+    lake build +SolidCore.Solidity.Checked:olean
+    python3 prototypes/mul512/replay.py /path/to/zoltar
+
+The --solc and --anvil flags select local binaries. The kernel theorem covers
+the imported word block. The differential test independently checks lowering
+through SolidCore's Solidity interpreter and execution on a fresh local EVM.
+"""
+import argparse
+from contextlib import contextmanager
+from copy import deepcopy
+import json
+from pathlib import Path
+import random
+import re
+import subprocess
+import time
+from tempfile import TemporaryDirectory
+from threading import Thread
+from urllib.request import urlopen, Request
+
+from import_word import import_block
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+W = 2**256
+
+
+def compile_probe(repo, compiler):
+    version = subprocess.check_output([compiler, '--version'], text=True)
+    if 'Version: 0.8.35+commit.47b9dedd' not in version:
+        raise ValueError('expected native solc 0.8.35')
+    base = repo / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/utils'
+    sources = {key: {'content': (base / key).read_text()}
+               for key in ['math/Math.sol', 'math/SafeCast.sol', 'Panic.sol']}
+    sources['Probe.sol'] = {'content': """// SPDX-License-Identifier: MIT
+pragma solidity 0.8.35;
+import {Math} from './math/Math.sol';
+contract Probe {
+    function probe(uint256 a, uint256 b) external pure returns (uint256, uint256) {
+        return Math.mul512(a, b);
+    }
+}"""}
+    settings = {'viaIR': True, 'evmVersion': 'osaka', 'optimizer': {'enabled': True, 'runs': 0},
+                'metadata': {'appendCBOR': False, 'bytecodeHash': 'none'},
+                'outputSelection': {'math/Math.sol': {'': ['ast']},
+                                    'Probe.sol': {'Probe': ['evm.bytecode.object', 'evm.methodIdentifiers']}}}
+    request = {'language': 'Solidity', 'sources': sources, 'settings': settings}
+    out = json.loads(subprocess.check_output([compiler, '--standard-json'],
+                                             input=json.dumps(request), text=True))
+    errors = [e['formattedMessage'] for e in out.get('errors', []) if e['severity'] == 'error']
+    if errors:
+        raise ValueError('\n'.join(errors))
+    contract, = (c for c in out['sources']['math/Math.sol']['ast']['nodes'] if c.get('name') == 'Math')
+    function, = (f for f in contract['nodes'] if f.get('name') == 'mul512')
+    return function, out['contracts']['Probe.sol']['Probe']['evm']
+
+
+def vectors():
+    edges = [0, 1, 2, 2**64-1, 2**128-1, 2**128, 2**128+1, 2**255-1,
+             2**255, W-3, W-2, W-1]
+    rng = random.Random(512)
+    return [(a,b) for a in edges for b in edges] + [
+        (rng.getrandbits(256), rng.getrandbits(256)) for _ in range(256)]
+
+
+def check_rejections(function):
+    for mutation, expected in [('builtin', 'unsupported builtin'), ('binding', 'unsupported outer binding')]:
+        f = deepcopy(function)
+        block = f['body']['statements'][0]
+        if mutation == 'builtin':
+            block['AST']['statements'][0]['value']['functionName']['name'] = 'mload'
+        else:
+            block['externalReferences'][0]['isSlot'] = True
+        try:
+            import_block(f)
+        except ValueError as e:
+            if expected not in str(e):
+                raise
+        else:
+            raise ValueError(f'importer silently accepted {mutation}')
+
+
+def run_lean(function, pairs, tmp):
+    # The proof below is attached to this concrete ABI and its two named returns.
+    if [[p['name'] for p in function[k]['parameters']] for k in ['parameters','returnParameters']] != [
+            ['a','b'], ['high','low']]:
+        raise ValueError('unexpected mul512 signature')
+    steps, header = import_block(function)
+    code = (HERE/'Probe.lean.in').read_text().replace('__HEADER__',header).replace('__STEPS__',steps)
+    code = (HERE/'WordBlock.lean').read_text() + '\n' + code.replace('__PROOF__',(HERE/'Proof.lean.in').read_text())
+    script, inputs = tmp/'Mul512.lean', tmp/'vectors.txt'
+    script.write_text(code)
+    inputs.write_text(''.join(f'{a} {b}\n' for a,b in pairs))
+    cmd = ['lake','env','lean','-s','131072','-DmaxRecDepth=16384','--trust=0',
+           '-DwarningAsError=true','--run',str(script),str(inputs)]
+    p = subprocess.run(cmd, cwd=ROOT, text=True, stdout=subprocess.PIPE)
+    if p.returncode:
+        raise RuntimeError(p.stdout)
+    lines = p.stdout.splitlines()
+    audit = [s for s in lines if 'exactLimbs' in s]
+    if len(audit) != 1 or not re.fullmatch(
+            r"'.*\.exactLimbs' depends on axioms: \[(?:propext|Classical\.choice|Quot\.sound)(?:, (?:propext|Classical\.choice|Quot\.sound))*\]", audit[0]):
+        raise RuntimeError(f'unexpected kernel audit: {audit}')
+    print(audit[0], flush=True)
+    values = [tuple(map(int,line.split())) for line in lines if line != audit[0]]
+    if len(values) != len(pairs):
+        raise RuntimeError('Lean result count differs from input count')
+    return values
+
+
+@contextmanager
+def local_chain(binary):
+    process = subprocess.Popen([binary,'--host','127.0.0.1','--port','0','--hardfork','osaka'],
+                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    try:
+        for line in process.stdout:
+            match = re.search(r'Listening on (127\.0\.0\.1:\d+)', line)
+            if match:
+                Thread(target=process.stdout.read, daemon=True).start()
+                yield 'http://' + match[1]
+                return
+        raise RuntimeError('Anvil exited before listening')
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+        process.stdout.close()
+
+
+def rpc(url, method, params):
+    payload = json.dumps({'jsonrpc':'2.0','id':1,'method':method,'params':params}).encode()
+    with urlopen(Request(url, data=payload, headers={'Content-Type':'application/json'}), timeout=15) as r:
+        result = json.load(r)
+    if 'error' in result:
+        raise RuntimeError(result['error'])
+    return result['result']
+
+
+def compare(url, evm, pairs, lean):
+    account = rpc(url, 'eth_accounts', [])[0]
+    tx = rpc(url, 'eth_sendTransaction', [{'from':account, 'data':'0x'+evm['bytecode']['object'],
+                                           'gas':hex(3_000_000)}])
+    deadline = time.monotonic() + 20
+    receipt = rpc(url, 'eth_getTransactionReceipt', [tx])
+    while receipt is None and time.monotonic() < deadline:
+        time.sleep(0.05)
+        receipt = rpc(url, 'eth_getTransactionReceipt', [tx])
+    if receipt is None or int(receipt['status'],16) != 1:
+        raise RuntimeError(f'deployment failed: {receipt}')
+    address = receipt['contractAddress']
+    selector = evm['methodIdentifiers']['probe(uint256,uint256)']
+    for (a,b), got in zip(pairs, lean, strict=True):
+        raw = rpc(url, 'eth_call', [{'to':address,'data':f'0x{selector}{a:064x}{b:064x}'}, 'latest'])
+        if len(raw) != 130:
+            raise ValueError(f'unexpected ABI return: {raw}')
+        solidity = (int(raw[2:66],16), int(raw[66:],16))
+        exact = divmod(a*b,W)
+        if not got == solidity == exact:
+            raise AssertionError(f'{a=} {b=} SolidCore={got} Solidity={solidity} product limbs={exact}')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar',type=Path)
+    cli.add_argument('--solc',default='solc')
+    cli.add_argument('--anvil',default='anvil')
+    args = cli.parse_args()
+    function, evm = compile_probe(args.zoltar, args.solc)
+    check_rejections(function)
+    pairs = vectors()
+    with TemporaryDirectory() as work:
+        results = run_lean(function, pairs, Path(work))
+    with local_chain(args.anvil) as url:
+        compare(url, evm, pairs, results)
+    print(f'{len(pairs)} pairs matched in checked SolidCore, imported word semantics, Anvil and exact arithmetic')
