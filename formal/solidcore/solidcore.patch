@@ -0,0 +1,161 @@
+"""Compare nested mapping scratch effects in callers of the vendored SafeERC20."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+from assembly import Unsupported, lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, fork, anvil):
+    directory = repo / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts'
+    paths = [
+        'interfaces/IERC165.sol',
+        'utils/introspection/IERC165.sol',
+        'token/ERC20/IERC20.sol',
+        'interfaces/IERC20.sol',
+        'interfaces/IERC1363.sol',
+        'token/ERC20/utils/SafeERC20.sol',
+    ]
+    text = '\n'.join(
+        re.sub(
+            r'(?m)^(?:// SPDX-License-Identifier:.*|import [^;]+;)',
+            '',
+            (directory / p).read_text(),
+        )
+        for p in paths
+        if (directory / p).exists()
+    )
+    text += """
+contract ScratchAccount {
+    mapping(address => mapping(uint => uint)) balances;
+    function touch(address who,uint key) internal {
+        balances[who][key] += 1;
+    }
+    function test(IERC20 token,uint prior,uint mode) external returns(bool) {
+        if (mode > 0) touch(address(7),prior);
+        if (mode == 2) touch(address(8),1);
+        return SafeERC20.trySafeTransfer(token,address(123),2);
+    }
+}
+"""
+    outputs = {
+        '*': {
+            '': ['ast'],
+            'ScratchAccount': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+        }
+    }
+    compiled = compile_solc(compiler, {'P.sol': text}, outputs, evm_version=fork)
+    evm = compiled['contracts']['P.sol']['ScratchAccount']['evm']
+    unit = project(compiled['sources']['P.sol']['ast'], 'ScratchAccount')
+    model = importer.render_module(
+        lower_assembly(unit),
+        'P.sol',
+        'ScratchAccount',
+        'SolidCore.Solidity.Account',
+        True,
+        analyzed_solc_028=fork == 'cancun',
+    )
+    # Dynamic storage accesses also write scratch and require a separate rule.
+    other = text.replace(
+        'mapping(address =>', 'uint[] other; mapping(address =>'
+    ).replace('if (mode > 0)', 'other.push(prior); if (mode > 0)')
+    try:
+        rejected = compile_solc(
+            compiler, {'P.sol': other}, {'*': {'': ['ast']}}, evm_version=fork
+        )
+        lower_assembly(project(rejected['sources']['P.sol']['ast'], 'ScratchAccount'))
+    except Unsupported as exc:
+        if 'memory before the assembly block' not in str(exc):
+            raise
+    else:
+        raise AssertionError(
+            'accepted dynamic storage in the frame of a scratch reader'
+        )
+
+    caller = '0x' + '44' * 20
+    token = '0x' + '55' * 20
+    rows = []
+    with replay.local_chain(anvil, fork) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [caller, '0x' + evm['deployedBytecode']['object']]
+        )
+        for reply in [b'\x00', b'\x01', bytes(31), (1).to_bytes(32, 'big')]:
+            code = (
+                '0x7f'
+                + reply.ljust(32, b'\x00').hex()
+                + '60005260'
+                + f'{len(reply):02x}'
+                + '6000f3'
+            )
+            replay.rpc(url, 'anvil_setCode', [token, code])
+            for mode in range(3):
+                for prior in (0, 1, 2**252 + 1):
+                    suffix = [0, prior, 1][mode].to_bytes(32, 'big')[len(reply) :]
+                    want = int.from_bytes(reply + suffix, 'big') == 1
+                    data = (
+                        '0x'
+                        + evm['methodIdentifiers']['test(address,uint256,uint256)']
+                        + token[2:].zfill(64)
+                        + f'{prior:064x}{mode:064x}'
+                    )
+                    got = int(
+                        replay.rpc(
+                            url, 'eth_call', [{'to': caller, 'data': data}, 'latest']
+                        ),
+                        16,
+                    )
+                    if got != want:
+                        raise AssertionError((mode, prior, reply, got, want))
+                    rows.append(f'({mode},{prior},{list(reply)},{str(want).lower()})')
+
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Scope.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Account.importedSourceUnit "ScratchAccount" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  let token := """
+            + str(int(token, 16))
+            + """
+  let payload := [169,5,156,187] ++ Source.wordToBytesBE 32 123 ++ Source.wordToBytesBE 32 2
+  for (mode, prior, output, want) in (["""
+            + ',\n'.join(rows)
+            + """] : List (Nat × Nat × List Nat × Bool)) do
+    let some tree := Source.ABI.Contract.callWithSelfDispatch 40000 c.core (.name "test") Source.State.empty [.word token,.word prior,.word mode] | throw (IO.userError "no entry")
+    let .request (.resource .gas) k := tree | throw (IO.userError "no CALL gas request")
+    let responder := Source.responderOfResults [{kind := .call,target := token, calldata := payload,gas? := some 50000,success := true,output}] []
+    match Source.SolI.runWith responder (k (Source.wordToU256 50000)) with
+    | .ok (.returned _ [.word v]) =>
+      unless v == (if want then 1 else 0) do throw (IO.userError s!"mismatched scratch {mode} {prior} {output} {v}")
+    | _ => throw (IO.userError "unexpected CALL or outcome")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'{len(rows)} SafeERC20 calls with nested mapping accesses matched Anvil ({fork})'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--oracle-solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, 'osaka', args.anvil)
+    run(args.repo, args.oracle_solc, 'cancun', args.anvil)
