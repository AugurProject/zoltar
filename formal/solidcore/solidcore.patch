+"""Replay the private label-normalization function directly from its solc source span."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+from assembly import lower_assembly
+from muldiv import ROOT, importer, replay, compile_solc
+
+
+def run(repo, compiler, anvil):
+    base = repo / 'solidity/contracts'
+    sources = {
+        p: (base / p).read_text()
+        for p in (
+            'ZoltarQuestionData.sol',
+            'Pagination.sol',
+            'ScalarOutcomes.sol',
+            'DecimalStrings.sol',
+        )
+    }
+    ast = compile_solc(compiler, sources, {'ZoltarQuestionData.sol': {'': ['ast']}})[
+        'sources'
+    ]['ZoltarQuestionData.sol']['ast']
+    contract = next(n for n in ast['nodes'] if n.get('name') == 'ZoltarQuestionData')
+    fn = next(
+        n for n in contract['nodes'] if n.get('name') == '_isReservedOutcomeLabel'
+    )
+    pos, size, _ = map(int, fn['src'].split(':'))
+    body = sources['ZoltarQuestionData.sol'].encode()[pos : pos + size].decode()
+    probe = (
+        'pragma solidity 0.8.35; contract Compact { '
+        + body
+        + ' function check(bytes memory label) external pure returns(bool) { return _isReservedOutcomeLabel(label); } }'
+    )
+    result = compile_solc(
+        compiler,
+        {'Probe.sol': probe},
+        {
+            '*': {
+                '': ['ast'],
+                'Compact': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    unit = lower_assembly(result['sources']['Probe.sol']['ast'])
+    module = importer.render_module(
+        unit, 'Probe.sol', 'Compact', 'SolidCore.Solidity.Compact', True
+    )
+    evm = result['contracts']['Probe.sol']['Compact']['evm']
+    cases = []
+    address = '0x' + '35' * 20
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [address, '0x' + evm['deployedBytecode']['object']]
+        )
+        for data in (
+            b'',
+            b' ',
+            b'invalid',
+            b'in valid',
+            b'malformed',
+            b'm a l f o r m e d',
+            b'valid',
+            b' ' * 64,
+            b'invalid' + b' ' * 57,
+            b'invalid\x00',
+            bytes(range(64)),
+        ):
+            encoded = f'{32:064x}{len(data):064x}' + data.hex().ljust(
+                ((len(data) + 31) // 32) * 64, '0'
+            )
+            raw = replay.rpc(
+                url,
+                'eth_call',
+                [
+                    {
+                        'to': address,
+                        'data': '0x'
+                        + evm['methodIdentifiers']['check(bytes)']
+                        + encoded,
+                    },
+                    'latest',
+                ],
+            )
+            expected = data.replace(b' ', b'') in (b'invalid', b'malformed')
+            if raw != f'0x{int(expected):064x}':
+                raise AssertionError(raw)
+            cases.append(f'({list(data)}, {int(expected)})')
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Compact.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + module
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Compact.importedSourceUnit "Compact" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (data, expected) in (["""
+            + ',\n'.join(cases)
+            + """] : List (List Nat × Nat)) do
+    match TypeCheck.CheckedContract.callFunctionWithContext 50000 c "check" Source.Context.empty Source.State.empty [.bytes data] with
+    | .ok (.returned _ [.word v]) => unless v == expected do throw (IO.userError s!"wrong hash comparison {data}")
+    | .ok (.reverted _ e) => throw (IO.userError (reprStr e))
+    | _ => throw (IO.userError "unexpected compaction result")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'{len(cases)} label compaction and hash calls matched checked SolidCore and Anvil'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
