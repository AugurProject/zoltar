+"""Retain the complete target contract and its referenced library members."""
+
+from copy import deepcopy
+
+from assembly import call, ident, n, variable, walk
+import re
+
+
+def discarded_local(output, name, units):
+    """Preserve the ABI decoder of a discarded scalar or flat static struct."""
+    ty = deepcopy(output['typeName'])
+    scalar = r'bool|u?int(?:[0-9]+)?|bytes[0-9]+|address'
+    loc = 'default'
+    if not re.fullmatch(scalar, ty.get('name', '')):
+        decl = units.get(ty.get('referencedDeclaration'), {})
+        if decl.get('nodeType') == 'ContractDefinition':
+            return n('VariableDeclaration', name=name, typeName=ty, storageLocation=loc)
+        if decl.get('nodeType') != 'StructDefinition' or not all(
+            re.fullmatch(scalar, field['typeName'].get('name', ''))
+            for field in decl['members']
+        ):
+            return None
+        if ty.get('pathNode') and decl.get('canonicalName'):
+            ty['pathNode']['name'] = decl['canonicalName']
+        loc = 'memory'
+    return n('VariableDeclaration', name=name, typeName=ty, storageLocation=loc)
+
+
+def bind_external_results(stmt, units):
+    """Bind ABI returns once, preserving decoding even for discarded bools."""
+    assign = stmt['expression']
+    # The high-level ABI decoder executes even for discarded static returns.
+    # Use the declared widths so malformed short or dirty values still revert.
+    fn = assign.get('expression', {})
+    target = units.get(fn.get('referencedDeclaration'), {})
+    outputs = target.get('returnParameters', {}).get('parameters', [])
+    if (
+        not outputs
+        and target.get('stateVariable')
+        and assign.get('typeDescriptions', {}).get('typeIdentifier') == 't_bool'
+    ):
+        outputs = [{'typeName': n('ElementaryTypeName', name='bool')}]
+    if (
+        assign.get('nodeType') == 'FunctionCall'
+        and fn.get('nodeType') == 'MemberAccess'
+        and fn.get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .startswith('t_function_external')
+        and outputs
+    ):
+        locals_ = [
+            discarded_local(v, f'#discard{i}', units) for i, v in enumerate(outputs)
+        ]
+        if any(local is None for local in locals_):
+            return
+        stmt.clear()
+        stmt.update(
+            n(
+                'Block',
+                statements=[
+                    n(
+                        'VariableDeclarationStatement',
+                        declarations=locals_,
+                        initialValue=assign,
+                    )
+                ],
+            )
+        )
+        return
+    lhs = assign.get('leftHandSide', {})
+    rhs = assign.get('rightHandSide', {})
+    values = lhs.get('components', [])
+    destinations = [v for v in values if v is not None]
+
+    def destination_key(v):
+        if v.get('nodeType') == 'Identifier':
+            return v['referencedDeclaration'], None
+        base = v.get('expression', {})
+        if (
+            v.get('nodeType') == 'MemberAccess'
+            and base.get('nodeType') == 'Identifier'
+            and base.get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_struct$')
+            and base['typeDescriptions']['typeIdentifier'].endswith(
+                ('_memory_ptr', '_storage_ptr')
+            )
+        ):
+            return base['referencedDeclaration'], v['memberName']
+        return None
+
+    keys = [destination_key(v) for v in destinations]
+    if (
+        assign.get('operator') != '='
+        or lhs.get('nodeType') != 'TupleExpression'
+        or lhs.get('isInlineArray')
+        or len(values) < 2
+        or not destinations
+        or None in keys
+        or len(set(keys)) != len(destinations)
+        or rhs.get('nodeType') != 'FunctionCall'
+        or rhs['expression'].get('nodeType') != 'MemberAccess'
+        or not rhs['expression']['typeDescriptions']['typeIdentifier'].startswith(
+            't_function_external'
+        )
+    ):
+        return
+    names = [f'#result{i}' for i in range(len(values))]
+    target = units.get(rhs['expression'].get('referencedDeclaration'), {})
+    outputs = target.get('returnParameters', {}).get('parameters', [])
+    if target.get('stateVariable') and target.get('visibility') == 'public':
+        ty = target['typeName']
+        while ty.get('nodeType') in ('Mapping', 'ArrayTypeName'):
+            ty = ty['valueType'] if ty['nodeType'] == 'Mapping' else ty['baseType']
+        fields = units.get(ty.get('referencedDeclaration'), {}).get('members', [])
+        outputs = [
+            f
+            for f in fields
+            if f.get('typeName', {}).get('nodeType') not in ('Mapping', 'ArrayTypeName')
+        ]
+    if len(outputs) != len(values):
+        return
+    types = [v['typeDescriptions']['typeIdentifier'] for v in outputs]
+    if rhs['typeDescriptions']['typeIdentifier'] != 't_tuple$' + ''.join(
+        '_' + ty + '_$' for ty in types
+    ):
+        return
+    if any(
+        v and v['typeDescriptions']['typeIdentifier'] != ty
+        for v, ty in zip(values, types)
+    ):
+        return
+    locals_ = [discarded_local(output, k, units) for output, k in zip(outputs, names)]
+    if not all(locals_):
+        return
+    reads = n(
+        'VariableDeclarationStatement',
+        declarations=locals_,
+        initialValue=rhs,
+    )
+    writes = [
+        n(
+            'ExpressionStatement',
+            expression=n(
+                'Assignment', operator='=', leftHandSide=v, rightHandSide=ident(k)
+            ),
+        )
+        for k, v in reversed(list(zip(names, values)))
+        if v is not None
+    ]
+    stmt.clear()
+    stmt.update(
+        n('Block', statements=[*sequence_call_inputs(rhs, units), reads, *writes])
+    )
+
+
+def bind_pure_word(call_expr, units):
+    """Copy exactly the resolved word width into an unnameable temporary."""
+    target = call_expr.get('expression') or {}
+    fn = units.get(target.get('referencedDeclaration'), {})
+    if (
+        call_expr.get('nodeType') != 'FunctionCall'
+        or target.get('nodeType') != 'Identifier'
+        or fn.get('nodeType') != 'FunctionDefinition'
+        or fn['stateMutability'] != 'pure'
+        or not re.fullmatch(r'uint\d+', call_expr['typeDescriptions']['typeString'])
+        or any(
+            a['nodeType'] not in ('Identifier', 'Literal')
+            or not re.fullmatch(
+                r'uint\d+|int_const \d+', a['typeDescriptions']['typeString']
+            )
+            for a in call_expr['arguments']
+        )
+    ):
+        return None
+    decl = variable(f'#call{call_expr["id"]}')
+    decl['typeName']['name'] = call_expr['typeDescriptions']['typeString']
+    return n(
+        'VariableDeclarationStatement', declarations=[decl], initialValue=call_expr
+    )
+
+
+def capture_storage_indices(expr, units, reads):
+    """Evaluate view-computed keys before binding the same storage lvalue."""
+    kind = expr.get('nodeType')
+    if kind == 'Identifier':
+        return expr
+    if kind == 'MemberAccess':
+        base = capture_storage_indices(expr['expression'], units, reads)
+        return {**expr, 'expression': base} if base else None
+    if kind == 'IndexAccess' and expr.get('indexExpression'):
+        base = capture_storage_indices(expr['baseExpression'], units, reads)
+        key = capture_view_reads(expr['indexExpression'], units, reads)
+        if base and key:
+            return {**expr, 'baseExpression': base, 'indexExpression': key}
+    return None
+
+
+def branch_assignment(stmt):
+    """Keep calls in the selected arm of a numeric or tuple assignment."""
+    assignment = stmt.get('expression', {})
+    dest = assignment.get('leftHandSide', {})
+    rhs = assignment.get('rightHandSide', {})
+    if rhs.get('nodeType') != 'Conditional':
+        return
+    parts = dest['components'] if dest.get('nodeType') == 'TupleExpression' else [dest]
+    if (
+        assignment.get('operator') != '='
+        or not all(
+            p
+            and p.get('nodeType') == 'Identifier'
+            and re.fullmatch(r'u?int[0-9]+', p['typeDescriptions']['typeString'])
+            for p in parts
+        )
+        or rhs['typeDescriptions']['typeString']
+        != dest['typeDescriptions']['typeString']
+        or not any(v.get('kind') == 'functionCall' for v in walk(rhs))
+    ):
+        return
+
+    def arm(key):
+        return n(
+            'ExpressionStatement',
+            expression={
+                **assignment,
+                'leftHandSide': deepcopy(dest),
+                'rightHandSide': rhs[key],
+            },
+        )
+
+    stmt.clear()
+    stmt.update(
+        n(
+            'IfStatement',
+            condition=rhs['condition'],
+            trueBody=arm('trueExpression'),
+            falseBody=arm('falseExpression'),
+        )
+    )
+
+
+def conditional_initializer(stmt):
+    """Evaluate a numeric initializer in the selected branch before binding its source name."""
+    value = stmt.get('initialValue') or {}
+    dest = stmt.get('declarations', [])
+    if (
+        value.get('nodeType') == 'Conditional'
+        and len(dest) > 1
+        and all(
+            d and re.fullmatch(r'u?int[0-9]+', d['typeDescriptions']['typeString'])
+            for d in dest
+        )
+        and value['typeDescriptions']['typeIdentifier']
+        == 't_tuple$'
+        + ''.join('_' + d['typeDescriptions']['typeIdentifier'] + '_$' for d in dest)
+        and all(
+            value[k].get('nodeType') == 'FunctionCall'
+            for k in ('trueExpression', 'falseExpression')
+        )
+    ):
+        temps = [
+            {
+                **variable(f'#selected{value["id"]}_{i}'),
+                'typeName': deepcopy(d['typeName']),
+            }
+            for i, d in enumerate(dest)
+        ]
+
+        def branch(key):
+            outputs = [{**d, 'name': d['name'] + 'Result'} for d in temps]
+            call_result = n(
+                'VariableDeclarationStatement',
+                declarations=outputs,
+                initialValue=value[key],
+            )
+            writes = [
+                n(
+                    'ExpressionStatement',
+                    expression=n(
+                        'Assignment',
+                        operator='=',
+                        leftHandSide=ident(t['name']),
+                        rightHandSide=ident(r['name']),
+                    ),
+                )
+                for t, r in zip(temps, outputs)
+            ]
+            return n('Block', statements=[call_result, *writes])
+
+        condition = n(
+            'IfStatement',
+            condition=value['condition'],
+            trueBody=branch('trueExpression'),
+            falseBody=branch('falseExpression'),
+        )
+        final = [
+            n(
+                'VariableDeclarationStatement',
+                declarations=[d],
+                initialValue=ident(t['name']),
+            )
+            for d, t in zip(dest, temps)
+        ]
+        stmt.clear()
+        stmt.update(final.pop())
+        return [
+            *[n('VariableDeclarationStatement', declarations=[t]) for t in temps],
+            condition,
+            *final,
+        ]
+    if (
+        value.get('nodeType') != 'Conditional'
+        or len(dest) != 1
+        or not dest[0]
+        or not re.fullmatch(r'u?int[0-9]+', value['typeDescriptions']['typeString'])
+        or value['typeDescriptions']['typeString']
+        != dest[0]['typeDescriptions']['typeString']
+        or not any(x.get('kind') == 'functionCall' for x in walk(value))
+    ):
+        return []
+    name = f'#selected{value["id"]}'
+    local = variable(name)
+    local['typeName'] = deepcopy(dest[0]['typeName'])
+
+    def write(expr):
+        return n(
+            'ExpressionStatement',
+            expression=n(
+                'Assignment', operator='=', leftHandSide=ident(name), rightHandSide=expr
+            ),
+        )
+
+    condition = n(
+        'IfStatement',
+        condition=value['condition'],
+        trueBody=write(value['trueExpression']),
+        falseBody=write(value['falseExpression']),
+    )
+    stmt['initialValue'] = ident(name)
+    return [n('VariableDeclarationStatement', declarations=[local]), condition]
+
+
+def decode_contract_upcast(stmt, units):
+    """Decode the actual external return and convert its address to its declared ancestor."""
+    dest = stmt['declarations']
+    value = stmt.get('initialValue') or {}
+    method = value.get('expression', {})
+    if (
+        len(dest) != 1
+        or not dest[0]
+        or value.get('kind') != 'functionCall'
+        or not method.get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .startswith('t_function_external')
+    ):
+        return None
+    result_type = value.get('typeDescriptions', {}).get('typeIdentifier', '')
+    ref = re.fullmatch(r't_contract\$_.*_\$(\d+)', result_type)
+    actual = units.get(int(ref[1]), {}) if ref else {}
+    expected = units.get(
+        (dest[0].get('typeName') or {}).get('referencedDeclaration'), {}
+    )
+    if (
+        expected.get('nodeType') != 'ContractDefinition'
+        or actual.get('id') == expected['id']
+        or expected['id'] not in actual.get('linearizedBaseContracts', [])
+    ):
+        return None
+    name = f'#returned{value["id"]}'
+    ty = n('UserDefinedTypeName', pathNode=n('IdentifierPath', name=actual['name']))
+    local = n('VariableDeclaration', name=name, typeName=ty, storageLocation='default')
+    address = call(
+        n(
+            'ElementaryTypeNameExpression',
+            typeName=n('ElementaryTypeName', name='address'),
+        ),
+        ident(name),
+    )
+    payable = n(
+        'FunctionCall',
+        kind='typeConversion',
+        expression=n(
+            'ElementaryTypeNameExpression',
+            typeName=n('ElementaryTypeName', name='address', stateMutability='payable'),
+        ),
+        arguments=[address],
+    )
+    # The nominal shell of an ABI-only return type may omit its bases. The
+    # solc declaration proves the upcast, and both types share the same address.
+    target = n(
+        'Identifier',
+        name=expected['name'],
+        referencedDeclaration=expected['id'],
+        typeDescriptions={
+            'typeIdentifier': 't_type$_'
+            + dest[0]['typeDescriptions']['typeIdentifier']
+            + '_$'
+        },
+    )
+    stmt['initialValue'] = call(target, payable)
+    return n('VariableDeclarationStatement', declarations=[local], initialValue=value)
+
+
+def bind_nested_word_calls(stmts, units):
+    """Evaluate a scalar call once before a call or a storage-reference binding."""
+    rewritten = []
+    for stmt in stmts:
+        rewritten.extend(conditional_initializer(stmt))
+        outer = stmt.get('initialValue') or {}
+        if stmt.get('nodeType') == 'VariableDeclarationStatement':
+            slot = None
+            if (
+                outer.get('nodeType') == 'FunctionCall'
+                and outer['expression'].get('nodeType') == 'Identifier'
+                and not outer.get('names')
+            ):
+                args = outer['arguments']
+                nested = [
+                    i
+                    for i, a in enumerate(args)
+                    if a['nodeType'] not in ('Identifier', 'Literal')
+                ]
+                if len(nested) == 1:
+                    slot = (args, nested[0])
+            elif (
+                outer.get('nodeType') == 'IndexAccess'
+                and outer['baseExpression'].get('nodeType') == 'MemberAccess'
+                and outer['baseExpression']['expression'].get('nodeType')
+                == 'Identifier'
+                and len(stmt['declarations']) == 1
+                and stmt['declarations'][0]
+                and stmt['declarations'][0]['storageLocation'] == 'storage'
+                and outer.get('indexExpression')
+            ):
+                slot = (outer, 'indexExpression')
+            if slot:
+                container, key = slot
+                capture = bind_pure_word(container[key], units)
+                if capture:
+                    rewritten.append(capture)
+                    container[key] = ident(capture['declarations'][0]['name'])
+        if stmt.get('nodeType') == 'VariableDeclarationStatement':
+            dest = stmt['declarations']
+            if (
+                len(dest) == 1
+                and dest[0]
+                and dest[0].get('storageLocation') == 'storage'
+            ):
+                reads = []
+                reference = capture_storage_indices(outer, units, reads)
+                if reference and reads:
+                    rewritten.extend(reads)
+                    stmt['initialValue'] = reference
+            rewritten.extend(sequence_call_inputs(outer, units))
+            binding = decode_contract_upcast(stmt, units)
+            if binding:
+                rewritten.append(binding)
+        rewritten.append(stmt)
+    stmts[:] = rewritten
+
+
+def bind_scalar_read(expr, ty, statements):
+    name = f'#read{expr["id"]}'
+    local = n(
+        'VariableDeclaration',
+        name=name,
+        typeName=deepcopy(ty),
+        storageLocation='default',
+    )
+    statements.append(
+        n('VariableDeclarationStatement', declarations=[local], initialValue=expr)
+    )
+    return ident(name)
+
+
+def capture_view_reads(
+    expr, units, statements, *, sole_argument=False, stable_siblings=False
+):
+    """Bind view-call results in solc IR order: receiver, arguments, invocation."""
+    kind = expr['nodeType']
+    if kind in ('Identifier', 'Literal'):
+        return expr
+    if kind == 'BinaryOperation' and expr.get('operator') in ('&&', '||'):
+        left_reads, right_reads = [], []
+        left = capture_view_reads(expr['leftExpression'], units, left_reads)
+        right = capture_view_reads(expr['rightExpression'], units, right_reads)
+        if not left or not right:
+            return None
+        setup, result = lazy_boolean(expr, left_reads, left, right_reads, right)
+        statements.extend(setup)
+        return result
+    if (
+        kind == 'BinaryOperation'
+        and not expr.get('function')
+        and expr.get('operator') in ('==', '!=', '<', '<=', '>', '>=')
+    ):
+        setup, value = bind_condition(expr, units)
+        if not setup:
+            return None
+        statements.extend(setup)
+        # bind_condition may retain checked arithmetic in the comparison.
+        # Finish it now, rather than after capturing a later call argument.
+        return bind_scalar_read(
+            value, n('ElementaryTypeName', name='bool'), statements
+        )
+    if kind == 'IndexAccess':
+        base = expr.get('baseExpression', {})
+        key = expr.get('indexExpression') or {}
+        # A calldata bounds/element check occurs before the next call. Keep
+        # the read inside its original short-circuit arm, including panics.
+        elem = expr.get('typeDescriptions', {}).get('typeString', '')
+        if (
+            base.get('nodeType') == 'Identifier'
+            and key.get('nodeType') in ('Identifier', 'Literal')
+            and re.fullmatch(r'u?int[0-9]+', elem)
+            and re.fullmatch(
+                r't_array\$_t_' + elem + r'_\$(?:dyn|[0-9]+)_calldata_ptr',
+                base.get('typeDescriptions', {}).get('typeIdentifier', ''),
+            )
+        ):
+            return bind_scalar_read(
+                expr, n('ElementaryTypeName', name=elem), statements
+            )
+        mapping = units.get(base.get('referencedDeclaration'), {}).get('typeName', {})
+        ty = mapping.get('valueType', {})
+        if (
+            base.get('nodeType') == 'Identifier'
+            and mapping.get('nodeType') == 'Mapping'
+            and key.get('nodeType') in ('Identifier', 'Literal')
+            and units.get(ty.get('referencedDeclaration'), {}).get('nodeType')
+            == 'ContractDefinition'
+        ):
+            name = f'#account{expr["id"]}'
+            local = n(
+                'VariableDeclaration',
+                name=name,
+                typeName=deepcopy(ty),
+                storageLocation='default',
+            )
+            statements.append(
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[local],
+                    initialValue=expr,
+                )
+            )
+            return ident(name)
+        return None
+    if kind == 'TupleExpression' and expr.get('isInlineArray'):
+        values = expr['components']
+        if not values or not all(
+            v and v['nodeType'] in ('Identifier', 'Literal') for v in values
+        ):
+            return None
+        if (
+            expr['typeDescriptions']['typeIdentifier']
+            != f't_array$_t_uint256_${len(values)}_memory_ptr'
+        ):
+            return None
+        size = n('Literal', kind='number', value=str(len(values)))
+        ty = n(
+            'ArrayTypeName',
+            baseType=n('ElementaryTypeName', name='uint256'),
+            length=size,
+        )
+        name = f'#array{expr["id"]}'
+        local = n(
+            'VariableDeclaration', name=name, typeName=ty, storageLocation='memory'
+        )
+        statements.append(
+            n('VariableDeclarationStatement', declarations=[local], initialValue=expr)
+        )
+        return ident(name)
+    if kind == 'MemberAccess':
+        base = expr['expression']
+        typ = base.get('typeDescriptions', {})
+        if (
+            expr.get('memberName') in ('min', 'max')
+            and base.get('expression', {})
+            .get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_function_metatype_')
+            and re.fullmatch(r'u?int[0-9]+', expr['typeDescriptions']['typeString'])
+        ):
+            return expr
+        if typ.get('typeString', '').startswith('type(enum ') or (
+            typ.get('typeIdentifier'),
+            expr.get('memberName'),
+        ) in {
+            ('t_magic_block', 'timestamp'),
+            ('t_magic_block', 'number'),
+            ('t_magic_message', 'sender'),
+            ('t_magic_message', 'value'),
+        }:
+            return expr
+        struct = re.fullmatch(
+            r't_struct\$_.*_\$(\d+)_(?:storage|calldata|memory)(?:_ptr)?',
+            typ.get('typeIdentifier', ''),
+        )
+        definition = units.get(int(struct[1]), {}) if struct else {}
+        field = next(
+            (
+                v
+                for v in definition.get('members', [])
+                if v['id'] == expr.get('referencedDeclaration')
+            ),
+            {},
+        )
+        if (
+            field
+            and base.get('nodeType') == 'Identifier'
+            and units.get(field['typeName'].get('referencedDeclaration'), {}).get(
+                'nodeType'
+            )
+            == 'ContractDefinition'
+        ):
+            return bind_scalar_read(expr, field['typeName'], statements)
+        if (
+            field
+            and base.get('nodeType') == 'IndexAccess'
+            and '_storage' in typ.get('typeIdentifier', '')
+            and re.fullmatch(
+                r'bool|u?int[0-9]+|address|bytes[0-9]+',
+                field['typeDescriptions']['typeString'],
+            )
+        ):
+            # Capture the selected storage word before evaluating the next operand.
+            indices = []
+            obj = capture_storage_indices(base, units, indices)
+            if obj:
+                statements.extend(indices)
+                return bind_scalar_read(
+                    {**expr, 'expression': obj}, field['typeName'], statements
+                )
+        if (
+            not base.get('typeDescriptions', {})
+            .get('typeString', '')
+            .startswith('struct ')
+        ):
+            return None
+        value = capture_view_reads(base, units, statements)
+        return {**expr, 'expression': value} if value else None
+    if kind != 'FunctionCall' or expr.get('names'):
+        return None
+    if expr.get('kind') == 'typeConversion':
+        if len(expr['arguments']) != 1 or not (
+            expr['typeDescriptions']['typeString'] in ('address', 'address payable')
+            or expr['typeDescriptions']['typeString'].startswith('contract ')
+            or re.fullmatch(r'u?int[0-9]+', expr['typeDescriptions']['typeString'])
+        ):
+            return None
+        arg = capture_view_reads(
+            expr['arguments'][0], units, statements, sole_argument=sole_argument
+        )
+        return {**expr, 'arguments': [arg]} if arg else None
+    method = expr['expression']
+    method_kind = method.get('typeDescriptions', {}).get('typeIdentifier', '')
+    if method_kind.startswith('t_function_keccak256_') and len(expr['arguments']) == 1:
+        encoded = expr['arguments'][0]
+        fn = encoded.get('expression', {})
+        if fn.get('typeDescriptions', {}).get('typeIdentifier', '').startswith(
+            't_function_abiencode_'
+        ) and all(
+            arg.get('nodeType') == 'Identifier'
+            and re.fullmatch(
+                r'address|u?int[0-9]+|bytes[0-9]+|bool',
+                arg['typeDescriptions']['typeString'],
+            )
+            for arg in encoded['arguments']
+        ):
+            name = f'#digest{expr["id"]}'
+            local = variable(name)
+            local['typeName']['name'] = 'bytes32'
+            statements.append(
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[local],
+                    initialValue=expr,
+                )
+            )
+            return ident(name)
+    external = method.get('nodeType') == 'MemberAccess' and method_kind.startswith(
+        't_function_external'
+    )
+    internal = method.get('nodeType') == 'Identifier' and method_kind.startswith(
+        't_function_internal'
+    )
+    extension = (
+        method.get('nodeType') == 'MemberAccess'
+        and method_kind.startswith('t_function_internal')
+        and method['expression'].get('nodeType') == 'Identifier'
+    )
+    if not (external or internal or extension):
+        return None
+    fn = units.get(method.get('referencedDeclaration'), {})
+    if internal or extension:
+        # Solidity permits a pure/view function to modify a caller's memory
+        # through reference arguments. Such calls cannot be moved past reads.
+        params = fn.get('parameters', {}).get('parameters', [])
+        if any(param.get('storageLocation') == 'memory' for param in params):
+            if not (
+                stable_siblings
+                and internal
+                and all(
+                    arg['nodeType'] in ('Identifier', 'Literal')
+                    for arg in expr['arguments']
+                )
+            ):
+                return None
+    returns = fn.get('returnParameters', {}).get('parameters', [])
+    if (
+        len(returns) == 1
+        and (
+            fn.get('stateMutability') in ('pure', 'view')
+            or (sole_argument and external)
+        )
+        and returns[0].get('storageLocation') not in ('calldata', 'storage')
+    ):
+        ty = deepcopy(returns[0]['typeName'])
+    elif (
+        external
+        and not expr['arguments']
+        and fn.get('stateVariable')
+        and fn.get('visibility') == 'public'
+        and fn['typeDescriptions']['typeIdentifier']
+        == expr['typeDescriptions']['typeIdentifier']
+        and fn.get('typeName', {}).get('nodeType')
+        in ('ElementaryTypeName', 'UserDefinedTypeName')
+        and units.get(fn['typeName'].get('referencedDeclaration'), {}).get('nodeType')
+        != 'StructDefinition'
+    ):
+        ty = deepcopy(fn['typeName'])
+    else:
+        return None
+    definition = units.get(ty.get('referencedDeclaration'), {})
+    if ty.get('nodeType') != 'ElementaryTypeName' and definition.get(
+        'nodeType'
+    ) not in ('ContractDefinition', 'EnumDefinition', 'StructDefinition'):
+        return None
+    if ty.get('name') in ('string', 'bytes'):
+        return None
+    if definition.get('canonicalName') and ty.get('pathNode'):
+        ty['pathNode']['name'] = definition['canonicalName']
+    if external:
+        receiver = capture_view_reads(method['expression'], units, statements)
+        if not receiver:
+            return None
+        method = {**method, 'expression': receiver}
+    args = []
+    for arg in expr['arguments']:
+        value = capture_view_reads(arg, units, statements)
+        if not value and arg.get('nodeType') == 'BinaryOperation':
+            value = scalar_operand(arg, units, statements)
+        if not value:
+            return None
+        args.append(value)
+    name = f'#view{expr["id"]}'
+    loc = 'memory' if definition.get('nodeType') == 'StructDefinition' else 'default'
+    local = n('VariableDeclaration', name=name, typeName=ty, storageLocation=loc)
+    statements.append(
+        n(
+            'VariableDeclarationStatement',
+            declarations=[local],
+            initialValue={
+                **expr,
+                'expression': method,
+                'arguments': args,
+            },
+        )
+    )
+    return ident(name)
+
+
+def scalar_operand(expr, units, reads):
+    kind = expr['nodeType']
+    ty = expr.get('typeDescriptions', {}).get('typeString', '')
+    if ty.startswith(('int_const ', 'rational_const ')):
+        return expr
+    if not re.fullmatch(r'u?int[0-9]+', ty):
+        return None
+    if kind == 'BinaryOperation' and not expr.get('function'):
+        left = scalar_operand(expr['leftExpression'], units, reads)
+        right = scalar_operand(expr['rightExpression'], units, reads)
+        if not left or not right:
+            return None
+        value = {**expr, 'leftExpression': left, 'rightExpression': right}
+    elif kind == 'MemberAccess' and (
+        (
+            expr['memberName'] in ('min', 'max')
+            and expr['expression']
+            .get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_magic_meta_type_')
+        )
+        or units.get(expr.get('referencedDeclaration'), {}).get('constant')
+        or expr['expression']
+        .get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .startswith('t_type$')
+    ):
+        value = expr
+    else:
+        value = capture_view_reads(expr, units, reads)
+        if not value:
+            return None
+    if value.get('nodeType') == 'Identifier' and value.get('name', '').startswith('#'):
+        return value
+    name = f'#operand{expr["id"]}'
+    var = variable(name)
+    var['typeName']['name'] = ty
+    reads.append(
+        n('VariableDeclarationStatement', declarations=[var], initialValue=value)
+    )
+    return ident(name)
+
+
+def contains_call_arithmetic(expr):
+    return expr.get('nodeType') == 'BinaryOperation' and any(
+        item.get('kind') == 'functionCall' for item in walk(expr)
+    )
+
+
+def bind_arithmetic_value(stmt, units):
+    """Materialize checked integer computations before their consuming statement."""
+    kind = stmt.get('nodeType')
+    if kind == 'Return':
+        value = stmt.get('expression') or {}
+    elif kind == 'ExpressionStatement':
+        assignment = stmt['expression']
+        if (
+            assignment.get('operator') != '='
+            or assignment.get('leftHandSide', {}).get('nodeType') != 'Identifier'
+        ):
+            return
+        value = assignment['rightHandSide']
+    else:
+        return
+    is_tuple = value.get('nodeType') == 'TupleExpression' and not value.get(
+        'isInlineArray'
+    )
+    parts = value['components'] if is_tuple else [value]
+    if not all(parts) or not any(contains_call_arithmetic(arg) for arg in parts):
+        return
+    reads = []
+    values = [scalar_operand(arg, units, reads) for arg in parts]
+    if not all(values):
+        return
+    result = {**value, 'components': values} if is_tuple else values[0]
+    if kind == 'Return':
+        original = {**stmt, 'expression': result}
+    else:
+        original = {**stmt, 'expression': {**assignment, 'rightHandSide': result}}
+    stmt.clear()
+    stmt.update(n('Block', statements=[*reads, original]))
+
+
+def arithmetic_library_inputs(outer, units):
+    """Evaluate scalar arguments of a static library call in their original order."""
+    method = outer.get('expression', {})
+    scope = units.get(method.get('expression', {}).get('referencedDeclaration'), {})
+    if (
+        method.get('nodeType') != 'MemberAccess'
+        or scope.get('contractKind') != 'library'
+        or outer.get('names')
+        or not any(contains_call_arithmetic(arg) for arg in outer.get('arguments', []))
+    ):
+        return None
+    reads = []
+
+    args = [scalar_operand(arg, units, reads) for arg in outer['arguments']]
+    if not all(args):
+        return None
+    outer['arguments'] = args
+    return reads
+
+
+def bind_effectful_external_inputs(outer, units):
+    """Freeze the receiver and each scalar argument at its Solidity evaluation point."""
+    method = outer['expression']
+    if (
+        not method.get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .startswith('t_function_external')
+    ):
+        return None
+    params = (
+        units.get(method.get('referencedDeclaration'), {})
+        .get('parameters', {})
+        .get('parameters', [])
+    )
+    args = outer['arguments']
+
+    def mutates(node):
+        fn = node.get('expression', {})
+        return (
+            node.get('kind') == 'functionCall'
+            and fn.get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_function_external')
+            and units.get(fn.get('referencedDeclaration'), {}).get('stateMutability')
+            in ('payable', 'nonpayable')
+        )
+
+    if (
+        not args
+        or len(args) != len(params)
+        or not any(mutates(node) for arg in args for node in walk(arg))
+    ):
+        return None
+    receiver = method.get('expression', {})
+    ref = re.fullmatch(
+        r't_contract\$_.*_\$(\d+)',
+        receiver.get('typeDescriptions', {}).get('typeIdentifier', ''),
+    )
+    decl = units.get(int(ref[1]), {}) if ref else {}
+    if decl.get('nodeType') != 'ContractDefinition':
+        return None
+    reads = []
+
+    def bind(name, ty, value):
+        var = n(
+            'VariableDeclaration', name=name, typeName=ty, storageLocation='default'
+        )
+        reads.append(
+            n('VariableDeclarationStatement', declarations=[var], initialValue=value)
+        )
+        return ident(name)
+
+    base = capture_view_reads(receiver, units, reads, sole_argument=True)
+    if not base:
+        return None
+    ty = n('UserDefinedTypeName', pathNode=n('IdentifierPath', name=decl['name']))
+    target = bind(f'#receiver{outer["id"]}', ty, base)
+    bound = []
+    for arg, param in zip(args, params):
+        ty = param['typeName']
+        if not (
+            re.fullmatch(r'bool|address|bytes[0-9]+|u?int[0-9]*', ty.get('name', ''))
+            or units.get(ty.get('referencedDeclaration'), {}).get('nodeType')
+            == 'ContractDefinition'
+        ):
+            return None
+        value = capture_view_reads(arg, units, reads, sole_argument=True)
+        if not value:
+            return None
+        bound.append(bind(f'#argument{arg["id"]}', deepcopy(ty), value))
+    outer.update(expression={**method, 'expression': target}, arguments=bound)
+    return reads
+
+
+def sequence_call_inputs(outer, units):
+    """Bind receiver and arguments independently of the call's return arity."""
+    if (
+        outer.get('nodeType') == 'FunctionCall'
+        and outer.get('kind') == 'typeConversion'
+    ):
+        reads = []
+        value = capture_view_reads(outer, units, reads, sole_argument=True)
+        if value and reads:
+            outer.update(value)
+            return reads
+        return []
+    if (
+        outer.get('nodeType') != 'FunctionCall'
+        or outer.get('kind') != 'functionCall'
+        or outer.get('names')
+    ):
+        return []
+    if outer['expression'].get('nodeType') == 'NewExpression':
+        target = units.get(
+            outer['expression'].get('typeName', {}).get('referencedDeclaration'), {}
+        )
+        ctor = next(
+            (f for f in target.get('nodes', []) if f.get('kind') == 'constructor'), {}
+        )
+        params = ctor.get('parameters', {}).get('parameters', [])
+        if len(params) != len(outer['arguments']) or not any(
+            v.get('kind') == 'functionCall'
+            for arg in outer['arguments']
+            for v in walk(arg)
+        ):
+            return []
+        reads = []
+        bound = []
+        for arg, param in zip(outer['arguments'], params):
+            local = discarded_local(param, f'#createArg{arg["id"]}', units)
+            if not local or local['storageLocation'] != 'default':
+                return []
+            value = capture_view_reads(arg, units, reads, sole_argument=True)
+            if not value:
+                return []
+            reads.append(
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[local],
+                    initialValue=value,
+                )
+            )
+            bound.append(ident(local['name']))
+        outer['arguments'] = bound
+        return reads
+    ordered = bind_effectful_external_inputs(outer, units)
+    if ordered is not None:
+        return ordered
+    arithmetic = arithmetic_library_inputs(outer, units)
+    if arithmetic is not None:
+        return arithmetic
+    method = outer['expression']
+    target = units.get(method.get('referencedDeclaration'), {})
+    if target.get('nodeType') not in ('FunctionDefinition', 'EventDefinition') and not (
+        target.get('stateVariable')
+        and target.get('visibility') == 'public'
+        and method.get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .startswith('t_function_external')
+    ):
+        return []
+    if (
+        method.get('nodeType') == 'Identifier'
+        and target.get('nodeType') == 'FunctionDefinition'
+        and any(
+            v.get('nodeType') == 'BinaryOperation'
+            for a in outer['arguments']
+            for v in walk(a)
+        )
+        and any(
+            v.get('kind') == 'functionCall' for a in outer['arguments'] for v in walk(a)
+        )
+    ):
+        reads = []
+        bound = [scalar_operand(arg, units, reads) for arg in outer['arguments']]
+        if all(bound) and reads:
+            outer['arguments'] = bound
+            return reads
+    reads = []
+    if method.get('nodeType') == 'MemberAccess':
+        receiver = capture_view_reads(method['expression'], units, reads)
+        if not receiver:
+            return []
+        method = {**method, 'expression': receiver}
+    elif method.get('nodeType') != 'Identifier':
+        return []
+    args = []
+    # For a direct internal function there is no runtime receiver. A sole
+    # argument can execute a mutating external call here without crossing
+    # another evaluation or changing its argument order.
+    sole = (
+        target.get('nodeType') == 'FunctionDefinition'
+        and method.get('nodeType') == 'Identifier'
+        and len(outer['arguments']) == 1
+    )
+    for arg in outer['arguments']:
+        stable = method.get('nodeType') == 'Identifier' and all(
+            other is arg
+            or other['nodeType'] == 'Literal'
+            or (
+                other['nodeType'] == 'Identifier'
+                and not units.get(other.get('referencedDeclaration'), {}).get(
+                    'stateVariable'
+                )
+            )
+            for other in outer['arguments']
+        )
+        stable_scalar_siblings = stable and all(
+            other is arg
+            or other['nodeType'] == 'Literal'
+            or re.fullmatch(
+                r'bool|address|u?int[0-9]+|bytes[0-9]+',
+                other.get('typeDescriptions', {}).get('typeString', ''),
+            )
+            for other in outer['arguments']
+        )
+        value = capture_view_reads(
+            arg,
+            units,
+            reads,
+            sole_argument=sole or stable_scalar_siblings,
+            stable_siblings=stable,
+        )
+        # Materialize checked arithmetic at its argument position, including
+        # calls whose other arguments are storage references. Waiting until
+        # after the invocation would lose overflow and external-call ordering.
+        if (
+            not value
+            and (
+                reads
+                or any(
+                    v.get('kind') == 'functionCall'
+                    and v.get('expression', {})
+                    .get('typeDescriptions', {})
+                    .get('typeIdentifier', '')
+                    .startswith(('t_function_external', 't_function_internal'))
+                    for sibling in outer['arguments']
+                    for v in walk(sibling)
+                )
+            )
+            and arg.get('nodeType') == 'BinaryOperation'
+            and all(
+                not v.get('function')
+                and (
+                    v.get('nodeType') != 'FunctionCall'
+                    or v.get('expression', {})
+                    .get('typeDescriptions', {})
+                    .get('typeIdentifier', '')
+                    .startswith(
+                        ('t_function_external_view', 't_function_external_pure')
+                    )
+                )
+                for v in walk(arg)
+            )
+        ):
+            value = scalar_operand(arg, units, reads)
+        if not value:
+            return []
+        args.append(value)
+    if not reads:
+        return []
+    outer.update(expression=method, arguments=args)
+    return reads
+
+
+def bind_storage_struct_write(stmt, assignment, units):
+    """Materialize a scalar struct before evaluating its destination's mapping key."""
+    rhs = assignment.get('rightHandSide', {})
+    lhs = assignment.get('leftHandSide', {})
+    definition = units.get(rhs.get('expression', {}).get('referencedDeclaration'), {})
+    if (
+        assignment.get('operator') != '='
+        or rhs.get('kind') != 'structConstructorCall'
+        or rhs.get('names')
+        or definition.get('nodeType') != 'StructDefinition'
+        or not lhs.get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .endswith('_storage')
+        or len(rhs['arguments']) != len(definition['members'])
+        or not all(
+            re.fullmatch(
+                r'bool|u?int(?:[0-9]+)?|address|bytes[0-9]+',
+                m['typeName'].get('name', ''),
+            )
+            for m in definition['members']
+        )
+    ):
+        return False
+    key_reads = []
+    dest = capture_storage_indices(lhs, units, key_reads)
+    if not dest or not key_reads:
+        return False
+    args, reads = [], []
+    for arg, field in zip(rhs['arguments'], definition['members']):
+        value = capture_view_reads(arg, units, reads)
+        if not value:
+            return False
+        # Finish evaluating each scalar at its own position, including checked
+        # arithmetic and any implicit conversion to the member's declared width.
+        name = f'#field{arg["id"]}'
+        local = n(
+            'VariableDeclaration',
+            name=name,
+            typeName=deepcopy(field['typeName']),
+            storageLocation='default',
+        )
+        reads.append(
+            n('VariableDeclarationStatement', declarations=[local], initialValue=value)
+        )
+        args.append(ident(name))
+    name = f'#struct{rhs["id"]}'
+    ty = n(
+        'UserDefinedTypeName',
+        pathNode=n('IdentifierPath', name=definition['canonicalName']),
+    )
+    local = n('VariableDeclaration', name=name, typeName=ty, storageLocation='memory')
+    reads.append(
+        n(
+            'VariableDeclarationStatement',
+            declarations=[local],
+            initialValue={**rhs, 'arguments': args},
+        )
+    )
+    write = {**assignment, 'leftHandSide': dest, 'rightHandSide': ident(name)}
+    stmt.clear()
+    stmt.update(
+        n(
+            'Block',
+            statements=[*reads, *key_reads, n('ExpressionStatement', expression=write)],
+        )
+    )
+    return True
+
+
+def bind_call_arguments(stmt, units):
+    """Sequence a view result consumed by another source-level call."""
+    outer = stmt.get('eventCall') or stmt.get('expression') or {}
+    if outer.get('nodeType') == 'Assignment' and bind_storage_struct_write(
+        stmt, outer, units
+    ):
+        return
+    dest = outer.get('leftHandSide', {})
+    rhs = outer.get('rightHandSide', {})
+    if (
+        outer.get('operator') == '='
+        and dest.get('nodeType') == 'MemberAccess'
+        and dest['expression'].get('nodeType') == 'Identifier'
+        and rhs.get('nodeType') == 'FunctionCall'
+        and rhs['expression']
+        .get('typeDescriptions', {})
+        .get('typeIdentifier', '')
+        .startswith('t_function_external')
+        and re.fullmatch(r'u?int[0-9]+', rhs['typeDescriptions']['typeString'])
+    ):
+        # Finish the call, including ABI decoding, before writing the source lvalue.
+        name = f'#value{rhs["id"]}'
+        local = variable(name)
+        local['typeName']['name'] = rhs['typeDescriptions']['typeString']
+        read = n('VariableDeclarationStatement', declarations=[local], initialValue=rhs)
+        outer['rightHandSide'] = ident(name)
+        write = dict(stmt)
+        stmt.clear()
+        stmt.update(
+            n('Block', statements=[*sequence_call_inputs(rhs, units), read, write])
+        )
+        return
+    if (
+        outer.get('nodeType') == 'Assignment'
+        and outer.get('operator') == '='
+        and (
+            outer['leftHandSide'].get('nodeType') == 'Identifier'
+            or (
+                outer['leftHandSide'].get('nodeType') == 'TupleExpression'
+                and all(
+                    v and v.get('nodeType') == 'Identifier'
+                    for v in outer['leftHandSide']['components']
+                )
+            )
+        )
+    ):
+        outer = outer['rightHandSide']
+    reads = sequence_call_inputs(outer, units)
+    if not reads:
+        return
+    original = dict(stmt)
+    stmt.clear()
+    stmt.update(n('Block', statements=[*reads, original]))
+
+
+def lazy_boolean(expr, left_reads, left, right_reads, right):
+    op = expr['operator']
+    if not right_reads:
+        return left_reads, {**expr, 'leftExpression': left, 'rightExpression': right}
+    name = f'#cond{expr["id"]}'
+    var = n(
+        'VariableDeclaration',
+        name=name,
+        typeName=n('ElementaryTypeName', name='bool'),
+        storageLocation='default',
+    )
+    init = n('VariableDeclarationStatement', declarations=[var], initialValue=left)
+    test = ident(name)
+    if op == '||':
+        test = n('UnaryOperation', operator='!', prefix=True, subExpression=test)
+    update = n(
+        'ExpressionStatement',
+        expression=n(
+            'Assignment',
+            operator='=',
+            leftHandSide=ident(name),
+            rightHandSide=right,
+        ),
+    )
+    guard = n(
+        'IfStatement',
+        condition=test,
+        trueBody=n('Block', statements=[*right_reads, update]),
+    )
+    return [*left_reads, init, guard], ident(name)
+
+
+def bind_condition(expr, units):
+    """Keep right-hand-side reads inside Solidity's short-circuit branch."""
+    op = expr.get('operator')
+    if expr.get('nodeType') == 'UnaryOperation' and op == '!':
+        reads, value = bind_condition(expr['subExpression'], units)
+        return reads, {**expr, 'subExpression': value}
+    if op in ('&&', '||'):
+        left_reads, left = bind_condition(expr['leftExpression'], units)
+        right_reads, right = bind_condition(expr['rightExpression'], units)
+        return lazy_boolean(expr, left_reads, left, right_reads, right)
+    if op in ('==', '!=', '<', '<=', '>', '>='):
+        reads = []
+        if any(
+            contains_call_arithmetic(expr[k])
+            for k in ('leftExpression', 'rightExpression')
+        ):
+            left = scalar_operand(expr['leftExpression'], units, reads)
+            right = scalar_operand(expr['rightExpression'], units, reads)
+            if left and right:
+                return reads, {**expr, 'leftExpression': left, 'rightExpression': right}
+            reads = []
+        left = capture_view_reads(expr['leftExpression'], units, reads)
+        nleft = len(reads)
+        right = capture_view_reads(expr['rightExpression'], units, reads)
+        # The full left call is already bound. Keep the untouched arithmetic
+        # on the right in place, including checked overflow and underflow.
+        if (
+            left
+            and left.get('nodeType') == 'Identifier'
+            and nleft
+            and not right
+            and expr['rightExpression'].get('nodeType') == 'BinaryOperation'
+            and all(
+                v['nodeType']
+                in ('BinaryOperation', 'Identifier', 'Literal', 'MemberAccess')
+                for v in walk(expr['rightExpression'])
+                if 'nodeType' in v
+            )
+        ):
+            return reads[:nleft], {**expr, 'leftExpression': left}
+        both_bound = all(
+            v
+            and v.get('nodeType') == 'Identifier'
+            and v.get('name', '').startswith('#')
+            for v in (left, right)
+        )
+        if (
+            left
+            and right
+            and reads
+            and (both_bound or not (nleft and len(reads) != nleft))
+        ):
+            return reads, {**expr, 'leftExpression': left, 'rightExpression': right}
+    elif expr.get('typeDescriptions', {}).get('typeIdentifier') == 't_bool':
+        reads = []
+        value = capture_view_reads(expr, units, reads)
+        if value and reads:
+            return reads, value
+    return [], expr
+
+
+def bind_view_comparison(stmt, units):
+    """Only lower eager comparisons within their original branch or require."""
+    if stmt['nodeType'] in ('IfStatement', 'WhileStatement'):
+        condition = stmt['condition']
+    else:
+        req = stmt['expression']
+        if (
+            req.get('nodeType') != 'FunctionCall'
+            or not req['expression']
+            .get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_function_require')
+            or len(req['arguments']) != 2
+            or req['arguments'][1].get('kind') != 'string'
+        ):
+            return
+        condition = req['arguments'][0]
+    reads, value = bind_condition(condition, units)
+    if not reads:
+        return
+    if stmt['nodeType'] == 'WhileStatement':
+        stop = n(
+            'IfStatement',
+            condition=n(
+                'UnaryOperation', operator='!', prefix=True, subExpression=value
+            ),
+            trueBody=n('Break'),
+        )
+        stmt['body'] = n('Block', statements=[*reads, stop, stmt['body']])
+        stmt['condition'] = n('Literal', kind='bool', value='true')
+        return
+    if stmt['nodeType'] == 'IfStatement':
+        stmt['condition'] = value
+    else:
+        req['arguments'][0] = value
+    original = dict(stmt)
+    stmt.clear()
+    stmt.update(n('Block', statements=[*reads, original]))
+
+
+def project(ast, target):
+    nodes = ast['nodes']
+    (root,) = (
+        n
+        for n in nodes
+        if n.get('nodeType') == 'ContractDefinition' and n['name'] == target
+    )
+    owners = {}
+    units = {}
+    containers = {}
+    for top in nodes:
+        units[top['id']] = top
+        if top['nodeType'] == 'ContractDefinition':
+            for member in top['nodes']:
+                units[member['id']] = member
+                containers[member['id']] = top
+                for d in walk(member):
+                    if 'id' in d:
+                        owners[d['id']] = member['id']
+            owners[top['id']] = top['id']
+        else:
+            for d in walk(top):
+                if 'id' in d:
+                    owners[d['id']] = top['id']
+
+    # A qualified enum or struct names its declaring scope without executing
+    # that scope. Keep the type and its container. A direct use of the
+    # contract itself, its bases, or an ordinary executable member still
+    # retains the complete foreign contract (including virtual dispatch).
+    type_members = {
+        'EnumDefinition',
+        'StructDefinition',
+        'UserDefinedValueTypeDefinition',
+    }
+    # An interface has no executable implementation. A contract appearing as a
+    # parameter or field type contributes its nominal identity and ABI address
+    # encoding. Follow inheritance edges and ordinary references separately.
+    abi_only = root['contractKind'] == 'interface'
+    nominal = set()
+    used = set()
+    shells = set()
+    pending = [root['id']] + [
+        i['id']
+        for i in nodes
+        if i['nodeType'] in ('PragmaDirective', 'UsingForDirective')
+    ]
+    while pending:
+        key = pending.pop()
+        if key in used:
+            continue
+        used.add(key)
+        node = units[key]
+        if key in containers:
+            owner = containers[key]
+            if node['nodeType'] in type_members:
+                shells.add(owner['id'])
+                # Keep the original inheritance environment if present.
+                for base in owner.get('baseContracts', []):
+                    pending.append(base['baseName']['referencedDeclaration'])
+            else:
+                pending.append(owner['id'])
+        if node['nodeType'] == 'ContractDefinition':
+            for member in node['nodes']:
+                if (
+                    node is root
+                    or node['contractKind'] != 'library'
+                    or member['nodeType'] == 'UsingForDirective'
+                ):
+                    pending.append(member['id'])
+            node = {k: v for k, v in node.items() if k != 'nodes'}
+        nominal_refs = set()
+        if abi_only or containers.get(key, {}).get('contractKind') == 'interface':
+            for var in walk(node):
+                if var.get('nodeType') != 'VariableDeclaration':
+                    continue
+                for ty in walk(var.get('typeName')):
+                    if ty.get('nodeType') == 'UserDefinedTypeName':
+                        ref = ty.get('referencedDeclaration')
+                        if units.get(ref, {}).get('nodeType') == 'ContractDefinition':
+                            nominal.add(ref)
+                            nominal_refs.add(id(ty))
+                            nominal_refs.add(id(ty.get('pathNode')))
+        for item in walk(node):
+            if id(item) in nominal_refs:
+                continue
+            # An inherited external call refers to the method's declaring base.
+            # Keep the actual receiver's C3 hierarchy as well, even if the
+            # receiver type occurs only as the result of an interface call.
+            if item.get('nodeType') == 'MemberAccess' and item.get(
+                'typeDescriptions', {}
+            ).get('typeIdentifier', '').startswith('t_function_external'):
+                receiver = (
+                    item['expression']
+                    .get('typeDescriptions', {})
+                    .get('typeIdentifier', '')
+                )
+                match = re.fullmatch(r't_contract\$_.*_\$(\d+)', receiver)
+                if (
+                    match
+                    and units.get(int(match[1]), {}).get('nodeType')
+                    == 'ContractDefinition'
+                ):
+                    pending.append(int(match[1]))
+            for field in ('referencedDeclaration', 'function', 'declaration'):
+                ref = item.get(field)
+                if isinstance(ref, int) and ref in owners:
+                    pending.append(owners[ref])
+    result = {
+        **ast,
+        'nodes': [
+            {
+                **node,
+                **(
+                    {'baseContracts': []}
+                    if node['id'] in nominal - shells - used
+                    else {}
+                ),
+                # A type-only namespace can inherit abstract obligations whose
+                # implementations were intentionally omitted from this projection.
+                **(
+                    {'abstract': True}
+                    if node['id'] in shells - used
+                    and node['contractKind'] == 'contract'
+                    and node.get('baseContracts')
+                    else {}
+                ),
+                'nodes': [member for member in node['nodes'] if member['id'] in used],
+            }
+            if node['nodeType'] == 'ContractDefinition'
+            else node
+            for node in nodes
+            if node['id'] in used or node['id'] in shells or node['id'] in nominal
+        ],
+    }
+
+    # abi.encodeCall applies implicit conversions to its declared parameter types.
+    # Only use the selector form when solc records identical elementary argument
+    # and parameter types and reading the receiver has no side effects.
+    result = deepcopy(result)
+    # Lean's source unit has one unqualified type environment. Use solc's
+    # declaration identity to retain lexical scope for contract-local types,
+    # including two libraries with distinct structs both named Store.
+    for ty in walk(result):
+        ref = ty.get('referencedDeclaration')
+        definition = units.get(ref, {})
+        if (
+            ty.get('nodeType') == 'Identifier'
+            and ref in containers
+            and definition.get('nodeType') in type_members
+            and ty.get('name') == definition['name']
+            and ty.get('typeDescriptions', {}).get('typeString', '').startswith('type(')
+        ):
+            ty.pop('name')
+            ty.update(
+                nodeType='MemberAccess',
+                expression=ident(containers[ref]['name']),
+                memberName=definition['name'],
+            )
+        if ty.get('nodeType') != 'UserDefinedTypeName':
+            continue
+        path = ty.get('pathNode', {})
+        if (
+            definition.get('nodeType') in type_members
+            and ref in containers
+            and path.get('referencedDeclaration') == ref
+            and path.get('name') == definition['name']
+        ):
+            path['name'] = definition['canonicalName']
+    returns = {
+        fn['returnParameters']['id']: fn['returnParameters']['parameters']
+        for fn in walk(result)
+        if fn.get('nodeType') == 'FunctionDefinition'
+    }
+    for expr in walk(result):
+        if expr.get('nodeType') == 'TryStatement':
+            success = expr['clauses'][0]
