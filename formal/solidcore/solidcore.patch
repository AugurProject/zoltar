+def compact_fresh_bytes(stmts):
+    """Lower a length write only when all uses establish a fresh, bounded prefix."""
+    for i, asm in enumerate(stmts):
+        if not isinstance(asm, dict) or asm.get('nodeType') != 'InlineAssembly':
+            continue
+        ops = asm['AST']['statements']
+        if (
+            len(ops) != 1
+            or ops[0]['nodeType'] != 'YulExpressionStatement'
+            or asm.get('flags', []) not in ([], ['memory-safe'])
+        ):
+            continue
+        value = ops[0]['expression']
+        expr = yul_expr(value)
+        if (
+            not isinstance(expr, tuple)
+            or len(expr) != 3
+            or expr[0] != 'mstore'
+            or not all(isinstance(x, str) for x in expr[1:])
+        ):
+            continue
+        refs = {r['src']: r for r in asm['externalReferences']}
+        if set(refs) != {a['src'] for a in value['arguments']} or any(
+            r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+            for r in refs.values()
+        ):
+            continue
+        buf, count = [refs[arg['src']]['declaration'] for arg in value['arguments']]
+        # Find the two local declarations in this very block. No use can
+        # precede the fresh allocation, and no prior alias to it can exist.
+        declarations = {}
+        for j, stmt in enumerate(stmts[:i]):
+            if (
+                not isinstance(stmt, dict)
+                or stmt.get('nodeType') != 'VariableDeclarationStatement'
+            ):
+                continue
+            ds = stmt.get('declarations', [])
+            if len(ds) == 1 and ds[0] and ds[0].get('id') in (buf, count):
+                declarations[ds[0]['id']] = j, ds[0], stmt.get('initialValue') or {}
+        if declarations.keys() != {buf, count}:
+            continue
+        start, dest, init = declarations[buf]
+        counter_pos, counter, counter_init = declarations[count]
+        if (
+            not start < counter_pos
+            or dest['name'] != expr[1]
+            or counter['name'] != expr[2]
+            or dest['storageLocation'] != 'memory'
+            or dest['typeName'].get('name') != 'bytes'
+            or counter.get('typeDescriptions', {}).get('typeString') != 'uint256'
+            or counter_init
+            or init.get('nodeType') != 'FunctionCall'
+            or init['expression'].get('nodeType') != 'NewExpression'
+            or init['expression']['typeName'].get('name') != 'bytes'
+        ):
+            continue
+        between = stmts[start + 1 : i]
+        nodes = list(walk(between))
+        if any(
+            x.get('nodeType')
+            in ('InlineAssembly', 'FunctionCall', 'FunctionCallOptions')
+            for x in nodes
+        ):
+            continue
+        permitted = set()
+        for stmt in nodes:
+            if stmt.get('nodeType') != 'Assignment' or stmt['operator'] != '=':
+                continue
+            lhs = stmt['leftHandSide']
+            if lhs.get('nodeType') != 'IndexAccess':
+                continue
+            array, index = lhs['baseExpression'], lhs['indexExpression']
+            if (
+                array.get('referencedDeclaration') != buf
+                or index.get('nodeType') != 'UnaryOperation'
+                or index.get('operator') != '++'
+                or index.get('prefix')
+            ):
+                continue
+            var = index['subExpression']
+            if var.get('referencedDeclaration') == count:
+                permitted.update([id(array), id(var)])
+        uses = {id(x) for x in nodes if x.get('referencedDeclaration') in (buf, count)}
+        if uses != permitted:
+            continue
+        # On every path reaching mstore, each increment used the old count
+        # as an in-bounds index. Thus count <= capacity; the only reference
+        # to this allocation is the local. Preserve its first count bytes.
+        # Isolate the post-increment in a standalone statement where neither
+        # side observes count and the RHS consists entirely of a bytes read.
+        for node in nodes:
+            if node.get('nodeType') != 'ExpressionStatement':
+                continue
+            write = node['expression']
+            if write.get('nodeType') != 'Assignment':
+                continue
+            lhs = write['leftHandSide']
+            rhs = write['rightHandSide']
+            if (
+                lhs.get('nodeType') != 'IndexAccess'
+                or id(lhs['baseExpression']) not in permitted
+                or rhs.get('nodeType') != 'IndexAccess'
+                or rhs['indexExpression'].get('nodeType') != 'Identifier'
+                or rhs['baseExpression'].get('nodeType') != 'Identifier'
+            ):
+                continue
+            increment = lhs['indexExpression']
+            lhs['indexExpression'] = increment['subExpression']
+            node.clear()
+            node.update(
+                n(
+                    'Block',
+                    statements=[
+                        n('ExpressionStatement', expression=write),
+                        n('ExpressionStatement', expression=increment),
+                    ],
+                )
+            )
+        tmp = '#compact_bytes'
+        index = '#compact_index'
+        fresh = {**dest, 'name': tmp}
+        fresh.pop('id', None)
+        make = call(
+            n('NewExpression', typeName=dest['typeName']), ident(counter['name'])
+        )
+
+        def at(name):
+            return n(
+                'IndexAccess', baseExpression=ident(name), indexExpression=ident(index)
+            )
+
+        def set_value(lhs, rhs):
+            return n(
+                'ExpressionStatement',
+                expression=n(
+                    'Assignment', operator='=', leftHandSide=lhs, rightHandSide=rhs
+                ),
+            )
+
+        stmts[i] = n(
+            'Block',
+            statements=[
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[fresh],
+                    initialValue=make,
+                ),
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[variable(index)],
+                    initialValue=lit(0),
+                ),
+                n(
+                    'WhileStatement',
+                    condition=binary('<', ident(index), ident(counter['name'])),
+                    body=n(
+                        'Block',
+                        statements=[
+                            set_value(at(tmp), at(dest['name'])),
+                            set_value(ident(index), binary('+', ident(index), lit(1))),
+                        ],
+                    ),
+                ),
+                set_value(ident(dest['name']), ident(tmp)),
+            ],
+        )
+
+
+def scalar_modexp(block, declarations):
+    """Six fixed words at the free pointer, then a bounded STATICCALL at 0."""
+    ops = block['AST']['statements']
+    if block.get('flags') != ['memory-safe'] or [op['nodeType'] for op in ops] != (
+        ['YulVariableDeclaration']
+        + 6 * ['YulExpressionStatement']
+        + 2 * ['YulAssignment']
+    ):
+        return None
+    if len(ops[0]['variables']) != 1 or any(
+        len(op['variableNames']) != 1 for op in ops[-2:]
+    ):
+        return None
+    ptr = ops[0]['variables'][0]['name']
+    refs = {r['src']: r for r in block['externalReferences']}
+    seen = set()
+
+    def local(node, ty):
+        ref = refs.get(node.get('src'), {})
+        d = declarations.get(ref.get('declaration'), {})
+        if (
+            node.get('nodeType') != 'YulIdentifier'
+            or ref.get('isSlot')
+            or ref.get('isOffset')
+            or ref.get('suffix')
+            or ref.get('valueSize') != 1
+            or d.get('stateVariable')
+            or node.get('name') != d.get('name')
+            or d.get('typeDescriptions', {}).get('typeIdentifier') != ty
+        ):
+            return None
+        seen.add(node['src'])
+        return d['name']
+
+    if yul_expr(ops[0]['value']) != ('mload', 64):
+        return None
+    words = []
+    for i, stmt in enumerate(ops[1:7]):
+        op = stmt['expression']
+        args = op.get('arguments', [])
+        offset = ptr if i == 0 else ('add', ptr, 32 * i)
+        if (
+            op.get('functionName', {}).get('name') != 'mstore'
+            or len(args) != 2
+            or yul_expr(args[0]) != offset
+        ):
+            return None
+        if i < 3:
+            if yul_expr(args[1]) != 32:
+                return None
+            words.append(lit(32))
+        else:
+            name = local(args[1], 't_uint256')
+            if name is None:
+                return None
+            words.append(ident(name))
+    ok = local(ops[-2]['variableNames'][0], 't_bool')
+    result = local(ops[-1]['variableNames'][0], 't_uint256')
+    if (
+        not ok
+        or not result
+        or seen != refs.keys()
+        or yul_expr(ops[-2]['value']) != ('staticcall', ('gas',), 5, ptr, 192, 0, 32)
+        or yul_expr(ops[-1]['value']) != ('mload', 0)
+    ):
+        return None
+    target = call(
+        n(
+            'ElementaryTypeNameExpression',
+            typeName=n('ElementaryTypeName', name='address'),
+        ),
+        n('Literal', kind='number', value='5'),
+    )
+    options = n(
+        'FunctionCallOptions',
+        expression=n('MemberAccess', expression=target, memberName='staticcall'),
+        names=['gas'],
+        options=[call(ident('gasleft'))],
+    )
+    payload = call(
+        n('MemberAccess', expression=ident('abi'), memberName='encode'), *words
+    )
+    success = variable('#ok')
+    success['typeName']['name'] = 'bool'
+    data = variable('#ret')
+    data.update(
+        typeName=n('ElementaryTypeName', name='bytes'), storageLocation='memory'
+    )
+    zero = n('Literal', kind='number', value='0')
+    return n(
+        'Block',
+        statements=[
+            n(
+                'VariableDeclarationStatement',
+                declarations=[success, data],
+                initialValue=call(options, payload),
+            ),
+            n(
+                'ExpressionStatement',
+                expression=n(
+                    'Assignment',
+                    operator='=',
+                    leftHandSide=ident(ok),
+                    rightHandSide=ident('#ok'),
+                ),
+            ),
+            n(
+                'ExpressionStatement',
+                expression=call(ident('#yul.scratchReturn'), zero, ident('#ret')),
+            ),
+            n(
+                'ExpressionStatement',
+                expression=n(
+                    'Assignment',
+                    operator='=',
+                    leftHandSide=ident(result),
+                    rightHandSide=call(ident('#yul.scratchLoad'), zero),
+                ),
+            ),
+        ],
+    )
+
+
+def overwrite_modexp_result(fn):
+    """Recover the explicit input/output buffer of the bytes modexp assembly."""
+    body = (fn.get('body') or {}).get('statements', [])
+    params = fn['parameters']['parameters']
+    returns = fn['returnParameters']['parameters']
+    if len(body) < 3 or len(params) != 3 or len(returns) != 2 or fn.get('modifiers'):
+        return
+
+    def typ(var):
+        return var.get('typeDescriptions', {}).get('typeIdentifier')
+
+    if [typ(v) for v in params + returns] != ['t_bytes_memory_ptr'] * 3 + [
+        't_bool',
+        't_bytes_memory_ptr',
+    ]:
+        return
+    size_stmt, encode_stmt, asm = body[-3:]
+    if asm.get('nodeType') != 'InlineAssembly' or asm.get('flags') != ['memory-safe']:
+        return
+    sizes = size_stmt.get('declarations', [])
+    if len(sizes) != 1 or not sizes[0] or typ(sizes[0]) != 't_uint256':
+        return
+    length = sizes[0]
+    ok, result = returns
+
+    def ref(e):
+        return (
+            e.get('referencedDeclaration')
+            if e.get('nodeType') == 'Identifier'
+            else None
+        )
+
+    def length_of(e):
+        return (
+            ref(e['expression'])
+            if e.get('nodeType') == 'MemberAccess' and e['memberName'] == 'length'
+            else None
+        )
+
+    assignment = encode_stmt.get('expression', {})
+    encoded = assignment.get('rightHandSide', {})
+    encoder = encoded.get('expression', {})
+    args = encoded.get('arguments', [])
+    if (
+        length_of(size_stmt.get('initialValue') or {}) != params[2]['id']
+        or assignment.get('operator') != '='
+        or ref(assignment.get('leftHandSide', {})) != result['id']
+        or not str(typ(encoder)).startswith('t_function_abiencodepacked_')
+        or len(args) != 6
+        or [length_of(e) for e in args[:2]] != [v['id'] for v in params[:2]]
+        or ref(args[2]) != length['id']
+        or [ref(e) for e in args[3:]] != [v['id'] for v in params]
+    ):
+        return
+    ops = asm['AST']['statements']
+    if [op['nodeType'] for op in ops] != [
+        'YulVariableDeclaration',
+        'YulAssignment',
+        'YulExpressionStatement',
+        'YulExpressionStatement',
+    ]:
+        return
+    if len(ops[0]['variables']) != 1 or len(ops[1]['variableNames']) != 1:
+        return
+    ptr = ops[0]['variables'][0]['name']
+    buf, size, success = [v['name'] for v in (result, length, ok)]
+    ids = {v['name']: v['id'] for v in (result, length, ok)}
+    if (
+        len(set((ptr, buf, size, success))) != 4
+        or ops[1]['variableNames'][0]['name'] != success
+    ):
+        return
+    if [yul_expr(op.get('value', op.get('expression'))) for op in ops] != [
+        ('add', buf, 32),
+        ('staticcall', ('gas',), 5, ptr, ('mload', buf), ptr, size),
+        ('mstore', buf, size),
+        ('mstore', 64, ('add', ptr, size)),
+    ]:
+        return
+    uses = {
+        x['src']: ids[x['name']]
+        for x in walk(ops)
+        if x.get('nodeType') == 'YulIdentifier' and x['name'] in ids
+    }
+    refs = asm['externalReferences']
+    if {r['src']: r['declaration'] for r in refs} != uses or any(
+        r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+        for r in refs
+    ):
+        return
+
+    def local(name, ty, location='default'):
+        return n(
+            'VariableDeclaration',
+            name=name,
+            typeName=n('ElementaryTypeName', name=ty),
+            storageLocation=location,
+        )
+
+    def assign(lhs, rhs):
+        return n(
+            'ExpressionStatement',
+            expression=n(
+                'Assignment', operator='=', leftHandSide=lhs, rightHandSide=rhs
+            ),
+        )
+
+    def member(obj, field):
+        return n('MemberAccess', expression=obj, memberName=field)
+
+    def at(name):
+        return n('IndexAccess', baseExpression=ident(name), indexExpression=ident('#i'))
+
+    addr = call(
+        n(
+            'ElementaryTypeNameExpression',
+            typeName=n('ElementaryTypeName', name='address'),
+        ),
+        n('Literal', kind='number', value='5'),
+    )
+    static = n(
+        'FunctionCallOptions',
+        expression=member(addr, 'staticcall'),
+        names=['gas'],
+        options=[call(ident('gasleft'))],
+    )
+    # CALL copies a prefix even on failure. Bytes beyond returndata are the
+    # original request, which always includes the complete modulus.
+    body[-1:] = [
+        n(
+            'VariableDeclarationStatement',
+            declarations=[local('#ok', 'bool'), local('#ret', 'bytes', 'memory')],
+            initialValue=call(static, ident(buf)),
+        ),
+        assign(ident(success), ident('#ok')),
+        n(
+            'VariableDeclarationStatement',
+            declarations=[local('#out', 'bytes', 'memory')],
+            initialValue=call(
+                n('NewExpression', typeName=n('ElementaryTypeName', name='bytes')),
+                ident(size),
+            ),
+        ),
+        n(
+            'VariableDeclarationStatement',
+            declarations=[variable('#i')],
+            initialValue=lit(0),
+        ),
+        n(
+            'WhileStatement',
+            condition=binary('<', ident('#i'), ident(size)),
+            body=n(
+                'Block',
+                statements=[
+                    n(
+                        'IfStatement',
+                        condition=binary(
+                            '<', ident('#i'), member(ident('#ret'), 'length')
+                        ),
+                        trueBody=assign(at('#out'), at('#ret')),
+                        falseBody=assign(at('#out'), at(buf)),
+                    ),
+                    assign(ident('#i'), binary('+', ident('#i'), lit(1))),
+                ],
+            ),
+        ),
+        assign(ident(buf), ident('#out')),
+    ]
+
+
+def guarded_delegate_fallback(fn, declarations):
+    """Recognize a complete selector-gated, returndata-forwarding fallback."""
+    if (
+        fn.get('kind') != 'fallback'
+        or fn.get('modifiers')
+        or not fn.get('body')
+        or fn['parameters']['parameters']
+        or fn['returnParameters']['parameters']
+    ):
+        return False
+    body = fn['body']['statements']
+    if not body or any(
+        s['nodeType'] != 'VariableDeclarationStatement' for s in body[:-1]
+    ):
+        return False
+    block = body[-1]
+    if block.get('nodeType') != 'InlineAssembly' or block.get('flags') != [
+        'memory-safe'
+    ]:
+        return False
+
+    def shape(stmt):
+        match stmt['nodeType']:
+            case 'YulVariableDeclaration' if len(stmt['variables']) == 1:
+                return (
+                    'let',
+                    stmt['variables'][0]['name'],
+                    yul_expr(stmt.get('value')),
+                )
+            case 'YulIf':
+                return (
+                    'if',
+                    yul_expr(stmt['condition']),
+                    tuple(map(shape, stmt['body']['statements'])),
+                )
+            case 'YulExpressionStatement':
+                return yul_expr(stmt['expression'])
+        return None
+
+    ops = list(map(shape, block['AST']['statements']))
+    match ops:
+        case [
+            ('let', sel, ('shr', 224, ('calldataload', 0))),
+            (
+                'if',
+                (
+                    'iszero',
+                    ('or', ('or', ('eq', s1, k1), ('eq', s2, k2)), ('eq', s3, k3)),
+                ),
+                (('revert', 0, 0),),
+            ),
+            ('let', ptr, ('mload', 64)),
+            ('calldatacopy', p1, 0, ('calldatasize',)),
+            (
+                'if',
+                (
+                    'iszero',
+                    ('delegatecall', ('gas',), target, p2, ('calldatasize',), 0, 0),
+                ),
+                (
+                    ('returndatacopy', p3, 0, ('returndatasize',)),
+                    ('revert', p4, ('returndatasize',)),
+                ),
+            ),
+            ('returndatacopy', p5, 0, ('returndatasize',)),
+            ('return', p6, ('returndatasize',)),
+        ]:
+            if (sel, sel, sel) != (s1, s2, s3) or (ptr,) * 6 != (
+                p1,
+                p2,
+                p3,
+                p4,
+                p5,
+                p6,
+            ):
+                return False
+        case _:
+            return False
+    names = (k1, k2, k3, target)
+    if any(not isinstance(n, str) for n in names) or len(set((*names, sel, ptr))) != 6:
+        return False
+    types = dict(zip(names, ('uint256', 'uint256', 'uint256', 'address')))
+    uses = {
+        v['src']: v['name']
+        for v in walk(block['AST'])
+        if v.get('nodeType') == 'YulIdentifier' and v['name'] in types
+    }
+    refs = block['externalReferences']
+    if {r['src'] for r in refs} != uses.keys():
+        return False
+    for r in refs:
+        dec = declarations.get(r['declaration'], {})
+        name = uses[r['src']]
+        if (
+            r['valueSize'] != 1
+            or r['isSlot']
+            or r['isOffset']
+            or r.get('suffix')
+            or dec.get('stateVariable')
+            or dec.get('name') != name
+            or dec.get('typeDescriptions', {}).get('typeString') != types[name]
+        ):
+            return False
+
+    def local(name, ty, loc='default'):
+        return n(
+            'VariableDeclaration',
+            name=name,
+            typeName=n('ElementaryTypeName', name=ty),
+            storageLocation=loc,
+        )
+
+    fn['parameters']['parameters'] = [local('#input', 'bytes', 'calldata')]
+    fn['returnParameters']['parameters'] = [local('', 'bytes', 'memory')]
+    sig = call(
+        n(
+            'ElementaryTypeNameExpression',
+            typeName=n('ElementaryTypeName', name='uint32'),
+        ),
+        n('MemberAccess', expression=ident('msg'), memberName='sig'),
+    )
+    checks = [binary('==', ident('#selector'), ident(k)) for k in (k1, k2, k3)]
+    delegate = n('MemberAccess', expression=ident(target), memberName='delegatecall')
+    invoke = call(
+        n(
+            'FunctionCallOptions',
+            expression=delegate,
+            names=['gas'],
+            options=[call(ident('gasleft'))],
+        ),
+        ident('#input'),
+    )
+    body[-1:] = [
+        n(
+            'VariableDeclarationStatement',
+            declarations=[variable('#selector')],
+            initialValue=sig,
+        ),
+        n(
+            'ExpressionStatement',
+            expression=call(
+                ident('require'),
+                binary('||', binary('||', checks[0], checks[1]), checks[2]),
+            ),
+        ),
+        n(
+            'VariableDeclarationStatement',
+            declarations=[local('#ok', 'bool'), local('#ret', 'bytes', 'memory')],
+            initialValue=invoke,
+        ),
+        n(
+            'IfStatement',
+            condition=n(
+                'UnaryOperation', operator='!', prefix=True, subExpression=ident('#ok')
+            ),
+            trueBody=n(
+                'RevertStatement', errorCall=call(ident('#yul.rethrow'), ident('#ret'))
+            ),
+        ),
+        n('Return', expression=ident('#ret')),
+    ]
+    return True
+
+
+def lower_assembly(ast):
+    from scratch_frame import account_for_scratch
+    from word_buffer import lower_word_buffers
+
+    ast = deepcopy(ast)
+    lower_word_buffers(ast)
+    for fn in walk(ast):
+        if fn.get('nodeType') == 'FunctionDefinition':
+            overwrite_modexp_result(fn)
+    referenced = {
+        v['referencedDeclaration'] for v in walk(ast) if 'referencedDeclaration' in v
+    }
+    decls = {
+        v['id']: v
+        for v in walk(ast)
+        if v.get('nodeType') == 'VariableDeclaration' and 'id' in v
+    }
+    structs = {v['id']: v for v in walk(ast) if v.get('nodeType') == 'StructDefinition'}
+    scalars = {
+        b['id']: replacement
+        for b in walk(ast)
+        if b.get('nodeType') == 'InlineAssembly'
+        and (replacement := scalar_modexp(b, decls)) is not None
+    }
+    initialized_scratch = account_for_scratch(
+        ast, scalars
+    ) | scratch_from_internal_caller(ast)
+    for contract in ast['nodes']:
+        intrinsics = set()
+
+        def preceding_literal(stmt):
+            if (
+                not isinstance(stmt, dict)
+                or stmt.get('nodeType') != 'VariableDeclarationStatement'
+            ):
+                return {}
+            declared = stmt.get('declarations', [])
+            value = stmt.get('initialValue') or {}
+            if (
+                len(declared) != 1
+                or not declared[0]
+                or 'id' not in declared[0]
+                or declared[0].get('typeName', {}).get('name') != 'uint256'
+            ):
+                return {}
+            if value.get('nodeType') in ('Identifier', 'MemberAccess'):
+                constant = decls.get(value.get('referencedDeclaration'), {})
+                if not constant.get('constant'):
+                    return {}
+                value = constant.get('value') or {}
+            if value.get('kind') != 'number' or value.get('subdenomination'):
+                return {}
+            try:
+                return {declared[0]['id']: int(value['value'], 0)}
+            except ValueError:
+                return {}
+
+        def rewrite(node, unchecked=False, known_lengths=None, fresh_array=False):
+            if isinstance(node, list):
+                intrinsics.update(load_code_tails(node, decls))
+                split_fresh_bytes(node)
+                compact_fresh_bytes(node)
+                previous = {}
+                for child in node:
+                    rewrite(child, unchecked, previous, fresh_array)
+                    previous = preceding_literal(child)
+            elif isinstance(node, dict):
+                if node.get('nodeType') == 'FunctionDefinition':
+                    fresh_array = fresh_array_revert_tail(node, referenced)
+                    if guarded_delegate_fallback(node, decls):
+                        intrinsics.add('#yul.rethrow')
+                if node.get('nodeType') == 'InlineAssembly':
+                    if node.get('id') in scalars and node['id'] in initialized_scratch:
+                        replacement = scalars[node['id']]
+                        node.clear()
+                        node.update(replacement)
+                        return
+                    replacement, names = lower_block(
+                        node,
+                        decls,
+                        known_lengths or {},
+                        structs,
+                        fresh_array,
+                        node.get('id') in initialized_scratch,
+                    )
+                    intrinsics.update(names)
+                    if unchecked and replacement['nodeType'] == 'UncheckedBlock':
+                        replacement['nodeType'] = 'Block'
+                    node.clear()
+                    node.update(replacement)
+                    return
+                unchecked = unchecked or node.get('nodeType') == 'UncheckedBlock'
+                try:
+                    for value in node.values():
+                        rewrite(value, unchecked, fresh_array=fresh_array)
+                except Unsupported as exc:
+                    if node.get('nodeType') == 'FunctionDefinition':
+                        owner = contract.get('name', '<file>')
+                        name = node.get('name') or node.get('kind')
+                        raise Unsupported(f'{owner}.{name}: {exc}') from exc
+                    raise
+
+        rewrite(contract)
+        for name in sorted(intrinsics):
+            if contract.get('nodeType') != 'ContractDefinition':
+                raise Unsupported('assembly intrinsic outside contract')
+            param = variable('code')
+            if name == '#yul.rethrow':
+                param.update(
+                    name='data',
+                    typeName=n('ElementaryTypeName', name='bytes'),
+                    storageLocation='default',
+                )
+            contract['nodes'].append(
+                n(
+                    'ErrorDefinition',
+                    name=name,
+                    parameters=n(
+                        'ParameterList',
+                        parameters=[]
+                        if name in ('#yul.copyOutOfGas', '#yul.invalid')
+                        else [param],
+                    ),
+                )
+            )
+    return ast
