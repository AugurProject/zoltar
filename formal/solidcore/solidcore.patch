index 0000000000000000000000000000000000000000..803d4bd26c95bd109594fde103f8cb664cf86762
--- /dev/null
+++ b/prototypes/mul512/Proof.lean.in
@@ -0,0 +1,48 @@
+-- Recover the high limb from residues modulo w and w-1.
+private theorem recover (w p : Nat) (positive : 1 < w) (bound : p ≤ (w-1)*(w-1)) :
+    let low := p%w
+    let mm := p%(w-1)
+    ((mm+w-low)%w + w - (if mm < low then 1 else 0)) % w = p/w := by
+  let q := p/w
+  let l := p%w
+  let mm := p%(w-1)
+  have decomp : w*q+l = p := Nat.div_add_mod p w
+  have low : l < w := Nat.mod_lt _ (by omega)
+  have high : q < w-1 := by
+    apply (Nat.div_lt_iff_lt_mul (by omega : 0 < w)).mpr
+    exact Nat.lt_of_le_of_lt bound (Nat.mul_lt_mul_of_pos_left (by omega) (by omega))
+  have modEq : mm = (q+l)%(w-1) := by
+    change p%(w-1) = _
+    have decomp' : p = q+l + q*(w-1) := by
+      rw [Nat.mul_comm q (w-1), Nat.sub_mul, Nat.one_mul]
+      have le : q ≤ w*q := by simpa using Nat.mul_le_mul_right q (show 1 ≤ w by omega)
+      omega
+    rw [decomp', Nat.mul_comm q (w-1), Nat.add_mul_mod_self_left]
+  change ((mm + w - l) % w + w - (if mm < l then 1 else 0)) % w = q
+  by_cases small : q+l < w-1
+  · rw [Nat.mod_eq_of_lt small] at modEq
+    have ge : ¬mm < l := by rw [modEq]; exact Nat.not_lt.mpr (Nat.le_add_left l q)
+    rw [if_neg ge]
+    have h : mm+w-l = q+w := by omega
+    rw [h]
+    simp [Nat.mod_eq_of_lt (by omega : q < w)]
+  · have small' : q+l-(w-1) < w-1 := by omega
+    rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt small'] at modEq
+    have lt : mm < l := by omega
+    rw [if_pos lt]
+    have h : mm+w-l = q+1 := by omega
+    rw [h, Nat.mod_eq_of_lt (by omega : q+1 < w)]
+    have h' : q+1+w-1 = q+w := by omega
+    rw [h']
+    simp [Nat.mod_eq_of_lt (by omega : q < w)]
+
+private theorem exactAt (w a b : Nat) (large : 1 < w) (ha : a < w) (hb : b < w) :
+    blockResultAt w a b = (a*b / w, a*b % w) := by
+  have bound : a*b ≤ (w-1)*(w-1) := Nat.mul_le_mul (by omega) (by omega)
+  have nonzero : w-1 ≠ 0 := by omega
+  simp [blockResultAt, imported, run, Term.eval, nonzero]
+  exact recover w (a*b) large bound
+
+theorem exactLimbs (a b : Nat) (ha : a < modulus) (hb : b < modulus) :
+    blockResultAt modulus a b = (a*b / modulus, a*b % modulus) :=
+  exactAt modulus a b (by decide) ha hb
diff --git a/prototypes/mul512/WordBlock.lean b/prototypes/mul512/WordBlock.lean
new file mode 100644
index 0000000000000000000000000000000000000000..b996fb295ca3b788fdcfd2df04eb7f9650e4ec76
--- /dev/null
+++ b/prototypes/mul512/WordBlock.lean
@@ -0,0 +1,60 @@
+import SolidCore.Solidity.Checked
+
+/-! Straight-line, side-effect-free Yul word expressions. Reads and writes cross
+the Solidity boundary only for checked uint256 locals. No memory or world state. -/
+namespace SolidCore.Solidity.WordBlock
+
+inductive Term where
+  | lit (n : Nat)
+  | var (name : String)
+  | mul (a b : Term)
+  | sub (a b : Term)
+  | lt (a b : Term)
+  | not (a : Term)
+  | mulmod (a b m : Term)
+  deriving Repr
+
+inductive Step where
+  | declare (name : String) (rhs : Term)
+  | assign (name : String) (rhs : Term)
+  deriving Repr
+
+def modulus : Nat := 2^256
+
+def Term.eval (w : Nat) (env : String → Nat) : Term → Nat
+  | .lit n => n % w
+  | .var name => env name
+  | .mul a b => (a.eval w env * b.eval w env) % w
+  | .sub a b => (a.eval w env + w - b.eval w env) % w
+  | .lt a b => if a.eval w env < b.eval w env then 1 else 0
+  | .not a => w - 1 - a.eval w env
+  | .mulmod a b m =>
+    let v := m.eval w env
+    if v = 0 then 0 else (a.eval w env * b.eval w env) % v
+
+def run (w : Nat) (steps : List Step) (env : String → Nat) : String → Nat :=
+  steps.foldl (fun state step => match step with
+    | .declare name rhs | .assign name rhs =>
+      fun key => if key = name then rhs.eval w state else state key) env
+
+private def uintLit (n : Nat) : Expr :=
+  .call (.typeName (.uint 256)) [.positional (.literal (.number (toString n)))]
+
+def Term.toExpr : Term → Expr
+  | .lit n => uintLit n
+  | .var name => .ident name
+  | .mul a b => .binary .mul a.toExpr b.toExpr
+  | .sub a b => .binary .sub a.toExpr b.toExpr
+  | .lt a b => .ternary (.binary .lt a.toExpr b.toExpr) (uintLit 1) (uintLit 0)
+  | .not a => .unary .bitNot a.toExpr
+  | .mulmod a b m =>
+    -- EVM MULMOD returns zero for modulus zero; Solidity's builtin can revert.
+    .ternary (.binary .eq m.toExpr (uintLit 0)) (uintLit 0)
+      (.call (.ident "mulmod") [.positional a.toExpr, .positional b.toExpr, .positional m.toExpr])
+
+def lower (steps : List Step) : Stmt :=
+  .unchecked (.block (steps.map fun step => match step with
+    | .declare name rhs => .varDecl [{name := some name, ty := some (.uint 256)}] (some rhs.toExpr)
+    | .assign name rhs => .expr (.assign (.ident name) .assign rhs.toExpr)))
+
+end SolidCore.Solidity.WordBlock
