+"""Replay SafeERC20's bounded CALL with explicitly initialized EVM scratch bytes."""
+
+import argparse
+import ast
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import Unsupported, lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+
+
+def run(repo, compiler, anvil):
+    path = (
+        repo
+        / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol'
+    )
+
+    # Isolate the verbatim assembly block from this repository's vendored helper.
+    def assembly_block(method):
+        source = path.read_text().split(f'function {method}(', 1)[1]
+        start = source.index('assembly')
+        return source[start : source.index('\n\t\t}', start) + 4]
+
+    block = assembly_block('_callOptionalReturnBool')
+    wrapper = (
+        """pragma solidity 0.8.35; interface IERC20 {}
+contract Scratch {
+    function probe(IERC20 token,bytes memory data,uint prior) external returns(bool success,uint returnSize,uint returnValue) {
+"""
+        + block
+        + '\n}}'
+    )
+    outputs = {
+        '*': {
+            '': ['ast'],
+            'Scratch': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+        }
+    }
+    unit = compile_solc(
+        compiler,
+        {
+            'S.sol': wrapper.replace(
+                'function probe(', 'uint[] words; function probe(', 1
+            ).replace(
+                "assembly ('memory-safe') {",
+                "words.push(prior); assembly ('memory-safe') {",
+                1,
+            )
+        },
+        outputs,
+    )
+    try:
+        lower_assembly(unit['sources']['S.sol']['ast'])
+    except Unsupported as exc:
+        if 'memory before the assembly block' not in str(exc):
+            raise
+    else:
+        raise AssertionError('accepted an untracked scratch word')
+    wrapper = wrapper.replace(
+        "assembly ('memory-safe') {", "assembly ('memory-safe') { mstore(0,prior)"
+    )
+    helper = (
+        """
+    function inherited(IERC20 token,bytes memory data,uint prior) external returns(bool,uint,uint) {
+        assembly ("memory-safe"){mstore(0,prior)}
+        return inner(token,data);
+    }
+    function inner(IERC20 token,bytes memory data) private returns(bool success,uint returnSize,uint returnValue) {
+"""
+        + block
+        + '\n}'
+    )
+    strict = (
+        """
+    mapping(uint=>uint) private history;
+    function mapped(IERC20 token,bytes memory data,uint prior) external returns(bool,uint,uint) {
+        history[prior]=7;
+        return inner(token,data);
+    }
+    function bubbling(IERC20 token,bytes memory data,uint prior) external returns(bool,uint,uint) {
+        assembly ("memory-safe"){mstore(0,prior)}
+        return checked(token,data);
+    }
+    function checked(IERC20 token,bytes memory data) private returns(bool,uint,uint) {
+        uint returnSize; uint returnValue;
+"""
+        + assembly_block('_callOptionalReturn')
+        + '\nreturn(true,returnSize,returnValue);}'
+    )
+    wrapper = wrapper[:-1] + helper + strict + '\n}'
+    unsafe = (
+        wrapper[:-1]
+        + 'uint[] words; function unknown(IERC20 t,bytes memory b) external returns(bool,uint,uint){words.push(7);return inner(t,b);}}'
+    )
+    try:
+        lower_assembly(
+            compile_solc(compiler, {'S.sol': unsafe}, outputs)['sources']['S.sol'][
+                'ast'
+            ]
+        )
+    except Unsupported as exc:
+        if 'memory before the assembly block' not in str(exc):
+            raise
+    else:
+        raise AssertionError('untracked second caller reached the scratch read')
+    unit = compile_solc(compiler, {'S.sol': wrapper}, outputs)
+    model = importer.render_module(
+        lower_assembly(unit['sources']['S.sol']['ast']),
+        'S.sol',
+        'Scratch',
+        'SolidCore.Solidity.ScratchCall',
+        True,
+    )
+    evm = unit['contracts']['S.sol']['Scratch']['evm']
+    addr, token = [f'0x{i:040x}' for i in [4096, 8192]]
+
+    def word(n):
+        return n.to_bytes(32, 'big')
+
+    payload = b'\xa1\xb2'
+    rows = []
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for ok in [True, False]:
+            for size in [0, 1, 31, 32, 33]:
+                # Return the requested prefix of 32 ff bytes followed by a zero.
+                code = (
+                    '0x60001960005260' + f'{size:02x}' + '6000' + ('f3' if ok else 'fd')
+                )
+                replay.rpc(url, 'anvil_setCode', [token, code])
+                reply = (bytes([255]) * 32 + b'\0')[:size]
+                for prior in [0, 1, 2**255 + 19]:
+                    for method in ('probe', 'inherited', 'bubbling', 'mapped'):
+                        data = (
+                            bytes.fromhex(
+                                evm['methodIdentifiers'][
+                                    f'{method}(address,bytes,uint256)'
+                                ]
+                            )
+                            + word(8192)
+                            + word(96)
+                            + word(prior)
+                            + word(2)
+                            + payload.ljust(32, b'\0')
+                        )
+                        try:
+                            out = bytes.fromhex(
+                                replay.rpc(
+                                    url,
+                                    'eth_call',
+                                    [{'to': addr, 'data': '0x' + data.hex()}, 'latest'],
+                                )[2:]
+                            )
+                        except RuntimeError as exc:
+                            if (
+                                ok
+                                or method != 'bubbling'
+                                or ast.literal_eval(str(exc)).get('data')
+                                != '0x' + reply.hex()
+                            ):
+                                raise
+                            out = None
+                        want = int.from_bytes(
+                            reply[:32] + word(prior)[len(reply[:32]) :], 'big'
+                        )
+                        if out != (
+                            None
+                            if method == 'bubbling' and not ok
+                            else word(ok) + word(size) + word(want)
+                        ):
+                            raise AssertionError((method, ok, size, prior, out))
+                        rows.append(
+                            f'("{method}",{prior},{str(ok).lower()},{list(reply)},{want})'
+                        )
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Scratch.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract ScratchCall.importedSourceUnit "Scratch" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (method,prior,ok,output,want) in (["""
+            + ',\n'.join(rows)
+            + """] : List (String × Nat × Bool × List Nat × Nat)) do
+    let some tree := Source.ABI.Contract.callWithSelfDispatch 20000 c.core (.name method) Source.State.empty [.word 8192,.bytes [161,178],.word prior] | throw (IO.userError "missing function")
+    let .request (.resource .gas) k := tree | throw (IO.userError "missing CALL gas query")
+    let responder := Source.responderOfResults [{kind := .call,target := 8192,calldata := [161,178],gas? := some 50000,success := ok,output}] []
+    match Source.SolI.runWith responder (k (Source.wordToU256 50000)) with
+    | .ok (.returned _ [.word s,.word size,.word v]) =>
+      unless (!(method == "bubbling") || ok) && (s == (if ok then 1 else 0)) && size == output.length && v == want do throw (IO.userError s!"wrong prefix {size}, {v}")
+    | .ok (.reverted _ why) =>
+      unless method == "bubbling" && !ok && Source.ABI.Contract.encodeRevertData? c.core why == some output do throw (IO.userError s!"wrong bubble {repr why}")
+    | _ => throw (IO.userError "wrong call or result")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(rows)} bounded SafeERC20 CALL results matched Anvil')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('repo', type=Path)
+    parser.add_argument('--solc', required=True)
+    parser.add_argument('--anvil', required=True)
+    args = parser.parse_args()
+    run(args.repo, args.solc, args.anvil)
diff --git a/prototypes/source/scratch_frame.py b/prototypes/source/scratch_frame.py
new file mode 100644
index 0000000000000000000000000000000000000000..bcc3d21cd774dab81c038020360dd4ef7985d50d
--- /dev/null
+++ b/prototypes/source/scratch_frame.py
@@ -0,0 +1,207 @@
+"""Account for first-word scratch effects in a connected Solidity call frame."""
+
+import re
+
+from assembly import call, ident, n, walk, yul_expr
+
+
+def bounded_reader(block):
+    ops = block['AST']['statements']
+    # The assembly lowerer independently checks all operand bindings, the
+    # input and output windows and the optional returndata-forwarding exit.
+    return (
+        len(ops) in (3, 4)
+        and ops[0].get('value', {}).get('functionName', {}).get('name') == 'call'
+        and (len(ops) == 3 or ops[1].get('nodeType') == 'YulIf')
+        and all(op.get('nodeType') == 'YulAssignment' for op in ops[-2:])
+        and [yul_expr(op['value']) for op in ops[-2:]]
+        == [('returndatasize',), ('mload', 0)]
+    )
+
+
+def tracks_scratch(block):
+    ops = block['AST']['statements']
+    if (
+        ops
+        and ops[-1].get('expression', {}).get('functionName', {}).get('name')
+        == 'revert'
+    ):
+        return True
+    if len(ops) == 1 and ops[0].get('nodeType') == 'YulExpressionStatement':
+        op = ops[0]['expression']
+        if (
+            op.get('functionName', {}).get('name') in ('mstore', 'mstore8')
+            and len(op['arguments']) == 2
+        ):
+            where, value = op['arguments']
+            if where.get('kind') == 'number' and value.get('nodeType') in (
+                'YulIdentifier',
+                'YulLiteral',
+            ):
+                return (
+                    0
+                    <= int(where['value'], 0)
+                    <= (32 if op['functionName']['name'] == 'mstore' else 63)
+                )
+    arithmetic = {
+        'add',
+        'sub',
+        'mul',
+        'div',
+        'mod',
+        'mulmod',
+        'addmod',
+        'and',
+        'or',
+        'xor',
+        'not',
+        'iszero',
+        'lt',
+        'gt',
+        'eq',
+        'shl',
+        'shr',
+        'byte',
+    }
+    return all(
+        op.get('functionName', {}).get('name') in arithmetic
+        for op in walk(ops)
+        if op.get('nodeType') == 'YulFunctionCall'
+    )
+
+
+def account_for_scratch(ast, scalar_calls):
+    # File-level function bodies can connect otherwise separate contract
+    # components. Until they are represented as vertices, decline that case.
+    if any(node.get('nodeType') == 'FunctionDefinition' for node in ast['nodes']):
+        return set()
+    scopes = {
+        c['id']: c for c in ast['nodes'] if c.get('nodeType') == 'ContractDefinition'
+    }
+    owner = {
+        member['id']: key
+        for key, c in scopes.items()
+        for member in c['nodes']
+        if 'id' in member
+    }
+    connected = {key: set() for key in scopes}
+    uncertain = set()
+    readers = {}
+    for key, c in scopes.items():
+        # Internal library calls, inheritance, and modifiers share memory.
+        # External calls and contract creation start new EVM memory frames.
+        targets = {
+            b['baseName'].get('referencedDeclaration')
+            for b in c.get('baseContracts', [])
+        }
+        for node in walk(c):
+            kind = node.get('nodeType')
+            ty = node.get('typeDescriptions', {}).get('typeIdentifier', '')
+            if kind == 'InlineAssembly':
+                if node['id'] in scalar_calls or bounded_reader(node):
+                    readers.setdefault(key, set()).add(node['id'])
+                elif not tracks_scratch(node):
+                    uncertain.add(key)
+            if kind == 'ModifierInvocation':
+                targets.add(
+                    owner.get(node['modifierName'].get('referencedDeclaration'))
+                )
+            if kind in ('MemberAccess', 'Identifier') and ty.startswith(
+                't_function_internal_'
+            ):
+                ref = node.get('referencedDeclaration')
+                if ref in owner:
+                    targets.add(owner[ref])
+                else:
+                    uncertain.add(key)
+            if kind == 'FunctionTypeName' or (
+                kind == 'VariableDeclaration' and ty.startswith('t_function_internal')
+            ):
+                uncertain.add(key)
+            # Hashing a dynamic storage location can write a different word
+            # at offset zero. It needs its own effect before joining this set.
+            if kind == 'VariableDeclaration' and (
+                node.get('stateVariable') or node.get('storageLocation') == 'storage'
+            ):
+                if any(
+                    t in ty for t in ('t_array', 't_bytes_storage', 't_string_storage')
+                ):
+                    uncertain.add(key)
+            if (
+                kind == 'VariableDeclaration'
+                and node.get('scope') in owner
+                and (
+                    't_array' in ty
+                    or ty.startswith(('t_bytes_storage', 't_string_storage'))
+                )
+                and '_storage' in ty
+            ):
+                uncertain.add(key)
+            if kind == 'FunctionCall':
+                target = (
+                    node['expression']
+                    .get('typeDescriptions', {})
+                    .get('typeIdentifier', '')
+                )
+                if target.startswith(
+                    (
+                        't_function_ecrecover',
+                        't_function_sha256',
+                        't_function_ripemd160',
+                    )
+                ):
+                    uncertain.add(key)
+        for other in targets:
+            if other not in scopes:
+                uncertain.add(key)
+                continue
+            connected[key].add(other)
+            connected[other].add(key)
+    done = set()
+    certified = set()
+    for scope in readers:
+        if scope in done:
+            continue
+        component = {scope}
+        pending = [scope]
+        while pending:
+            extra = connected[pending.pop()] - component
+            component.update(extra)
+            pending.extend(extra)
+        done.update(component)
+        if component & uncertain:
+            continue
+        edits = []
+        for key in component:
+            for node in walk(scopes[key]):
+                if node.get('nodeType') != 'IndexAccess':
+                    continue
+                ty = (
+                    node['baseExpression']
+                    .get('typeDescriptions', {})
+                    .get('typeIdentifier', '')
+                )
+                if not ty.startswith('t_mapping'):
+                    continue
+                match = re.match(r't_mapping\$_t_(address|uint(?:[0-9]+))_\$_', ty)
+                if not match:
+                    break
+                edits.append((node, match.group(1)))
+            else:
+                continue
+            break
+        else:
+            # Convert to the mapping's declared key width before encoding.
+            # The marker returns that same value, evaluating the key once.
+            for node, key_ty in edits:
+                key_expr = call(
+                    n(
+                        'ElementaryTypeNameExpression',
+                        typeName=n('ElementaryTypeName', name=key_ty),
+                    ),
+                    node['indexExpression'],
+                )
+                node['indexExpression'] = call(ident('#yul.mappingKey'), key_expr)
+            for key in component:
+                certified.update(readers.get(key, ()))
+    return certified
