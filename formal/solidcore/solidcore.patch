@@ -0,0 +1,214 @@
+"""Run OpenOracle's original copy, overlay, compaction and LOG2 blocks on both profiles."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+from assembly import Unsupported, lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, fork, anvil):
+    path = 'solidity/contracts/statoblast/openOracle/OpenOracle.sol'
+    src = (repo / path).read_text()
+
+    def span(start, end, text=src):
+        i = text.index(start)
+        return text[i : text.index(end, i)]
+
+    def layout(name):
+        return span('struct ' + name + ' {', '}') + '}'
+
+    report = src.split('function report(', 1)[1]
+    initial = span('bytes32 stateHash;', 'oracleGame[reportId] = stateHash', report)
+    dispute = src.split('function dispute(', 1)[1]
+    copy = span('OracleGame memory oracle;', 'if (preStateHash', dispute)
+    pack = src[src.index('function _packMem(') :].rsplit('}', 1)[0]
+    body = (
+        'pragma solidity ^0.8.20; contract P{'
+        + layout('OracleGame')
+        + layout('PreimageHelper')
+        + pack
+        + """
+function submit(OracleGame calldata params,bool trackDisputes) external returns(bytes32) {
+    uint reportId=77;uint48 reportTimestamp=103;uint48 oppoTime=104;
+    uint128 escalationHalt=params.escalationHalt; address callbackContract=params.callbackContract; uint32 callbackGasLimit=params.callbackGasLimit;
+    PreimageHelper memory helper=PreimageHelper(reportId,address(37),123,456);
+"""
+        + initial
+        + """
+    uint256 packedLen=_packMem(stagedMem); bytes32 sig=bytes32(uint(12345));
+    assembly ("memory-safe"){log2(stagedMem,packedLen,sig,reportId)}
+    return stateHash;
+}
+function revise(OracleGame calldata params,PreimageHelper calldata helper) external returns(bytes32) {
+    uint reportId=77;
+"""
+        + copy
+        + """
+    oracle.settlementTimestamp=777;
+    bytes32 nextStateHash;
+    assembly ("memory-safe"){nextStateHash:=keccak256(stagedMem,0x300)}
+    uint256 packedLen=_packMem(stagedMem); bytes32 sig=bytes32(uint(34567));
+    assembly ("memory-safe"){log2(stagedMem,packedLen,sig,reportId)}
+    return nextStateHash;
+}}"""
+    )
+    outputs = {
+        '*': {
+            '': ['ast'],
+            'P': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+        }
+    }
+    result = compile_solc(compiler, {'P.sol': body}, outputs, evm_version=fork)
+    ast = result['sources']['P.sol']['ast']
+    unit = lower_assembly(project(ast, 'P'))
+    model = importer.render_module(
+        unit,
+        path,
+        'P',
+        'SolidCore.Solidity.PackOracle',
+        True,
+        analyzed_solc_028=fork == 'cancun',
+    )
+    for alt in [
+        body.replace(
+            'return stateHash;', 'return bytes32(uint(staged.currentAmount1));'
+        ),
+        body[:-1]
+        + 'function other(uint p) external pure returns(uint){return _packMem(p);}}',
+    ]:
+        try:
+            lower_assembly(
+                project(
+                    compile_solc(
+                        compiler, {'P.sol': alt}, {'*': {'': ['ast']}}, evm_version=fork
+                    )['sources']['P.sol']['ast'],
+                    'P',
+                )
+            )
+        except Unsupported:
+            pass
+        else:
+            raise AssertionError('escaped packed memory region')
+    evm = result['contracts']['P.sol']['P']['evm']
+    addr = '0x' + '7a' * 20
+
+    def word(n):
+        return n.to_bytes(32, 'big')
+
+    sizes = [16, 16, 20, 6, 6, 20, 6, 6, 16, 20, 12, 20, 3, 3, 3, 2, 20, 4, 3, 1]
+    rows = []
+    with replay.local_chain(anvil, fork) as url:
+        sender = replay.rpc(url, 'eth_accounts', [])[0]
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for method, sel in evm['methodIdentifiers'].items():
+            submit = method.startswith('submit')
+            for variant in range(4):
+                words = [(1 << (8 * size)) - 1 - i for i, size in enumerate(sizes)]
+                tail = [77, 37, 123, 456]
+                if variant & 2:
+                    for i in [1, 3, 4, 6, 12, 19]:
+                        words[i] |= 1 << 250
+                    if not submit:
+                        tail = [2**252 + 77, 2**251 + 37, 2**83 + 123, 2**81 + 456]
+                calldata = bytes.fromhex(sel) + b''.join(
+                    map(word, words + ([variant & 1] if submit else tail))
+                )
+                if submit:
+                    words[3] = 103
+                    words[6] = 104
+                    if variant & 1:
+                        words[12] = 1
+                else:
+                    words[4] = 777
+                topic = 12345 if submit else 34567
+                digest = replay.rpc(
+                    url, 'web3_sha3', ['0x' + b''.join(map(word, words + tail)).hex()]
+                )
+                req = {
+                    'from': sender,
+                    'to': addr,
+                    'data': '0x' + calldata.hex(),
+                    'gas': '0x500000',
+                }
+                out = replay.rpc(url, 'eth_call', [req, 'latest'])
+                tx = replay.rpc(url, 'eth_sendTransaction', [req])
+                for _ in range(100):
+                    receipt = replay.rpc(url, 'eth_getTransactionReceipt', [tx])
+                    if receipt:
+                        break
+                    time.sleep(0.05)
+                expected = b''.join(
+                    word(v)[-w:] for v, w in zip(words + tail[1:], sizes + [20, 6, 6])
+                )
+                if (
+                    not receipt
+                    or int(receipt['status'], 16) != 1
+                    or len(receipt['logs']) != 1
+                    or out != digest
+                ):
+                    raise AssertionError((method, variant, receipt, out, digest))
+                event = receipt['logs'][0]
+                if (
+                    event['data'] != '0x' + expected.hex()
+                    or list(map(lambda v: int(v, 16), event['topics'])) != [topic, 77]
+                    or len(expected) != 235
+                ):
+                    raise AssertionError(event)
+                rows.append(
+                    f'({list(calldata)},{list(bytes.fromhex(out[2:]))},{topic},{list(expected)})'
+                )
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Pack.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract PackOracle.importedSourceUnit "P" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (input,output,topic,payload) in (["""
+            + ',\n'.join(rows)
+            + """] : List (List Nat × List Nat × Nat × List Nat)) do
+    let some r := TypeCheck.CheckedContract.callCalldata? 200000 c Source.State.empty input | throw (IO.userError "missing dispatch")
+    unless r.success && r.output == output do throw (IO.userError s!"bad packed hash {r.success} {r.output}")
+    let [event] := r.state.events | throw (IO.userError "expected one log")
+    unless event.topics == [topic,77] && event.dataBytes == payload do throw (IO.userError "bad raw LOG2")
+"""
+        )
+        subprocess.run(
+            [
+                'lake',
+                'env',
+                'lean',
+                '-s',
+                '131072',
+                '-DmaxRecDepth=32768',
+                '--run',
+                script,
+            ],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'{len(rows)} OpenOracle hashes, 235-byte events and topic pairs matched Anvil ({fork})'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--oracle-solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, 'osaka', args.anvil)
+    run(args.repo, args.oracle_solc, 'cancun', args.anvil)
