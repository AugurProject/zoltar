--- /dev/null
+++ b/prototypes/source/multicall.py
@@ -0,0 +1,197 @@
+"""Compare aggregate3's raw failure flag and byte-exact revert with the original contract."""
+
+import argparse
+import ast
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import Unsupported, lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    path = 'solidity/contracts/statoblast/Multicall3.sol'
+    source = (repo / path).read_text()
+    result = compile_solc(
+        compiler,
+        {'M.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                'Multicall3': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    root = result['sources']['M.sol']['ast']
+    model = importer.render_module(
+        lower_assembly(project(root, 'Multicall3')),
+        path,
+        'Multicall3',
+        'SolidCore.Solidity.Multi',
+        True,
+    )
+    evm = result['contracts']['M.sol']['Multicall3']['evm']
+    addr, callee = [f'0x{i:040x}' for i in (4096, 8192)]
+
+    def word(n):
+        return n.to_bytes(32, 'big')
+
+    rows = []
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for success in (False, True):
+            # CALL succeeds or reverts with the same deliberately non-ABI two bytes.
+            replay.rpc(
+                url,
+                'anvil_setCode',
+                [callee, '0x61abcd6000526002601e' + ('f3' if success else 'fd')],
+            )
+            for method in (
+                'aggregate3((address,bool,bytes)[])',
+                'aggregate3Value((address,bool,uint256,bytes)[])',
+            ):
+                selector = bytes.fromhex(evm['methodIdentifiers'][method])
+                with_value = method.startswith('aggregate3Value')
+                for allow in (0, 1, 2, 2**256 - 1):
+                    data = (
+                        selector
+                        + word(32)
+                        + word(1)
+                        + word(32)
+                        + word(8192)
+                        + word(allow)
+                        + (word(0) if with_value else b'')
+                        + word(128 if with_value else 96)
+                        + word(0)
+                    )
+                    try:
+                        out = bytes.fromhex(
+                            replay.rpc(
+                                url,
+                                'eth_call',
+                                [{'to': addr, 'data': '0x' + data.hex()}, 'latest'],
+                            )[2:]
+                        )
+                    except RuntimeError as ex:
+                        if success or allow:
+                            raise
+                        out = bytes.fromhex(ast.literal_eval(str(ex))['data'][2:])
+                        expected = (
+                            bytes.fromhex('08c379a0')
+                            + word(32)
+                            + word(23)
+                            + b'Multicall3: call failed'.ljust(32, b'\0')
+                            + (bytes(32) if with_value else b'')
+                        )
+                        if out != expected:
+                            raise AssertionError(out)
+                    else:
+                        expected = (
+                            word(32)
+                            + word(1)
+                            + word(32)
+                            + word(success)
+                            + word(64)
+                            + word(2)
+                            + bytes.fromhex('abcd')
+                            + bytes(30)
+                        )
+                        if not (success or allow) or out != expected:
+                            raise AssertionError(out)
+                    rows.append(
+                        f'({list(data)},{str(success).lower()},{str(bool(success or allow)).lower()},{list(out)})'
+                    )
+    # An internal caller can reserve the first heap word before entering
+    # aggregate3Value. The upper four bytes then survive its 132-byte REVERT.
+    # Such a frame must be rejected until its complete memory is represented.
+    extra = """
+contract InternalFrame is Multicall3 {
+    function inherited(Call3Value[] calldata calls) external payable returns(Result[] memory) {
+        assembly { mstore(0x80,not(0)) mstore(0x40,0xa0) }
+        return aggregate3Value(calls);
+    }
+}
+"""
+    altered = compile_solc(
+        compiler,
+        {'M.sol': source + extra},
+        {
+            '*': {
+                '': ['ast'],
+                'InternalFrame': [
+                    'evm.deployedBytecode.object',
+                    'evm.methodIdentifiers',
+                ],
+            }
+        },
+    )
+    try:
+        lower_assembly(project(altered['sources']['M.sol']['ast'], 'InternalFrame'))
+    except Unsupported as exc:
+        if 'aggregate3Value' not in str(exc):
+            raise
+    else:
+        raise AssertionError('unexpected constant tail for an internal frame')
+    child = altered['contracts']['M.sol']['InternalFrame']['evm']
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + child['deployedBytecode']['object']]
+        )
+        replay.rpc(url, 'anvil_setCode', [callee, '0x60006000fd'])
+        method = 'inherited((address,bool,uint256,bytes)[])'
+        data = bytes.fromhex(child['methodIdentifiers'][method]) + b''.join(
+            map(word, (32, 1, 32, 8192, 0, 0, 128, 0))
+        )
+        try:
+            replay.rpc(
+                url, 'eth_call', [{'to': addr, 'data': '0x' + data.hex()}, 'latest']
+            )
+        except RuntimeError as exc:
+            payload = bytes.fromhex(ast.literal_eval(str(exc))['data'][2:])
+            if len(payload) != 132 or payload[100:] != bytes(28) + b'\xff' * 4:
+                raise AssertionError(payload)
+        else:
+            raise AssertionError('missing internal frame revert')
+    with tempfile.TemporaryDirectory() as tmp:
+        p = Path(tmp) / 'Multi.lean'
+        p.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Multi.importedSourceUnit "Multicall3" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (input,ok,success,want) in (["""
+            + ',\n'.join(rows)
+            + """] : List (List Nat × Bool × Bool × List Nat)) do
+    let some tree := Source.ABI.Contract.callCalldataAtFromWithContext 100000 c.core c.core.context Source.State.empty 4096 99 0 input | throw (IO.userError "no dispatch")
+    let row := Source.responderOfResults [{kind := .call,target := 8192,calldata := [],success := ok,output := [171,205]}] []
+    match Source.SolI.runWith row tree with
+    | .ok r =>
+      unless r.success == success && r.output == want do throw (IO.userError s!"wrong aggregate {ok}, {success}, {r.success}, {r.output}")
+    | .error _ => throw (IO.userError "unexpected call")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', p],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'{len(rows)} Multicall3 aggregate results and failure payloads matched Anvil'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, args.anvil)
