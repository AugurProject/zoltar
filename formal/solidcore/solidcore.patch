index 0000000000000000000000000000000000000000..584a8a4094bdca5879887f18957b3db294b382d7
--- /dev/null
+++ b/prototypes/source/discarded_bool.py
@@ -0,0 +1,148 @@
+"""Compare ABI validation of discarded external results with the installed solc."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(compiler, anvil, returns, offset, cases, try_call=False):
+    source = """
+pragma solidity 0.8.35;
+interface Token { struct Receipt { uint256 x; uint16 y; } function transfer(uint amount) external returns(RETURNS); }
+contract Probe {
+    function run(Token t) external { t.transfer(123); }
+}
+"""
+    source = source.replace('RETURNS', returns)
+    if try_call:
+        source = source.replace(
+            't.transfer(123);', 'try t.transfer(123) {} catch { revert("callee"); }'
+        )
+    unit = compile_solc(
+        compiler,
+        {'T.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                '*': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    evm = unit['contracts']['T.sol']['Probe']['evm']
+    selector = evm['methodIdentifiers']['run(address)']
+    transfer = unit['contracts']['T.sol']['Token']['evm']['methodIdentifiers'][
+        'transfer(uint256)'
+    ]
+    data = bytes.fromhex(selector) + (8192).to_bytes(32, 'big')
+    expected_call = bytes.fromhex(transfer) + (123).to_bytes(32, 'big')
+    model = importer.render_module(
+        project(unit['sources']['T.sol']['ast'], 'Probe'),
+        'T.sol',
+        'Probe',
+        'SolidCore.Solidity.DiscardedBool',
+        True,
+    )
+    caller, token = ('0x' + f'{v:040x}' for v in (4096, 8192))
+    rows = []
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [caller, '0x' + evm['deployedBytecode']['object']]
+        )
+        for size, word, want in cases:
+            # Return a prefix of memory containing this value in the chosen slot.
+            replay.rpc(
+                url,
+                'anvil_setCode',
+                [token, f'0x62{word:06x}60{offset:02x}5260{size:02x}6000f3'],
+            )
+            try:
+                out = replay.rpc(
+                    url,
+                    'eth_call',
+                    [{'to': caller, 'data': '0x' + data.hex()}, 'latest'],
+                )
+            except RuntimeError as exc:
+                if want or exc.args[0].get('data') != '0x':
+                    raise
+            else:
+                if not want or out != '0x':
+                    raise AssertionError((size, word, out))
+            raw = (bytes(offset) + word.to_bytes(32, 'big') + bytes(32))[:size]
+            rows.append(f'({list(raw)},{str(want).lower()})')
+    with tempfile.TemporaryDirectory() as tmp:
+        probe = Path(tmp) / 'Discarded.lean'
+        probe.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract DiscardedBool.importedSourceUnit "Probe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (ret,success) in (["""
+            + ','.join(rows)
+            + """] : List (List Nat × Bool)) do
+    let some tree := Source.ABI.Contract.callCalldataAtFromWithContext 20000 c.core c.core.context Source.State.empty 4096 99 0 """
+            + str(list(data))
+            + """ | throw (IO.userError "missing entry")
+    let row := Source.responderOfResults [{kind := .call, target := 8192, calldata := """
+            + str(list(expected_call))
+            + """, success := true, output := ret}] []
+    match Source.SolI.runWith row tree with
+    | .ok a => unless a.success == success && a.output.isEmpty do throw (IO.userError s!"wrong bool decode for {ret}")
+    | .error _ => throw (IO.userError "unexpected external request")
+"""
+        )
+        subprocess.run(['lake', 'env', 'lean', '--run', probe], cwd=ROOT, check=True)
+    path = 'try-call' if try_call else 'call'
+    print(f'{len(cases)} discarded ({returns}) {path} return payloads matched Anvil')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--solc', required=True)
+    parser.add_argument('--anvil', required=True)
+    args = parser.parse_args()
+    run(
+        args.solc,
+        args.anvil,
+        'bool',
+        0,
+        [
+            (0, 0, False),
+            (1, 1, False),
+            (32, 0, True),
+            (32, 1, True),
+            (32, 2, False),
+            (64, 1, True),
+        ],
+    )
+    for returns in ('uint256,uint16', 'Receipt memory'):
+        run(
+            args.solc,
+            args.anvil,
+            returns,
+            32,
+            [
+                (32, 1, False),
+                (63, 1, False),
+                (64, 1, True),
+                (64, 65535, True),
+                (64, 65536, False),
+                (65, 65536, False),
+            ],
+        )
+
+    run(
+        args.solc,
+        args.anvil,
+        'uint256',
+        0,
+        [(0, 0, False), (1, 1, False), (32, 7, True)],
+        try_call=True,
+    )
