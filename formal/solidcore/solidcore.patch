@@ -0,0 +1,100 @@
+"""Compare explicit constructor output with the deployed code of CreationCodeChunk."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    path = 'solidity/contracts/statoblast/CreationCodeStorage.sol'
+    result = compile_solc(
+        compiler,
+        {'Chunk.sol': (repo / path).read_text() + '\ncontract OrdinaryDeployment {}'},
+        {'*': {'': ['ast'], 'CreationCodeChunk': ['evm.bytecode.object']}},
+    )
+    source = lower_assembly(
+        project(result['sources']['Chunk.sol']['ast'], 'CreationCodeChunk')
+    )
+    model = importer.render_module(
+        source, path, 'CreationCodeChunk', 'SolidCore.Solidity.Chunk', True
+    )
+    ordinary = project(result['sources']['Chunk.sol']['ast'], 'OrdinaryDeployment')
+    model += importer.render_module(
+        ordinary, path, 'OrdinaryDeployment', 'SolidCore.Solidity.Ordinary', True
+    )
+    init = result['contracts']['Chunk.sol']['CreationCodeChunk']['evm']['bytecode'][
+        'object'
+    ]
+    values = [b'', bytes([0xFF]), bytes(range(32)), bytes(range(65))]
+    with replay.local_chain(anvil) as url:
+        sender = replay.rpc(url, 'eth_accounts', [])[0]
+        for value in values:
+            arguments = f'{32:064x}{len(value):064x}' + value.hex().ljust(
+                64 * ((len(value) + 31) // 32), '0'
+            )
+            tx = replay.rpc(
+                url,
+                'eth_sendTransaction',
+                [{'from': sender, 'data': '0x' + init + arguments, 'gas': '0x100000'}],
+            )
+            for _ in range(100):
+                receipt = replay.rpc(url, 'eth_getTransactionReceipt', [tx])
+                if receipt:
+                    break
+                time.sleep(0.05)
+            if not receipt or int(receipt['status'], 16) != 1:
+                raise AssertionError((tx, receipt))
+            got = replay.rpc(url, 'eth_getCode', [receipt['contractAddress'], 'latest'])
+            if got != '0x00' + value.hex():
+                raise AssertionError((value, got))
+    with tempfile.TemporaryDirectory() as directory:
+        script = Path(directory) / 'Chunk.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Chunk.importedSourceUnit "CreationCodeChunk" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  let ordinary ← match TypeCheck.CheckedInput.contract Ordinary.importedSourceUnit "OrdinaryDeployment" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  let seed := {Source.State.empty with constructorOutput? := some [42]}
+  match TypeCheck.CheckedContract.constructFrom? 10000 ordinary seed 1 0 [] with
+  | some (.returned state []) =>
+      unless state.constructorOutput?.isNone do throw (IO.userError "inherited stale constructor output")
+  | _ => throw (IO.userError "ordinary constructor failed")
+  match TypeCheck.CheckedContract.constructFrom? 10000 ordinary seed 1 1 [] with
+  | some (.reverted state _) =>
+      unless state.constructorOutput? == seed.constructorOutput? do throw (IO.userError "failed deployment changed its input state")
+  | _ => throw (IO.userError "nonpayable constructor accepted value")
+  for data in ("""
+            + str([list(v) for v in values])
+            + """ : List (List Nat)) do
+    match TypeCheck.CheckedContract.constructFrom? 10000 c Source.State.empty 1 0 [.bytes data] with
+    | some (.returned state []) =>
+        unless state.constructorOutput? == some (0 :: data) do throw (IO.userError "wrong constructor code")
+    | _ => throw (IO.userError "constructor returned no code")
+"""
+        )
+        subprocess.run(['lake', 'env', 'lean', '--run', script], cwd=ROOT, check=True)
+    print(
+        f'{len(values)} explicit constructor outputs matched the code deployed on Anvil'
+    )
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('zoltar', type=Path)
+    parser.add_argument('--solc', default='solc')
+    parser.add_argument('--anvil', default='anvil')
+    args = parser.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
