diff --git a/prototypes/mul512/Probe.lean.in b/prototypes/mul512/Probe.lean.in
new file mode 100644
index 0000000000000000000000000000000000000000..faa86ad46dc648014493a313276133283f489901
--- /dev/null
+++ b/prototypes/mul512/Probe.lean.in
@@ -0,0 +1,56 @@
+namespace SolidCore.Solidity.WordBlock.Probe
+
+def imported : List Step := __STEPS__
+
+def header : FunctionDecl :=
+__HEADER__
+
+-- Keep the imported function internal. Expose it through the same two-word ABI
+-- as the EVM probe, within this isolated single-contract SolidCore source unit.
+def entry : FunctionDecl :=
+  { header with
+    name := some "probe"
+    visibility := some .external_
+    returns := [{ty := .uint 256}, {ty := .uint 256}]
+    body := some (.returnValues (some (.call (.ident "mul512")
+      [.positional (.ident "a"), .positional (.ident "b")])) ) }
+
+def source : SourceUnit :=
+  {items := [.contract {kind := .contract, name := "Probe", items :=
+    [.function {header with body := some (lower imported)}, .function entry]}]}
+
+def checkedResult (contract : TypeCheck.CheckedContract) (a b : Nat) : Except String (Nat × Nat) := do
+  match TypeCheck.CheckedContract.callFunctionWithContext 5000 contract "probe"
+      Source.Context.empty Source.State.empty [.word a, .word b] with
+  | .ok (.returned _ [.word high, .word low]) => return (high, low)
+  | .ok (.returned _ vals) => throw s!"wrong return shape: {repr vals}"
+  | .ok (.reverted _ err) => throw s!"revert: {repr err}"
+  | .error err => throw s!"checked call: {repr err}"
+
+def blockResultAt (w a b : Nat) : Nat × Nat :=
+  let state := run w imported (fun key => if key = "a" then a else if key = "b" then b else 0)
+  (state "high", state "low")
+
+__PROOF__
+
+#print axioms exactLimbs
+
+def checkFile (file : System.FilePath) : IO Unit := do
+  let contract ← match TypeCheck.CheckedInput.contract source "Probe" with
+    | .ok contract => pure contract
+    | .error err => throw (IO.userError s!"typecheck/lower: {repr err}")
+  for line in ← IO.FS.lines file do
+    let [a,b] := line.splitOn " " | throw (IO.userError "expected two words")
+    let some a := a.toNat? | throw (IO.userError "invalid first word")
+    let some b := b.toNat? | throw (IO.userError "invalid second word")
+    match checkedResult contract a b with
+    | .error e => throw (IO.userError e)
+    | .ok (hi,lo) =>
+      unless (hi,lo) == blockResultAt modulus a b do throw (IO.userError "word and checked semantics disagree")
+      IO.println s!"{hi} {lo}"
+
+end SolidCore.Solidity.WordBlock.Probe
+
+def main : List String → IO Unit
+  | [file] => SolidCore.Solidity.WordBlock.Probe.checkFile file
+  | _ => throw (IO.userError "usage: probe <vectors>")
