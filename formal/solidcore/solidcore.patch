+            if method.get('nodeType') == 'FunctionCallOptions':
+                method = method['expression']
+            if not success.get('parameters') and method.get('typeDescriptions', {}).get(
+                'typeIdentifier', ''
+            ).startswith('t_function_external_'):
+                target = units.get(method.get('referencedDeclaration'), {})
+                outputs = target.get('returnParameters', {}).get('parameters', [])
