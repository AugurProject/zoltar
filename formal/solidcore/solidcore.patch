new file mode 100644
index 0000000000000000000000000000000000000000..51813dfb37cedea638b91911cf65a6867d88564b
--- /dev/null
+++ b/prototypes/mul512/import_word.py
@@ -0,0 +1,83 @@
+"""Import one analyzed function consisting of one straight-line Yul word block."""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'scripts'))
+from solc_ast_to_lean_source import function_decl_from_node, lean_string
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def import_block(function):
+    params = function['parameters']['parameters']
+    returns = function['returnParameters']['parameters']
+    require(function['stateMutability'] == 'pure' and not function['modifiers'],
+            'expected an unmodified pure function')
+    require(all(p['typeDescriptions']['typeString'] == 'uint256' and p['name']
+                for p in params + returns), 'only named uint256 bindings are supported')
+    statements = function['body']['statements']
+    require(len(statements) == 1 and statements[0]['nodeType'] == 'InlineAssembly',
+            'expected exactly one assembly block')
+    block = statements[0]
+    require(block['AST']['nodeType'] == 'YulBlock' and
+            set(block.get('flags', [])) <= {'memory-safe'}, 'unsupported block')
+    bindings = {p['id']: p['name'] for p in params + returns}
+    refs = {}
+    for ref in block['externalReferences']:
+        require(ref['declaration'] in bindings and ref['valueSize'] == 1 and
+                not ref['isSlot'] and not ref['isOffset'] and not ref.get('suffix'),
+                'unsupported outer binding')
+        require(ref['src'] not in refs, 'duplicate external reference')
+        refs[ref['src']] = bindings[ref['declaration']]
+    locals_ = set()
+    used_refs = set()
+
+    def resolve(node):
+        name = node['name']
+        require(node['nodeType'] == 'YulIdentifier', 'expected word identifier')
+        if node['src'] in refs:
+            require(refs[node['src']] == name, 'outer declaration/name mismatch')
+            used_refs.add(node['src'])
+        else:
+            require(name in locals_, f'unresolved Yul local {name}')
+        return lean_string(name)
+
+    def expr(node):
+        kind = node['nodeType']
+        if kind == 'YulIdentifier':
+            return '(.var ' + resolve(node) + ')'
+        if kind == 'YulLiteral':
+            require(node['kind'] == 'number', 'only word literals are supported')
+            n = int(node['value'], 0)
+            require(0 <= n < 2**256, 'literal does not fit uint256')
+            return f'(.lit {n})'
+        require(kind == 'YulFunctionCall', f'unsupported expression {kind}')
+        op = node['functionName']['name']
+        args = node['arguments']
+        require(op in {'mul', 'sub', 'lt', 'not', 'mulmod'}, f'unsupported builtin {op}')
+        require(len(args) == {'not': 1, 'mulmod': 3}.get(op, 2), 'wrong builtin arity')
+        return '(.' + op + ' ' + ' '.join(map(expr, args)) + ')'
+
+    steps = []
+    for stmt in block['AST']['statements']:
+        kind = stmt['nodeType']
+        require(kind in ('YulVariableDeclaration', 'YulAssignment'), f'unsupported statement {kind}')
+        rhs = expr(stmt['value'])
+        if kind == 'YulVariableDeclaration':
+            var, = stmt['variables']
+            name = var['name']
+            require(var['nodeType'] == 'YulTypedName' and not var.get('type') and
+                    name not in locals_ and name not in bindings.values(), 'invalid local')
+            locals_.add(name)
+            steps.append('.declare ' + lean_string(name) + ' ' + rhs)
+        else:
+            target, = stmt['variableNames']
+            steps.append('.assign ' + resolve(target) + ' ' + rhs)
+    require(used_refs == set(refs), 'unused external reference')
+    # Preserve the original Solidity function header; install its imported block in Lean.
+    header = function_decl_from_node({**function, 'body': None})
+    return '[' + ',\n    '.join(steps) + ']', header
