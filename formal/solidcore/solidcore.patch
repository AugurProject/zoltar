+      return .emitEvent "#yul.log4" args
+  | Stmt.expr (Expr.call (Expr.ident "#yul.returnPrefixedCode") [Arg.positional data]) =>
+      return .returnPrefixedCode (← Expr.toCore? storageNames data)
