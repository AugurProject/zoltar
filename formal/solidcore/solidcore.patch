+++ b/prototypes/source/oracle_words.py
@@ -0,0 +1,125 @@
+"""Compare typed field access and raw calldata words of the repository's OracleGame."""
+
+import argparse
+import ast
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, evm_version, anvil):
+    path = 'solidity/contracts/statoblast/openOracle/OpenOracle.sol'
+    oracle = (repo / path).read_text()
+    start = oracle.index('struct OracleGame {')
+    layout = oracle[start : oracle.index('}', start) + 1]
+    fields = [('currentAmount1', 0, 128), ('currentReporter', 2, 160), ('flags', 19, 8)]
+    methods = []
+    for field, index, _ in fields:
+        methods.append(
+            f'function raw_{field}(OracleGame calldata g) external pure returns(uint v) {{assembly {{v:=calldataload(add(g,{32 * index}))}}}}'
+        )
+        methods.append(
+            f'function typed_{field}(OracleGame calldata g) external pure returns(uint) {{return '
+            + (f'uint160(g.{field})' if field == 'currentReporter' else f'g.{field}')
+            + ';}'
+        )
+    source = (
+        'pragma solidity ^0.8.20; contract Probe {'
+        + layout
+        + '\n'
+        + '\n'.join(methods)
+        + '}'
+    )
+    compiled = compile_solc(
+        compiler,
+        {'P.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                'Probe': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+        evm_version=evm_version,
+    )
+    model = importer.render_module(
+        lower_assembly(project(compiled['sources']['P.sol']['ast'], 'Probe')),
+        path,
+        'Probe',
+        'SolidCore.Solidity.OracleWords',
+        True,
+        analyzed_solc_028=evm_version == 'cancun',
+    )
+    evm = compiled['contracts']['P.sol']['Probe']['evm']
+    addr = '0x' + 'b7' * 20
+    rows = []
+
+    def word(v):
+        return v.to_bytes(32, 'big')
+
+    with replay.local_chain(anvil, evm_version) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for method, sel in evm['methodIdentifiers'].items():
+            mode, field = method.split('(')[0].split('_')
+            _, index, width = next(item for item in fields if item[0] == field)
+            for v in [0, 17, 2**width - 1, 2**width, 2**256 - 1]:
+                words = [2**256 - 1] * 20
+                words[index] = v
+                data = bytes.fromhex(sel) + b''.join(map(word, words))
+                ok = mode == 'raw' or v < 2**width
+                try:
+                    out = bytes.fromhex(
+                        replay.rpc(
+                            url,
+                            'eth_call',
+                            [{'to': addr, 'data': '0x' + data.hex()}, 'latest'],
+                        )[2:]
+                    )
+                except RuntimeError as e:
+                    if ok or ast.literal_eval(str(e)).get('data') != '0x':
+                        raise
+                    out = b''
+                else:
+                    if not ok or out != word(v):
+                        raise AssertionError((method, v, out))
+                rows.append(f'({list(data)},{str(ok).lower()},{list(out)})')
+    with tempfile.TemporaryDirectory() as tmp:
+        p = Path(tmp) / 'Words.lean'
+        p.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract OracleWords.importedSourceUnit "Probe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (input,success,want) in (["""
+            + ',\n'.join(rows)
+            + """] : List (List Nat × Bool × List Nat)) do
+    let some r := TypeCheck.CheckedContract.callCalldata? 20000 c Source.State.empty input | throw (IO.userError "no dispatch")
+    unless r.success == success && r.output == want do throw (IO.userError s!"raw/typed disagreement {input.take 4} {r.success} {r.output}")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-s', '131072', '-DmaxRecDepth=32768', '--run', p],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(rows)} OracleGame calldata field reads matched Anvil ({evm_version})')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('repo', type=Path)
+    parser.add_argument('--solc', required=True)
+    parser.add_argument('--oracle-solc', required=True)
+    parser.add_argument('--anvil', required=True)
+    args = parser.parse_args()
+    run(args.repo, args.solc, 'osaka', args.anvil)
+    run(args.repo, args.oracle_solc, 'cancun', args.anvil)
