@@ -0,0 +1,181 @@
+"""Replay updates and queries of the repository persistent maps from Solidity source."""
+
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run_harness(repo, compiler, anvil, forge, target, calls):
+    path = f'contracts/test/statoblast/{target}.sol'
+    with tempfile.TemporaryDirectory() as tmp:
+        flat = Path(tmp) / 'Map.sol'
+        subprocess.run(
+            [
+                forge,
+                'flatten',
+                '--root',
+                repo / 'solidity',
+                '-j',
+                '1',
+                repo / 'solidity' / path,
+                '-o',
+                flat,
+            ],
+            check=True,
+            env={**os.environ, 'FOUNDRY_SOLC': compiler, 'FOUNDRY_OFFLINE': 'true'},
+            stdout=subprocess.DEVNULL,
+        )
+        result = compile_solc(
+            compiler,
+            {'Map.sol': flat.read_text()},
+            {
+                '*': {
+                    '': ['ast'],
+                    target: ['evm.bytecode.object', 'evm.methodIdentifiers'],
+                }
+            },
+        )
+        evm = result['contracts']['Map.sol'][target]['evm']
+        model = importer.render_module(
+            lower_assembly(project(result['sources']['Map.sol']['ast'], target)),
+            path,
+            target,
+            'SolidCore.Solidity.MapProbe',
+            True,
+        )
+        with replay.local_chain(anvil) as url:
+            sender = replay.rpc(url, 'eth_accounts', [])[0]
+
+            def send(tx):
+                txid = replay.rpc(
+                    url,
+                    'eth_sendTransaction',
+                    [{'from': sender, 'gas': '0x800000', **tx}],
+                )
+                for _ in range(100):
+                    receipt = replay.rpc(url, 'eth_getTransactionReceipt', [txid])
+                    if receipt:
+                        if int(receipt['status'], 16) != 1:
+                            raise AssertionError(receipt)
+                        return receipt
+                    time.sleep(0.05)
+                raise TimeoutError(txid)
+
+            address = send({'data': '0x' + evm['bytecode']['object']})[
+                'contractAddress'
+            ]
+            for signature, args, expected in calls:
+                tx = {
+                    'to': address,
+                    'data': '0x'
+                    + evm['methodIdentifiers'][signature]
+                    + ''.join(f'{v:064x}' for v in args),
+                }
+                if not expected:
+                    send(tx)
+                else:
+                    out = replay.rpc(url, 'eth_call', [tx, 'latest'])
+                    if out != '0x' + ''.join(f'{v:064x}' for v in expected):
+                        raise AssertionError((signature, args, out))
+        probe = Path(tmp) / 'Map.lean'
+        probe.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract MapProbe.importedSourceUnit """
+            + f'"{target}"'
+            + """ with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  let .ok (.returned init _) := TypeCheck.CheckedContract.construct 250000 c Source.State.empty [] | throw (IO.userError "constructor failed")
+  let mut state := init
+  for (name,args,expected) in (["""
+            + ',\n'.join(f'("{s.split("(")[0]}",{a},{v})' for s, a, v in calls)
+            + """] : List (String × List Nat × List Nat)) do
+    match TypeCheck.CheckedContract.callFunctionWithContext 250000 c name c.core.context state (args.map Source.Value.word) with
+    | .ok (.returned next results) =>
+      unless (results.mapM Source.Value.asWord?) == some expected do throw (IO.userError s!"wrong result {name} {args}: {repr results}")
+      state := next
+    | .ok (.reverted _ why) => throw (IO.userError s!"reverted in {name} {args}: {repr why}")
+    | .error e => throw (IO.userError (reprStr e))
+"""
+        )
+        subprocess.run(
+            [
+                'lake',
+                'env',
+                'lean',
+                '-s',
+                '131072',
+                '-DmaxRecDepth=32768',
+                '-DmaxHeartbeats=20000000',
+                '--run',
+                probe,
+            ],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(calls)} {target} updates and queries matched Anvil')
+
+
+def run(repo, compiler, anvil, forge):
+    run_harness(
+        repo,
+        compiler,
+        anvil,
+        forge,
+        'SecurityPoolMaturityMapHarness',
+        [
+            ('add(uint256,uint48,uint256,uint256)', [0, 5, 100, 77], []),
+            ('get(uint256,uint48)', [1, 5], [100, 77]),
+            ('add(uint256,uint48,uint256,uint256)', [1, 9, 30, 10], []),
+            ('prefix(uint256,uint48)', [2, 0], [0, 0]),
+            ('prefix(uint256,uint48)', [2, 6], [100, 77]),
+            ('prefix(uint256,uint48)', [2, 9], [130, 87]),
+            ('total(uint256)', [2], [130]),
+            ('total(uint256)', [1], [100]),
+            # INV-42: key zero is a sentinel, even for nonzero deltas.
+            ('add(uint256,uint48,uint256,uint256)', [2, 0, 12, 34], []),
+            ('get(uint256,uint48)', [3, 0], [0, 0]),
+            ('prefix(uint256,uint48)', [3, 9], [130, 87]),
+        ],
+    )
+    run_harness(
+        repo,
+        compiler,
+        anvil,
+        forge,
+        'SettlementPersistentMapHarness',
+        [
+            ('set(uint256,uint256,uint256,uint256)', [0, 3, 11, 5], []),
+            ('set(uint256,uint256,uint256,uint256)', [1, 9, 12, 7], []),
+            ('get(uint256,uint256)', [1, 9], [0]),
+            ('get(uint256,uint256)', [2, 9], [12]),
+            ('total(uint256)', [2], [12]),
+            ('prefixTotal(uint256,uint256)', [2, 4], [5]),
+            ('appendFrozen(uint256,uint48,uint256)', [0, 5, 123], []),
+            ('appendFrozen(uint256,uint48,uint256)', [1, 9, 456], []),
+            ('frozenCeiling(uint256,uint48)', [2, 6], [456]),
+            ('frozenCeiling(uint256,uint48)', [1, 6], [0]),
+            ('get(uint256,uint256)', [2, 3], [11]),
+        ],
+    )
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('repo', type=Path)
+    parser.add_argument('--anvil', required=True)
+    parser.add_argument('--solc', required=True)
+    parser.add_argument('--forge', required=True)
+    args = parser.parse_args()
+    run(args.repo.resolve(), args.solc, args.anvil, args.forge)
