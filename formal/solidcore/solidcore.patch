+"""Check the boundaries of source rewrites against actual analyzed Solidity."""
+
+import copy
+from pathlib import Path
+import subprocess
+import tempfile
+import sys
+import unittest
+
+from assembly import Unsupported, lower_assembly, walk
+from muldiv import ROOT, compile_solc, importer
+from project import project
+
+compiler = 'solc'
+
+
+class AssemblyTests(unittest.TestCase):
+    def setUp(self):
+        self.ast = compile_solc(
+            compiler,
+            {
+                'Test.sol': """
+pragma solidity 0.8.35;
+contract T {
+    function bubble(bytes memory a, bytes memory b) public pure {
+        assembly { revert(add(a, 32), mload(a)) }
+    }
+    function panic(uint256 code) public pure {
+        assembly { mstore(0, 0x4e487b71) mstore(32, code) revert(28,36) }
+    }
+}
+"""
+            },
+            {'*': {'': ['ast']}},
+        )['sources']['Test.sol']['ast']
+
+    def test_exact_pragmas_checked_against_selected_compiler(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            script = Path(tmp) / 'Pragmas.lean'
+            script.write_text("""
+import SolidCore.Solidity.Checked
+open SolidCore.Solidity
+def accepts (older : Bool) (pragma : String) : Bool :=
+  (TypeCheck.SourceUnit.check {items := [.pragma "solidity" pragma], analyzedSolc028 := older}).isOk
+#guard accepts true "=0.8.28>=0.4.16>=0.6.2^0.8.20"
+#guard !accepts false "=0.8.28>=0.4.16>=0.6.2^0.8.20"
+#guard accepts false "=0.8.35"
+#guard !accepts true "=0.8.35"
+#guard !accepts true ">=0.8.29"
+#guard !accepts true "broken"
+""")
+            subprocess.run(['lake', 'env', 'lean', script], cwd=ROOT, check=True)
+
+    def test_scratch_word_overlays_and_uninitialized_reads(self):
+        source = """
+pragma solidity 0.8.35;
+contract Scratch {
+    function read(uint x, uint y) external pure returns(uint result) {
+        assembly {
+            mstore(0,x)
+            mstore(32,y)
+            mstore8(32,0x101)
+            result := mload(1)
+        }
+    }
+}
+"""
+
+        def analyze(text):
+            return compile_solc(compiler, {'P.sol': text}, {'*': {'': ['ast']}})[
+                'sources'
+            ]['P.sol']['ast']
+
+        for changed in [
+            source.replace('mstore(0,x)', ''),
+            source.replace('mload(1)', 'mload(33)'),
+            source.replace('mstore8(32', 'mstore8(64'),
+        ]:
+            with self.assertRaises(Unsupported):
+                lower_assembly(analyze(changed))
+        model = importer.render_module(
+            lower_assembly(analyze(source)),
+            'P.sol',
+            'Scratch',
+            'SolidCore.Solidity.ScratchTest',
+            True,
+        )
+        with tempfile.TemporaryDirectory() as tmp:
+            test = Path(tmp) / 'Scratch.lean'
+            test.write_text(
+                'import SolidCore.Solidity.Checked\n'
+                + model
+                + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract ScratchTest.importedSourceUnit "Scratch" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for x in [0,19,2^255,2^256-1] do
+    match TypeCheck.CheckedContract.call 10000 c (.name "read") Source.State.empty [.word x,.word (2^256-1)] with
+    | .ok (.returned _ [.word got]) =>
+      unless got == (x*256+1) % (2^256) do throw (IO.userError s!"wrong scratch word {got}")
+    | r => throw (IO.userError (reprStr r))
+"""
+            )
+            subprocess.run(['lake', 'env', 'lean', '--run', test], cwd=ROOT, check=True)
+
+    def test_exact_intrinsics(self):
+        names = [
+            d['name']
+            for d in walk(lower_assembly(self.ast))
+            if d.get('nodeType') == 'ErrorDefinition'
+        ]
+        self.assertEqual(names, ['#yul.panic', '#yul.rethrow'])
+
+    def test_rethrow_requires_exact_pointer_and_extent(self):
+        for variant in ['offset', 'distinct', 'slot']:
+            with self.subTest(variant=variant):
+                ast = copy.deepcopy(self.ast)
+                block = next(
+                    d for d in walk(ast) if d.get('nodeType') == 'InlineAssembly'
+                )
+                ptr, size = block['AST']['statements'][0]['expression']['arguments']
+                if variant == 'offset':
+                    ptr['arguments'][1]['value'] = '31'
+                elif variant == 'slot':
+                    block['externalReferences'][0]['isSlot'] = True
+                else:
+                    second = size['arguments'][0]
+                    second['name'] = 'b'
+                    ref = next(
+                        r
+                        for r in block['externalReferences']
+                        if r['src'] == second['src']
+                    )
+                    ref['declaration'] = next(
+                        d['id']
+                        for d in walk(ast)
+                        if d.get('nodeType') == 'VariableDeclaration'
+                        and d['name'] == 'b'
+                    )
+                with self.assertRaises(Unsupported):
+                    lower_assembly(ast)
+
+    def test_fallback_requires_exact_gate_call_and_terminal_copy(self):
+        proxy = """
+pragma solidity 0.8.35;
+contract Proxy {
+    fallback() external {
+        uint s1 = 1; uint s2 = 2; uint s3 = 3;
+        address target = address(42);
+        assembly ("memory-safe") {
+            let s := shr(224,calldataload(0))
+            if iszero(or(or(eq(s,s1),eq(s,s2)),eq(s,s3))) { revert(0,0) }
+            let p := mload(64)
+            calldatacopy(p,0,calldatasize())
+            if iszero(delegatecall(gas(),target,p,calldatasize(),0,0)) {
+                returndatacopy(p,0,returndatasize())
+                revert(p,returndatasize())
+            }
+            returndatacopy(p,0,returndatasize())
+            return(p,returndatasize())
+        }
+    }
+}
+"""
+        for before, after in [
+            ('shr(224', 'shr(223'),
+            ('eq(s,s3)', 'eq(s,s2)'),
+            ('calldatacopy(p,0', 'calldatacopy(p,1'),
+            ('delegatecall(gas()', 'delegatecall(1000'),
+            ('return(p,returndatasize())', 'return(0,returndatasize())'),
+        ]:
+            with self.subTest(before=before):
+                ast = compile_solc(
+                    compiler,
+                    {'P.sol': proxy.replace(before, after)},
+                    {'*': {'': ['ast']}},
+                )['sources']['P.sol']['ast']
+                with self.assertRaises(Unsupported):
+                    lower_assembly(ast)
+
+    def test_log4_reads_the_whole_payload_and_direct_topic_bindings(self):
+        source = """
+pragma solidity 0.8.35;
+contract T {
+    function log(bytes memory data, bytes memory other, bytes32 sig, uint a, uint b, address who) external {
+        assembly { log4(add(data,32),mload(data),sig,a,b,who) }
+    }
+}
+"""
+        for before, after in [
+            ('add(data,32)', 'add(data,31)'),
+            ('mload(data)', 'mload(other)'),
+            ('sig,a,b,who', 'sig,a,b,add(who,1)'),
+            ('bytes memory data', 'bytes calldata data'),
+        ]:
+            with self.subTest(before=before):
+                # calldata uses .offset, and therefore is a different Yul binding.
+                changed = source.replace(before, after)
+                if after == 'bytes calldata data':
+                    changed = changed.replace(
+                        'add(data,32)', 'add(data.offset,32)'
+                    ).replace('mload(data)', 'mload(data.offset)')
+                ast = compile_solc(compiler, {'L.sol': changed}, {'*': {'': ['ast']}})[
+                    'sources'
+                ]['L.sol']['ast']
+                with self.assertRaises(Unsupported):
+                    lower_assembly(ast)
+
+    def test_panic_requires_exact_payload(self):
+        block = [d for d in walk(self.ast) if d.get('nodeType') == 'InlineAssembly'][1]
+        block['AST']['statements'][-1]['expression']['arguments'][1]['value'] = '35'
+        with self.assertRaises(Unsupported):
+            lower_assembly(self.ast)
+
+
+class CodeCopyTests(unittest.TestCase):
