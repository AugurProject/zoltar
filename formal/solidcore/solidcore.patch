+"""Replay the EscalationGame fallback's selector gate and exact returndata."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    source = (repo / 'solidity/contracts/statoblast/EscalationGame.sol').read_text()
+    fallback = source.split('fallback() external {', 1)[1].split('\n\t}', 1)[0]
+    assembly = fallback[fallback.index('assembly (') :]
+    source = (
+        """pragma solidity 0.8.35;
+contract Proxy {
+    fallback() external {
+        address depositDelegateAddress = address(0x2000);
+        uint256 depositWithPermitSelector = 0x11000000;
+        uint256 depositWithAuthorizationSelector = 0x22334455;
+        uint256 depositWithPermitAndLeadSelector = 0x66778899;
+"""
+        + assembly
+        + """
+    }
+}
+contract Response {
+    fallback(bytes calldata input) external returns (bytes memory) {
+        bytes memory output = abi.encodePacked(address(this),input);
+        if (input.length > 4 && input[4] == 0xff) {
+            assembly ("memory-safe") { revert(add(output,32),mload(output)) }
+        }
+        return output;
+    }
+}
+"""
+    )
+    r = compile_solc(
+        compiler,
+        {'P.sol': source},
+        {'*': {'': ['ast'], '*': ['evm.deployedBytecode.object']}},
+    )
+    model = importer.render_module(
+        lower_assembly(project(r['sources']['P.sol']['ast'], 'Proxy')),
+        'P.sol',
+        'Proxy',
+        'SolidCore.Solidity.GuardedProxy',
+        True,
+    )
+    cases = [
+        ('', False),
+        ('22', False),
+        ('1100', True),
+        ('11000001', False),
+        ('22334455', True),
+        ('667788990001', True),
+        ('22334455ff01', True),
+    ]
+    proxy = '0x' + f'{4096:040x}'
+    delegate = '0x' + f'{8192:040x}'
+    rows = []
+    with replay.local_chain(anvil) as url:
+        for name, address in [('Proxy', proxy), ('Response', delegate)]:
+            bytecode = r['contracts']['P.sol'][name]['evm']['deployedBytecode'][
+                'object'
+            ]
+            replay.rpc(url, 'anvil_setCode', [address, '0x' + bytecode])
+        for encoded, allowed in cases:
+            inp = bytes.fromhex(encoded)
+            success = allowed and inp[4:5] != b'\xff'
+            output = bytes.fromhex(proxy[2:]) + inp if allowed else b''
+            try:
+                got = replay.rpc(
+                    url, 'eth_call', [{'to': proxy, 'data': '0x' + encoded}, 'latest']
+                )
+            except RuntimeError as exc:
+                if success or exc.args[0].get('data') != '0x' + output.hex():
+                    raise
+            else:
+                if not success or got != '0x' + output.hex():
+                    raise AssertionError((encoded, got))
+            rows.append(
+                f'({list(inp)},{str(allowed).lower()},{str(success).lower()},{list(output)})'
+            )
+    with tempfile.TemporaryDirectory() as tmp:
+        probe = Path(tmp) / 'Proxy.lean'
+        probe.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract GuardedProxy.importedSourceUnit "Proxy" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (input,allowed,success,output) in (["""
+            + ',\n'.join(rows)
+            + """] : List (List Nat × Bool × Bool × List Nat)) do
+    let some tree := Source.ABI.Contract.callCalldataAtFromWithContext 20000 c.core c.core.context Source.State.empty 4096 99 0 input | throw (IO.userError "no dispatch tree")
+    let row := Source.responderOfResults [{kind := .delegatecall, target := 8192, calldata := input, gas? := some 50000, success, output}] []
+    let ans ← match tree, allowed with
+      | .request (.resource .gas) k, true =>
+        let next := k (Source.wordToU256 50000)
+        match next with
+        | .request (.external _ (.call _)) _ => pure (Source.SolI.runWith row next)
+        | _ => throw (IO.userError "no delegate request")
+      | .done _, false => pure (Source.SolI.runWith (Source.responderOfResults [] []) tree)
+      | _,_ => throw (IO.userError s!"wrong selector gate for {input}")
+    match ans with
+    | .ok a => unless a.success == success && a.output == output do throw (IO.userError s!"wrong return for {input}")
+    | .error _ => throw (IO.userError "delegate request did not match")
+"""
+        )
+        subprocess.run(['lake', 'env', 'lean', '--run', probe], cwd=ROOT, check=True)
+    print(f'{len(rows)} selector-gated delegate calls matched Anvil')
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('repo', type=Path)
+    p.add_argument('--solc', required=True)
+    p.add_argument('--anvil', required=True)
+    a = p.parse_args()
+    run(a.repo.resolve(), a.solc, a.anvil)
diff --git a/prototypes/source/invalid_halt.py b/prototypes/source/invalid_halt.py
