+"""Track the typed alias and raw words of a flat struct copied from calldata."""
+
+import re
+
+from assembly import Unsupported, call, ident, n, walk, yul_expr
+
+
+def number(v):
+    return n('Literal', kind='number', value=str(v))
+
+
+def at(name, i):
+    return n('IndexAccess', baseExpression=ident(name), indexExpression=number(i))
+
+
+def member(obj, name):
+    return n('MemberAccess', expression=obj, memberName=name)
+
+
+def assign(lhs, rhs):
+    return n(
+        'ExpressionStatement',
+        expression=n('Assignment', operator='=', leftHandSide=lhs, rightHandSide=rhs),
+    )
+
+
+def cast(ty, expr):
+    return call(
+        n('ElementaryTypeNameExpression', typeName=n('ElementaryTypeName', name=ty)),
+        expr,
+    )
+
+
+def field_value(ty, raw):
+    return cast('address', cast('uint160', raw)) if ty == 'address' else cast(ty, raw)
+
+
+def field_word(ty, value):
+    return cast('uint256', cast('uint160', value) if ty == 'address' else value)
+
+
+def word_array(size):
+    return n(
+        'ArrayTypeName',
+        baseType=n('ElementaryTypeName', name='uint256'),
+        length=number(size),
+    )
+
+
+def yul_statements(block):
+    result = []
+    for stmt in block['AST']['statements']:
+        if stmt['nodeType'] == 'YulAssignment' and len(stmt['variableNames']) == 1:
+            result.append(
+                ('=', stmt['variableNames'][0]['name'], yul_expr(stmt['value']))
+            )
+        elif (
+            stmt['nodeType'] == 'YulVariableDeclaration' and len(stmt['variables']) == 1
+        ):
+            result.append(
+                ('let', stmt['variables'][0]['name'], yul_expr(stmt['value']))
+            )
+        elif stmt['nodeType'] == 'YulIf':
+            result.append(
+                (
+                    'if',
+                    yul_expr(stmt['condition']),
+                    tuple(yul_statements({'AST': stmt['body']})),
+                )
+            )
+        elif stmt['nodeType'] == 'YulExpressionStatement':
+            result.append(yul_expr(stmt['expression']))
+        else:
+            return []
+    return result
+
+
+def bindings(block, declarations):
+    refs = {r['src']: r for r in block['externalReferences']}
+    named = {}
+    used = set()
+    for node in walk(block['AST']):
+        if node.get('nodeType') != 'YulIdentifier' or node['src'] not in refs:
+            continue
+        r = refs[node['src']]
+        d = declarations.get(r['declaration'], {})
+        if (
+            d.get('name') != node['name']
+            or d.get('stateVariable')
+            or r.get('suffix')
+            or r['isSlot']
+            or r['isOffset']
+            or r['valueSize'] != 1
+            or named.get(node['name'], d) is not d
+        ):
+            return {}
+        named[node['name']] = d
+        used.add(node['src'])
+    return named if used == refs.keys() else {}
+
+
+def parents(node, result):
+    if isinstance(node, dict):
+        for key, value in node.items():
+            if isinstance(value, dict):
+                result[id(value)] = (node, key)
+                parents(value, result)
+            elif isinstance(value, list):
+                for child in value:
+                    if isinstance(child, dict):
+                        result[id(child)] = (node, key)
+                        parents(child, result)
+
+
+def scalar_layout(var, decls):
+    struct = decls.get(var.get('typeName', {}).get('referencedDeclaration'), {})
+    if struct.get('nodeType') != 'StructDefinition':
+        return []
+    fields = []
+    for field in struct['members']:
+        ty = field.get('typeDescriptions', {}).get('typeString')
+        if not ty or not re.fullmatch(r'uint[0-9]+|address', ty):
+            return []
+        fields.append((field['name'], ty))
+    return fields
+
+
+def rewrite_function(fn, decls, packers):
+    body = fn.get('body') or {}
+    setup = None
+    overlays = []
+    popped = []
+    gate = None
+    for stmt in body.get('statements', []):
+        if stmt.get('nodeType') != 'InlineAssembly' or stmt.get('flags') != [
+            'memory-safe'
+        ]:
+            continue
+        ops = yul_statements(stmt)
+        match ops:
+            case [
+                ('=', buf, ('mload', 64)),
+                ('calldatacopy', p, src1, n1),
+                ('calldatacopy', ('add', q, off), src2, n2),
+                ('=', h, ('keccak256', r, total)),
+                ('=', alias, s),
+                ('mstore', 64, ('add', t, end)),
+            ]:
+                if (
+                    buf == p == q == r == s == t
+                    and all(type(x) is int for x in (n1, n2))
+                    and off == n1
+                    and total == end == n1 + n2
+                ):
+                    setup = stmt
+                    break
+            case [
+                ('let', ptr, ('mload', 64)),
+                ('calldatacopy', p, src1, n1),
+                ('pop', v1),
+                ('pop', v2),
+                ('pop', v3),
+                ('mstore', ('add', q, d1), v4),
+                ('mstore', ('add', r, d2), v5),
+                ('if', flag, (('mstore', ('add', s1, d3), 1),)),
+                ('mcopy', ('add', s2, off), src2, n2),
+                ('=', h, ('keccak256', s3, total)),
+                ('=', alias, s4),
+                ('=', buf, s5),
+                ('mstore', 64, ('add', s6, end)),
+            ]:
+                if (
+                    len({ptr, p, q, r, s1, s2, s3, s4, s5, s6}) == 1
+                    and all(
+                        type(x) is int for x in (d1, d2, d3, n1, n2, off, total, end)
+                    )
+                    and off == n1
+                    and end == total == n1 + n2
+                    and all(i % 32 == 0 and 0 <= i < n1 for i in (d1, d2, d3))
+                ):
+                    setup = stmt
+                    overlays = [(d1 // 32, v4), (d2 // 32, v5)]
+                    gate = (d3 // 32, flag)
+                    popped = [v1, v2, v3]
+                    break
+    if setup is None:
+        return
+    names = bindings(setup, decls)
+    bound = [buf, alias, src1, src2, h, *popped, *[name for _, name in overlays]]
+    if gate:
+        bound.append(gate[1])
+    if (
+        not all(isinstance(name, str) for name in bound)
+        or len(set(bound)) != len(bound)
+        or set(names) != set(bound)
+    ):
+        return
+    handle, typed, first, second, hash_var = [
+        names[k] for k in (buf, alias, src1, src2, h)
+    ]
+    fields = scalar_layout(first, decls)
+    tail = scalar_layout(second, decls)
+    if (
+        not fields
+        or not tail
+        or len(fields) * 32 != n1
+        or len(tail) * 32 != n2
+        or typed['typeName'].get('referencedDeclaration')
+        != first['typeName'].get('referencedDeclaration')
+        or (
+            typed.get('storageLocation'),
+            first.get('storageLocation'),
+            second.get('storageLocation'),
+        )
+        != ('memory', 'calldata', 'memory' if gate else 'calldata')
+        or handle['typeDescriptions']['typeIdentifier'] != 't_uint256'
+        or hash_var['typeDescriptions']['typeIdentifier'] != 't_bytes32'
+    ):
+        return
+    parent = {}
+    parents(body, parent)
+    if gate:
+        # MCOPY sees all four complete stack words in the fresh helper, not a
+        # decoder that validates unused calldata fields.
+        helper = parent.get(id(second), ({}, ''))[0]
+        value = helper.get('initialValue') or {}
+        stmts = body['statements']
+        if (
+            helper not in stmts
+            or value.get('kind') != 'structConstructorCall'
+            or value.get('expression', {}).get('referencedDeclaration')
+            != second['typeName'].get('referencedDeclaration')
+            or stmts.index(helper) >= stmts.index(setup)
+            or any(
+                st.get('nodeType') != 'VariableDeclarationStatement'
+                or st.get('initialValue')
+                for st in stmts[stmts.index(helper) + 1 : stmts.index(setup)]
+            )
+            or names[gate[1]]['typeDescriptions']['typeIdentifier'] != 't_bool'
+            or any(
+                not re.fullmatch(
+                    r'uint[0-9]+', names[k]['typeDescriptions']['typeString']
+                )
+                for _, k in overlays
+            )
+        ):
+            return
+    # Only transient locals acquire a new representation. Parameter and
+    # return types, including the public ABI, must remain identical.
+    for dec in [typed, handle]:
+        declaration = parent.get(id(dec), ({}, ''))[0]
+        if declaration.get(
+            'nodeType'
+        ) != 'VariableDeclarationStatement' or declaration.get('initialValue'):
+            return
+    positions = {id(stmt): i for i, stmt in enumerate(body['statements'])}
+
+    def position(node):
+        while id(node) not in positions:
+            node = parent[id(node)][0]
+        return positions[id(node)]
+
+    calls = []
+    logs = []
+    alias_positions = []
+    hashes = []
+    writes = []
+    for use in walk(body):
+        if use.get('nodeType') == 'InlineAssembly' and use is not setup:
+            refs = bindings(use, decls)
+            sensitive = {
+                r['declaration'] for r in use.get('externalReferences', [])
+            } & {typed['id'], handle['id']}
+            if not sensitive:
+                continue
+            if position(use) <= position(setup):
+                return
+            match yul_statements(use):
+                case [('log2', p, length, sig, topic)] if p == buf and use.get(
+                    'flags'
+                ) == ['memory-safe']:
+                    if (
+                        set(refs) == {buf, length, sig, topic}
+                        and refs[buf] is handle
+                        and [
+                            refs[k]['typeDescriptions']['typeIdentifier']
+                            for k in (length, sig, topic)
+                        ]
+                        == ['t_uint256', 't_bytes32', 't_uint256']
+                    ):
+                        logs.append((use, refs[length], sig, topic))
+                        continue
+                case [('=', dest, ('keccak256', base, length))] if (
+                    base == buf
+                    and length == total
+                    and use.get('flags') == ['memory-safe']
+                ):
+                    if (
+                        set(refs) == {dest, buf}
+                        and refs[buf] is handle
+                        and refs[dest]['typeDescriptions']['typeIdentifier']
+                        == 't_bytes32'
+                    ):
+                        hashes.append((use, dest))
+                        continue
+            return
+        if use.get('nodeType') != 'Identifier':
+            continue
+        ref = use.get('referencedDeclaration')
+        if ref == handle['id']:
+            invoke, key = parent[id(use)]
+            method = invoke.get('expression', {})
+            helper = packers.get(method.get('referencedDeclaration'))
+            if (
+                not helper
+                or helper['size'] != total // 32
+                or invoke.get('nodeType') != 'FunctionCall'
+                or method.get('nodeType') != 'Identifier'
+                or key != 'arguments'
+                or invoke['arguments'] != [use]
+                or position(invoke) <= position(setup)
+            ):
+                return
+            stmt = parent[id(invoke)][0]
+            if (
+                stmt.get('nodeType') != 'VariableDeclarationStatement'
+                or stmt.get('initialValue') is not invoke
+                or len(stmt['declarations']) != 1
+            ):
+                return
+            calls.append((stmt, method, helper))
+            continue
+        if ref != typed['id']:
+            continue
+        if position(use) <= position(setup):
+            return
+        alias_positions.append(position(use))
+        up, key = parent[id(use)]
+        if (
+            up.get('nodeType') == 'Assignment'
+            and key == 'rightHandSide'
+            and up.get('operator') == '='
+        ):
+            target = (
+                up['leftHandSide'].get('typeDescriptions', {}).get('typeIdentifier', '')
+            )
+            if target.startswith('t_struct$') and target.endswith('_storage'):
+                continue
+        if up.get('nodeType') != 'MemberAccess' or key != 'expression':
+            return
+        context, side = parent[id(up)]
+        if context.get('nodeType') == 'UnaryOperation' and context.get('operator') in (
+            'delete',
+            '++',
+            '--',
+        ):
+            return
+        if context.get('isLValue') and context.get('nodeType') == 'TupleExpression':
+            return
+        if context.get('nodeType') == 'Assignment' and side == 'leftHandSide':
+            st = parent[id(context)][0]
+            if (
+                context.get('operator') != '='
+                or st.get('nodeType') != 'ExpressionStatement'
+            ):
+                return
+            idx = next(
+                (i for i, f in enumerate(fields) if f[0] == up['memberName']), None
+            )
+            if idx is None:
+                return
+            writes.append((st, idx))
+
+    if calls or logs:
+        # The packing helper overwrites the typed struct's memory. A subsequent
+        # typed access, observable numeric pointer or modified size needs a
+        # different proof of alias safety.
+        if len(calls) != 1 or len(logs) != 1:
+            return
+        site, method, packer = calls[0]
+        log, length, _, _ = logs[0]
+        if (
+            parent[id(site)][0] is not body
+            or parent[id(log)][0] is not body
+            or site['declarations'][0] is not length
+            or position(log) <= position(site)
+            or any(pos >= position(site) for pos in alias_positions)
+            or any(position(node) >= position(site) for node, _ in hashes)
+            or any(
+                v.get('referencedDeclaration') == length.get('id') for v in walk(body)
+            )
+        ):
+            return
+        packer['calls'].add(method['id'])
+        for node, _, sig, topic in logs:
+            node.clear()
+            node.update(emit_prefix(buf, length['name'], sig, topic))
+
+    def digest():
+        return call(
+            ident('keccak256'), call(member(ident('abi'), 'encode'), ident(buf))
+        )
+
+    size = len(fields) + len(tail)
+    handle.update(typeName=word_array(size), storageLocation='memory')
+    init = []
+    for src, offset, layout in [(src1, 0, fields), (src2, len(fields), tail)]:
+        for i, (_, ty) in enumerate(layout):
+            value = (
+                field_word(ty, member(ident(src), layout[i][0]))
+                if gate and src == src2
+                else call(ident('#yul.calldataWord'), ident(src), number(i))
+            )
+            init.append(assign(at(buf, offset + i), value))
+    for idx, name in overlays:
+        init.append(assign(at(buf, idx), ident(name)))
+    if gate:
+        init.append(
+            n(
+                'IfStatement',
+                condition=ident(gate[1]),
+                trueBody=assign(at(buf, gate[0]), number(1)),
+            )
+        )
+    for i, (field, ty) in enumerate(fields):
+        init.append(assign(member(ident(alias), field), field_value(ty, at(buf, i))))
+    init.append(assign(ident(h), digest()))
+    setup.clear()
+    setup.update(n('Block', statements=init))
+    for st, dest in hashes:
+        st.clear()
+        st.update(assign(ident(dest), digest()))
+    for st, idx in writes:
+        field, ty = fields[idx]
+        update = assign(at(buf, idx), field_word(ty, member(ident(alias), field)))
+        original = dict(st)
+        st.clear()
+        st.update(n('Block', statements=[original, update]))
+
+
+def lower_word_buffers(ast):
+    decls = {
+        node['id']: node
+        for node in walk(ast)
+        if 'id' in node
+        and node.get('nodeType') in ('StructDefinition', 'VariableDeclaration')
+    }
+    functions = [
+        fn
+        for contract in ast['nodes']
+        for fn in contract.get('nodes', [])
+        if fn.get('nodeType') == 'FunctionDefinition'
+    ]
+    packers = {fn['id']: spec for fn in functions if (spec := pack_helper(fn, decls))}
+    references = {
+        ref: {use['id'] for use in walk(ast) if use.get('referencedDeclaration') == ref}
+        for ref in packers
+    }
+    for fn in functions:
+        rewrite_function(fn, decls, packers)
+    for ref, spec in packers.items():
+        if not spec['calls']:
+            continue
+        if spec['calls'] != references[ref]:
+            raise Unsupported('word packing helper receives a buffer of unknown extent')
+        spec['param'].update(
+            typeName=word_array(spec['size']), storageLocation='memory'
+        )
+        spec['asm'].clear()
+        spec['asm'].update(spec['body'])
+
+
+def pack_helper(fn, decls):
+    """Recognize constant-offset big-endian word stores in a private memory region."""
+    from assembly import binary, variable
+
+    params = fn.get('parameters', {}).get('parameters', [])
+    outputs = fn.get('returnParameters', {}).get('parameters', [])
+    body = (fn.get('body') or {}).get('statements', [])
+    if (
+        fn.get('kind') != 'function'
+        or fn.get('visibility') not in ('private', 'internal')
+        or fn.get('virtual')
+        or fn.get('modifiers')
+        or fn.get('overrides')
+        or len(params) != 1
+        or len(outputs) != 1
+        or len(body) != 2
+        or any(
+            v['typeDescriptions']['typeIdentifier'] != 't_uint256'
+            for v in [*params, *outputs]
+        )
+    ):
+        return
+    asm, ret = body
+    if asm.get('nodeType') != 'InlineAssembly' or asm.get('flags') != ['memory-safe']:
+        return
+    buf = params[0]['name']
+    if bindings(asm, decls) != {buf: params[0]}:
+        return
+    assignment = ret.get('expression', {})
+    literal = assignment.get('rightHandSide', {})
+    if (
+        assignment.get('operator') != '='
+        or assignment.get('leftHandSide', {}).get('referencedDeclaration')
+        != outputs[0]['id']
+        or literal.get('kind') != 'number'
+        or literal.get('subdenomination')
+    ):
+        return
+    length = int(literal['value'], 0)
+
+    def offset(expr):
+        if expr == buf:
+            return 0
+        match expr:
+            case ('add', base, n) if base == buf and type(n) is int and n >= 0:
+                return n
+
+    mask = (1 << 256) - 1
+    writes = []
+    extent = 0
+    for i, op in enumerate(yul_statements(asm)):
+        match op:
+            case ('mstore', target, ('shl', shift, ('mload', source))) if (
+                type(shift) is int and 0 <= shift < 256
+            ):
+                width = 32
+            case ('mstore8', target, ('byte', 31, ('mload', source))):
+                width = 1
+                shift = 0
+            case _:
+                return
+        src, dst = offset(source), offset(target)
+        if src is None or dst is None or src % 32:
+            return
+        extent = max(extent, src + 32, dst + width)
+        read = at(buf, src // 32)
+        local = f'#packed{i}'
+        value = binary('<<', read, number(shift)) if shift else read
+        stmts = [
+            n(
+                'VariableDeclarationStatement',
+                declarations=[variable(local)],
+                initialValue=value,
+            )
+        ]
+        word, within = divmod(dst, 32)
+        if width == 1:
+            pos = 8 * (31 - within)
+            out = binary(
+                '|',
+                binary('&', at(buf, word), number(mask ^ (255 << pos))),
+                binary('<<', binary('&', ident(local), number(255)), number(pos)),
+            )
+            stmts.append(assign(at(buf, word), out))
+        elif within == 0:
+            stmts.append(assign(at(buf, word), ident(local)))
+        else:
+            hi = 8 * (32 - within)
+            lower = (1 << hi) - 1
+            stmts.append(
+                assign(
+                    at(buf, word),
+                    binary(
+                        '|',
+                        binary('&', at(buf, word), number(mask ^ lower)),
+                        binary('>>', ident(local), number(8 * within)),
+                    ),
+                )
+            )
+            stmts.append(
+                assign(
+                    at(buf, word + 1),
+                    binary(
+                        '|',
+                        binary('&', at(buf, word + 1), number(lower)),
+                        binary('<<', ident(local), number(hi)),
+                    ),
+                )
+            )
+        writes.extend(stmts)
+    if not writes or not 0 < length <= extent or extent % 32:
+        return
+    return {
+        'size': extent // 32,
+        'length': length,
+        'asm': asm,
+        'param': params[0],
+        'body': n('UncheckedBlock', statements=writes),
+        'calls': set(),
+    }
+
+
+def emit_prefix(buf, length, sig, topic):
+    from assembly import binary, variable
+
+    def local(name, ty, init):
+        return n(
+            'VariableDeclarationStatement',
+            declarations=[
+                n(
+                    'VariableDeclaration',
+                    name=name,
+                    storageLocation='memory',
+                    typeName=n('ElementaryTypeName', name=ty),
+                )
+            ],
+            initialValue=init,
+        )
+
+    data = '#logPayload'
+    whole = '#wordEncoding'
+    index = ident('#logIndex')
+
+    def byte(name):
+        return n('IndexAccess', baseExpression=ident(name), indexExpression=index)
+
+    return n(
+        'Block',
+        statements=[
+            local(whole, 'bytes', call(member(ident('abi'), 'encode'), ident(buf))),
+            local(
+                data,
+                'bytes',
+                call(
+                    n('NewExpression', typeName=n('ElementaryTypeName', name='bytes')),
+                    ident(length),
+                ),
+            ),
+            n(
+                'VariableDeclarationStatement',
+                declarations=[variable('#logIndex')],
+                initialValue=number(0),
+            ),
+            n(
+                'WhileStatement',
+                condition=binary('<', index, ident(length)),
+                body=n(
+                    'Block',
+                    statements=[
+                        assign(byte(data), byte(whole)),
+                        assign(index, binary('+', index, number(1))),
+                    ],
+                ),
+            ),
+            n(
+                'ExpressionStatement',
+                expression=call(
+                    ident('#yul.log2'), ident(data), ident(sig), ident(topic)
+                ),
+            ),
+        ],
+    )
