@@ -146,3 +146,40 @@ end ConstScopeShadow
 end Witness
 end Solidity
 end SolidCore
+
+/-! A qualified library constant must close over its declaring library, even
+when the consumer declares the same dependency name. Solidity returns 7, not
+999. Keep both the unshadowed control and the hostile consumer observable. -/
+namespace SolidCore.Solidity.Witness.LibraryConstantCapture
+open SolidCore.Solidity
+open SolidCore.Solidity.Source
+
+def constant (name : String) (value : Expr) : ContractItem :=
+  .stateVar { name, ty := .uint 256, mutability := .constant, init := some value }
+
+def libraryDecl : ContractDecl :=
+  { kind := .library, name := "LibraryConstants", items := [
+      constant "DEPENDENCY" (.literal (.number "7")),
+      constant "WINDOW" (.ident "DEPENDENCY")] }
+
+def consumer (name : String) (shadow : Bool) : ContractDecl :=
+  { name, items := (if shadow then [constant "DEPENDENCY" (.literal (.number "999"))] else []) ++ [
+      .function {
+        name := some "run", visibility := some .external_,
+        mutability := StateMutability.pure, returns := [{ ty := .uint 256 }],
+        body := some (.block [.returnValues (some
+          (.member (.typeName (.user { segments := ["LibraryConstants"] })) "WINDOW"))]) }] }
+
+def sourceUnit : SourceUnit :=
+  { items := [.contract libraryDecl, .contract (consumer "Control" false),
+      .contract (consumer "Shadow" true)] }
+
+private def isOkTrue : Except TypeCheck.TypeError Bool → Bool
+  | .ok true => true
+  | _ => false
+
+#guard TypeCheck.Result.isOk (TypeCheck.TypecheckedInput.checkedSourceUnit sourceUnit)
+#guard isOkTrue (SolidCore.Solidity.TypeCheck.Examples.checkedCallWordMatches 4000 sourceUnit "Control" "run" State.empty [] 7)
+#guard isOkTrue (SolidCore.Solidity.TypeCheck.Examples.checkedCallWordMatches 4000 sourceUnit "Shadow" "run" State.empty [] 7)
+#guard isOkTrue ((SolidCore.Solidity.TypeCheck.Examples.checkedCallWordMatches 4000 sourceUnit "Shadow" "run" State.empty [] 999).map not)
+end SolidCore.Solidity.Witness.LibraryConstantCapture
