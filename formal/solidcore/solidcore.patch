+            branch_assignment(expr)
+        if expr.get('nodeType') in ('Return', 'ExpressionStatement'):
+            bind_arithmetic_value(expr, units)
+        if expr.get('nodeType') in (
+            'IfStatement',
+            'WhileStatement',
+            'ExpressionStatement',
+        ):
+            bind_view_comparison(expr, units)
+        if expr.get('nodeType') in ('Block', 'UncheckedBlock'):
+            bind_nested_word_calls(expr['statements'], units)
+        if expr.get('nodeType') in ('EmitStatement', 'ExpressionStatement'):
+            bind_call_arguments(expr, units)
+            if expr['nodeType'] == 'ExpressionStatement':
+                bind_external_results(expr, units)
+        if expr.get('nodeType') == 'Return':
+            bind_call_arguments(expr, units)
+            if expr.get('nodeType') != 'Return':
+                continue
+            value = expr.get('expression') or {}
+            params = returns.get(expr.get('functionReturnParameters'), [])
+            result_types = [p['typeDescriptions']['typeString'] for p in params]
+            if (
+                value.get('nodeType') == 'Conditional'
+                and result_types
+                and all(
+                    re.fullmatch(r'uint[0-9]+', ty) or ty.startswith('enum ')
+                    for ty in result_types
+                )
+                and value['typeDescriptions']['typeString']
+                == (
+                    result_types[0]
+                    if len(result_types) == 1
+                    else 'tuple(' + ','.join(result_types) + ')'
+                )
+                and any(
+                    value[key].get('nodeType') == 'FunctionCall'
+                    for key in ('trueExpression', 'falseExpression')
+                )
+            ):
