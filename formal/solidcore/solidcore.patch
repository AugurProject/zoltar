@@ -0,0 +1,136 @@
+"""Check a vendored slot accessor against physical storage words on Anvil."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+from assembly import lower_assembly
+from muldiv import ROOT, importer, replay, compile_solc
+from project import project
+
+HARNESS = """
+contract SlotProbe {
+    function store(bytes32 slot, uint256 value) external {
+        StorageSlot.getUint256Slot(slot).value = value;
+    }
+    function load(bytes32 slot) external view returns(uint256) {
+        return StorageSlot.getUint256Slot(slot).value;
+    }
+}
+"""
+
+
+def run(repo, compiler, anvil):
+    path = (
+        repo
+        / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/utils/StorageSlot.sol'
+    )
+    result = compile_solc(
+        compiler,
+        {'Slot.sol': path.read_text() + HARNESS},
+        {
+            '*': {
+                '': ['ast'],
+                'SlotProbe': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    ast = lower_assembly(project(result['sources']['Slot.sol']['ast'], 'SlotProbe'))
+    module = importer.render_module(
+        ast, 'Slot.sol', 'SlotProbe', 'SolidCore.Solidity.Slots', True
+    )
+    evm = result['contracts']['Slot.sol']['SlotProbe']['evm']
+    addr = '0x' + '32' * 20
+    cases = [(7, 19), (2**256 - 1, 2**255 + 3), (7, 31), (0, 41), (2**256 - 1, 0)]
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        sender = replay.rpc(url, 'eth_accounts', [])[0]
+        expected = {}
+        for slot, word in cases:
+            tx = replay.rpc(
+                url,
+                'eth_sendTransaction',
+                [
+                    {
+                        'from': sender,
+                        'to': addr,
+                        'data': '0x'
+                        + evm['methodIdentifiers']['store(bytes32,uint256)']
+                        + f'{slot:064x}{word:064x}',
+                        'gas': '0x40000',
+                    }
+                ],
+            )
+            for _ in range(100):
+                receipt = replay.rpc(url, 'eth_getTransactionReceipt', [tx])
+                if receipt:
+                    break
+                time.sleep(0.05)
+            if receipt is None or int(receipt['status'], 16) != 1:
+                raise AssertionError((tx, receipt))
+            expected[slot] = word
+            for key, value in expected.items():
+                got = replay.rpc(url, 'eth_getStorageAt', [addr, hex(key), 'latest'])
+                read = replay.rpc(
+                    url,
+                    'eth_call',
+                    [
+                        {
+                            'to': addr,
+                            'data': '0x'
+                            + evm['methodIdentifiers']['load(bytes32)']
+                            + f'{key:064x}',
+                        },
+                        'latest',
+                    ],
+                )
+                if int(got, 16) != value or int(read, 16) != value:
+                    raise AssertionError((key, read, got))
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Slots.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + module
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Slots.importedSourceUnit "SlotProbe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  let mut state := Source.State.empty
+  let mut written : List (Nat × Nat) := []
+  for (slot, value) in ("""
+            + str(cases)
+            + """ : List (Nat × Nat)) do
+    match TypeCheck.CheckedContract.callFunctionWithContext 50000 c "store" Source.Context.empty state [.fixedBytes 32 slot, .word value] with
+    | .ok (.returned next _) => state := next
+    | _ => throw (IO.userError "slot write failed")
+    written := (slot,value) :: written.filter (fun kv => kv.1 != slot)
+    for (key, expected) in written do
+      unless state.loadSlot key == expected do throw (IO.userError "wrong physical slot")
+      match TypeCheck.CheckedContract.callFunctionWithContext 50000 c "load" Source.Context.empty state [.fixedBytes 32 key] with
+      | .ok (.returned _ [.word v]) => unless v == expected do throw (IO.userError "wrong read")
+      | _ => throw (IO.userError "slot read failed")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'{len(cases)} direct storage writes matched Anvil including overwrite, clear and alias isolation'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
