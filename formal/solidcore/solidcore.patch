+++ b/prototypes/source/creation.py
@@ -0,0 +1,154 @@
+"""Check raw creation requests and their continuations against local Solidity calls."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import compile_solc, importer, replay, ROOT
+from project import project
+
+HARNESS = """
+contract CreationProbe {
+    function salted(bytes memory code, bytes32 salt) external returns(address) {
+        return Create2Deployment.deploy(code, salt);
+    }
+    function plain(bytes memory code) external returns(address result) {
+        assembly ("memory-safe") { result := create(0, add(code, 32), mload(code)) }
+    }
+}
+"""
+
+
+def run(repo, compiler, anvil):
+    source = (
+        repo / 'solidity/contracts/statoblast/factories/Create2Deployment.sol'
+    ).read_text() + HARNESS
+    result = compile_solc(
+        compiler,
+        {'Create.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                'CreationProbe': [
+                    'evm.deployedBytecode.object',
+                    'evm.methodIdentifiers',
+                ],
+            }
+        },
+    )
+    ast = lower_assembly(
+        project(result['sources']['Create.sol']['ast'], 'CreationProbe')
+    )
+    lean = importer.render_module(
+        ast, 'Create.sol', 'CreationProbe', 'SolidCore.Solidity.Creation', True
+    )
+    evm = result['contracts']['Create.sol']['CreationProbe']['evm']
+    address = '0x' + '12' * 20
+    cases = []
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [address, '0x' + evm['deployedBytecode']['object']]
+        )
+        for method, sig in [
+            ('plain', 'plain(bytes)'),
+            ('salted', 'salted(bytes,bytes32)'),
+        ]:
+            salted = method == 'salted'
+            for init, success, returned in [
+                ('60006000f3', True, b''),
+                ('60006000fd', False, b''),
+                ('63deadbeef6000526004601cfd', False, bytes.fromhex('deadbeef')),
+            ]:
+                code = bytes.fromhex(init)
+                salt = 2**255 + 27
+                data = (
+                    evm['methodIdentifiers'][sig]
+                    + f'{64 if salted else 32:064x}'
+                    + (f'{salt:064x}' if salted else '')
+                    + f'{len(code):064x}'
+                    + init.ljust(64, '0')
+                )
+                try:
+                    output = replay.rpc(
+                        url,
+                        'eth_call',
+                        [{'to': address, 'data': '0x' + data}, 'latest'],
+                    )
+                except RuntimeError as exc:
+                    if (
+                        not salted
+                        or success
+                        or not returned
+                        or exc.args[0]['data'] != '0x' + returned.hex()
+                    ):
+                        raise
+                    created = 0
+                else:
+                    created = int(output, 16)
+                    if (
+                        len(output) != 66
+                        or bool(created) != success
+                        or (salted and returned)
+                    ):
+                        raise AssertionError(output)
+                cases.append(
+                    f'("{method}", {list(code)}, {salt}, {created}, {list(returned)})'
+                )
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Create.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + lean
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Creation.importedSourceUnit "CreationProbe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  let self : Nat := """
+            + str(int(address, 16))
+            + """
+  for (method, code, salt, address, output) in (["""
+            + ',\n'.join(cases)
+            + """] : List (String × List Nat × Nat × Nat × List Nat)) do
+    let salted := method == "salted"
+    let args : List Source.Value := [.bytes code] ++ (if salted then [.fixedBytes 32 salt] else [])
+    let some tree := TypeCheck.CheckedContract.callFunctionWithContextTree 50000 c method {Source.Context.empty with self := self} Source.State.empty args
+      | throw (IO.userError "missing function")
+    match tree with
+    | .request (.external world (.create request)) resume =>
+      unless Source.byteArrayToBytes request.initCode == code &&
+             Source.addressToWord request.creator == self && request.value.toNat == 0 &&
+             request.salt.map Source.u256ToWord == (if salted then some salt else none) &&
+             (match request.kind with | .create2 => salted | .create => !salted) do
+        throw (IO.userError "wrong initialization code, creator, value, opcode or salt")
+      let after := resume {address := Source.wordToU256 address, returnData := Source.bytesToByteArray output,
+                           postWorld := world, returnedGas := Source.wordToU256 0}
+      match after with
+      | .done (.ok (.returned _ [.word v])) =>
+        unless v == address && (!salted || output.isEmpty) do throw (IO.userError "wrong create return")
+      | .done (.ok (.reverted _ (.raw bytes))) =>
+        unless salted && address == 0 && !output.isEmpty && bytes == output do throw (IO.userError "wrong create revert")
+      | _ => throw (IO.userError "unexpected continuation")
+    | _ => throw (IO.userError "expected create interaction")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'{len(cases)} raw CREATE/CREATE2 requests and return/revert continuations matched'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
diff --git a/prototypes/source/discarded_bool.py b/prototypes/source/discarded_bool.py
