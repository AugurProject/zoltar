+++ b/prototypes/source/MulDiv.lean.in
@@ -0,0 +1,29 @@
+
+open SolidCore.Solidity
+
+def main (args : List String) : IO Unit := do
+  let [file] := args | throw (IO.userError "usage: Probe <inputs>")
+  let contract ← match TypeCheck.CheckedInput.contract MulDiv.importedSourceUnit "MulDivProbe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError s!"source lowering: {repr e}")
+  for line in ← IO.FS.lines file do
+    let mode :: inputs := line.splitOn " " | throw (IO.userError "missing mode")
+    let vals ← inputs.mapM fun v => match v.toNat? with
+      | some n => pure (Source.Value.word n)
+      | none => throw (IO.userError "bad word")
+    let (name, vals) := if mode == "-2" then ("scalar", vals) else if mode == "-1" then ("floor", vals) else ("rounded", vals ++ [.word (mode.toNat?.getD 255)])
+    match TypeCheck.CheckedContract.callFunctionWithContext 5000 contract name Source.Context.empty Source.State.empty vals with
+    | .ok (.returned _ [.word n]) => IO.println s!"ok {n}"
+    | .ok (.reverted _ (.error message)) => IO.println s!"error {message}"
+    | .ok (.reverted _ (.panic n)) => IO.println s!"panic {n}"
+    | .ok (.reverted _ e) => throw (IO.userError s!"unexpected revert: {repr e}")
+    | .ok (.returned _ _) => throw (IO.userError "wrong ABI return shape")
+    | .error e => throw (IO.userError s!"call: {repr e}")
+
+  for size in [0, 1, 4, 31, 32, 33, 65] do
+    let bytes := List.range size
+    match TypeCheck.CheckedContract.callFunctionWithContext 5000 contract "bubble" Source.Context.empty Source.State.empty [.bytes bytes] with
+    | .ok (.reverted _ .empty) => if size != 0 then throw (IO.userError "lost revert bytes")
+    | .ok (.reverted _ (.raw out)) => if out != bytes || size == 0 then throw (IO.userError "wrong revert bytes")
+    | _ => throw (IO.userError s!"expected raw revert of length {size}")
+    IO.println s!"rethrew {size}"
diff --git a/prototypes/source/assembly.py b/prototypes/source/assembly.py
new file mode 100644
index 0000000000000000000000000000000000000000..b1de2f030bfc15575f1442f8cc89f1da75262521
--- /dev/null
+++ b/prototypes/source/assembly.py
@@ -0,0 +1,2439 @@
+"""Lower supported solc inline assembly ASTs to typed Solidity source AST nodes.
+
+Unsupported statements and external references are errors. This pass only reads
+solc's analyzed source tree. It never reads IR or bytecode.
+"""
+
+from copy import deepcopy
+
+
+class Unsupported(ValueError):
+    pass
+
+
+def walk(node):
+    if isinstance(node, dict):
+        yield node
+        for value in node.values():
+            yield from walk(value)
+    elif isinstance(node, list):
+        for value in node:
+            yield from walk(value)
+
+
+def n(node_type, **fields):
+    return {'nodeType': node_type, **fields}
+
+
+def ident(name):
+    return n('Identifier', name=name)
+
+
+def call(target, *args):
+    return n('FunctionCall', expression=target, arguments=list(args))
+
+
+def uint_type():
+    return n('ElementaryTypeName', name='uint256')
+
+
+def lit(value):
+    return call(
+        n('ElementaryTypeNameExpression', typeName=uint_type()),
+        n('Literal', kind='number', value=str(value)),
+    )
+
+
+def binary(op, left, right):
+    return n('BinaryOperation', operator=op, leftExpression=left, rightExpression=right)
+
+
+def choose(cond, yes, no):
+    return n('Conditional', condition=cond, trueExpression=yes, falseExpression=no)
+
+
+def variable(name):
+    return n(
+        'VariableDeclaration',
+        name=name,
+        typeName=uint_type(),
+        storageLocation='default',
+    )
+
+
+def word_bool(expr):
+    return choose(expr, lit(1), lit(0))
+
+
+def raw_rethrow(block, declarations):
+    """Recognize revert(add(data, 32), mload(data)) on one resolved bytes memory value."""
+    stmts = block['AST']['statements']
+    if len(stmts) != 1 or stmts[0]['nodeType'] != 'YulExpressionStatement':
+        return None
+
+    def args(node, op):
+        if node.get('functionName', {}).get('name') == op:
+            return node['arguments']
+        return []
+
+    operands = args(stmts[0]['expression'], 'revert')
+    if len(operands) != 2:
+        return None
+    start, length = args(operands[0], 'add'), args(operands[1], 'mload')
+    if len(start) != 2 or len(length) != 1:
+        return None
+    offset = start[1]
+    if offset.get('kind') != 'number' or int(offset['value'], 0) != 32:
+        return None
+    pointers = [start[0], length[0]]
+    refs = block['externalReferences']
+    if (
+        len(refs) != 2
+        or any(p['nodeType'] != 'YulIdentifier' for p in pointers)
+        or {r['src'] for r in refs} != {p['src'] for p in pointers}
+        or len({r['declaration'] for r in refs}) != 1
+        or any(
+            r.get('suffix') or r['isSlot'] or r['isOffset'] or r['valueSize'] != 1
+            for r in refs
+        )
+    ):
+        return None
+    decl = declarations.get(refs[0]['declaration'], {})
+    if (
+        decl.get('storageLocation') == 'memory'
+        and decl.get('typeName', {}).get('name') == 'bytes'
+        and all(p['name'] == decl['name'] for p in pointers)
+    ):
+        return n(
+            'RevertStatement',
+            errorCall=call(ident('#yul.rethrow'), ident(decl['name'])),
+        )
+    return None
+
+
+def yul_expr(node):
+    if not isinstance(node, dict):
+        return None
+    kind = node['nodeType']
+    if kind == 'YulIdentifier':
+        return node['name']
+    if kind == 'YulLiteral' and node['kind'] == 'number':
+        return int(node['value'], 0)
+    if kind == 'YulFunctionCall':
+        return (node['functionName']['name'], *(yul_expr(a) for a in node['arguments']))
+    return None
+
+
+def return_prefixed_code(block, declarations):
+    """RETURN the byte before a bytes payload and the complete payload."""
+    stmts = block['AST']['statements']
+    if len(stmts) != 3:
+        return None
+    length, store, ret = stmts
+    if (
+        length['nodeType'] != 'YulVariableDeclaration'
+        or len(length['variables']) != 1
+        or any(s['nodeType'] != 'YulExpressionStatement' for s in (store, ret))
+    ):
+        return None
+    count = length['variables'][0]['name']
+    size = yul_expr(length.get('value'))
+    if not isinstance(size, tuple) or len(size) != 2 or size[0] != 'mload':
+        return None
+    data = size[1]
+    if not isinstance(data, str) or data == count:
+        return None
+    start = ('add', data, 31)
+    if yul_expr(store['expression']) != ('mstore8', start, 0) or yul_expr(
+        ret['expression']
+    ) != ('return', start, ('add', count, 1)):
+        return None
+    uses = {
+        v['src']
+        for v in walk(stmts)
+        if v.get('nodeType') == 'YulIdentifier' and v['name'] == data
+    }
+    refs = block['externalReferences']
+    if (
+        len(uses) != 3
+        or {r['src'] for r in refs} != uses
+        or len({r['declaration'] for r in refs}) != 1
+    ):
+        return None
+    if any(
+        r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+        for r in refs
+    ):
+        return None
+    var = declarations.get(refs[0]['declaration'], {})
+    if (
+        var.get('name') != data
+        or var.get('storageLocation') != 'memory'
+        or var.get('typeName', {}).get('name') != 'bytes'
+    ):
+        return None
+    return n(
+        'ExpressionStatement',
+        expression=call(ident('#yul.returnPrefixedCode'), ident(data)),
+    )
+
+
+def bind_raw_slot(block, declarations):
+    stmts = block['AST']['statements']
+    if (
+        len(stmts) != 1
+        or stmts[0]['nodeType'] != 'YulAssignment'
+        or len(stmts[0]['variableNames']) != 1
+    ):
+        return None
+    lhs, rhs = stmts[0]['variableNames'][0], stmts[0]['value']
+    if rhs.get('nodeType') != 'YulIdentifier':
+        return None
+    refs = {r['src']: r for r in block['externalReferences']}
+    if set(refs) != {lhs['src'], rhs['src']}:
+        return None
+    dest, src = [refs[n['src']] for n in (lhs, rhs)]
+    var, slot = [declarations.get(r['declaration'], {}) for r in (dest, src)]
+    if (
+        not dest['isSlot']
+        or dest.get('suffix') != 'slot'
+        or any(r['isOffset'] or r['valueSize'] != 1 for r in (dest, src))
+        or var.get('storageLocation') != 'storage'
+        or var.get('stateVariable')
+        or slot.get('stateVariable')
+        or lhs['name'] != var.get('name', '') + '.slot'
+    ):
+        return None
+    if (
+        src['isSlot']
+        and src.get('suffix') == 'slot'
+        and slot.get('storageLocation') == 'storage'
+        and rhs['name'] == slot['name'] + '.slot'
+    ):
+        base = call(ident('#yul.slotOf'), ident(slot['name']))
+    elif (
+        not src['isSlot']
+        and not src.get('suffix')
+        and slot.get('typeName', {}).get('name') == 'bytes32'
+        and rhs['name'] == slot['name']
+    ):
+        base = ident(slot['name'])
+    else:
+        return None
+    return n(
+        'ExpressionStatement',
+        expression=n(
+            'Assignment',
+            operator='=',
+            leftHandSide=ident(var['name']),
+            rightHandSide=call(ident('#yul.slot'), base),
+        ),
+    )
+
+
+def raw_create(block, declarations):
+    """Import zero-value CREATE/CREATE2 of an entire bytes-memory argument."""
+    statements = block['AST']['statements']
+    if not statements or len(statements) > 2:
+        return None
+    first = statements[0]
+    if first['nodeType'] != 'YulAssignment' or len(first['variableNames']) != 1:
+        return None
+    create = yul_expr(first['value'])
+    if not isinstance(create, tuple) or create[0] not in ('create', 'create2'):
+        return None
+    if len(create) != (5 if create[0] == 'create2' else 4):
+        return None
+    _, amount, start, size, *salt = create
+    if not isinstance(size, tuple) or len(size) != 2 or size[0] != 'mload':
+        return None
+    code = size[1]
+    if not isinstance(code, str) or amount != 0 or start != ('add', code, 32):
+        return None
+    output = first['variableNames'][0]['name']
+    if salt and not isinstance(salt[0], str):
+        return None
+    marker = '#yul.create'
+    revert_even_if_empty = False
+    if len(statements) == 2:
+        condition = statements[1]
+        if condition['nodeType'] != 'YulIf':
+            return None
+        body = condition['body']['statements']
+        cond = yul_expr(condition['condition'])
+
+        def declaration(stmt):
+            if (
+                stmt['nodeType'] == 'YulVariableDeclaration'
+                and len(stmt['variables']) == 1
+            ):
+                return stmt['variables'][0]['name'], yul_expr(stmt.get('value'))
+            return None, None
+
+        if cond == ('and', ('iszero', output), ('gt', ('returndatasize',), 0)):
+            length = ('returndatasize',)
+        elif (
+            cond == ('iszero', output)
+            and len(body) == 2
+            and body[1]['nodeType'] == 'YulIf'
+        ):
+            length, expr = declaration(body[0])
+            if (
+                not length
+                or expr != ('returndatasize',)
+                or yul_expr(body[1]['condition']) != ('gt', length, 0)
+            ):
+                return None
+            body = body[1]['body']['statements']
+        elif cond == ('iszero', output) and len(body) == 4:
+            length, expr = declaration(body[0])
+            if not length or expr != ('returndatasize',):
+                return None
+            body = body[1:]
+            revert_even_if_empty = True
+        else:
+            return None
+        if len(body) != 3 or any(
+            s['nodeType'] != 'YulExpressionStatement' for s in body[1:]
+        ):
+            return None
+        ptr, expr = declaration(body[0])
+        if (
+            not ptr
+            or expr != ('mload', 64)
+            or yul_expr(body[1]['expression']) != ('returndatacopy', ptr, 0, length)
+            or yul_expr(body[2]['expression']) != ('revert', ptr, length)
+        ):
+            return None
+        marker = '#yul.createBubble'
+    expected = {
+        code: 'bytes',
+        output: 'address',
+        **({salt[0]: 'bytes32'} if salt else {}),
+    }
+    external = {r['src']: r for r in block['externalReferences']}
+    needed = {
+        n['src']: n['name']
+        for n in walk(block['AST'])
+        if n.get('nodeType') == 'YulIdentifier' and n['name'] in expected
+    }
+    if external.keys() != needed.keys():
+        return None
+    for src, ref in external.items():
+        name = needed[src]
+        decl = declarations.get(ref['declaration'], {})
+        if (
+            decl.get('name') != name
+            or decl.get('stateVariable')
+            or decl.get('typeName', {}).get('name') != expected[name]
+            or (name == code and decl.get('storageLocation') != 'memory')
+            or ref.get('suffix')
+            or ref['isSlot']
+            or ref['isOffset']
+            or ref['valueSize'] != 1
+        ):
+            return None
+    assignment = n(
+        'ExpressionStatement',
+        expression=n(
+            'Assignment',
+            operator='=',
+            leftHandSide=ident(output),
+            rightHandSide=call(ident(marker), ident(code), *(ident(x) for x in salt)),
+        ),
+    )
+
+    if revert_even_if_empty:
+        zero = call(
+            n(
+                'ElementaryTypeNameExpression',
+                typeName=n('ElementaryTypeName', name='address'),
+            ),
+            n('Literal', kind='number', value='0'),
+        )
+        failure = n(
+            'IfStatement',
+            condition=binary('==', ident(output), zero),
+            trueBody=n('ExpressionStatement', expression=call(ident('revert'))),
+        )
+        return n('Block', statements=[assignment, failure])
+    return assignment
+
+
+def clone_code_fields(block, declarations, known_lengths):
+    """Decode consecutive big-endian fields copied from the current account's code."""
+    if block.get('flags') != ['memory-safe']:
+        return None
+
+    statements = list(block['AST']['statements'])
+    if not statements:
+        return None
+    ptr = 0
+    if statements[0]['nodeType'] == 'YulVariableDeclaration':
+        declaration = statements.pop(0)
+        if (
+            yul_expr(declaration.get('value')) != ('mload', 64)
+            or len(declaration['variables']) != 1
+        ):
+            return None
+        ptr = declaration['variables'][0]['name']
+    if len(statements) < 2 or statements[0]['nodeType'] != 'YulExpressionStatement':
+        return None
+    copy_expr = statements.pop(0)['expression']
+    copy = yul_expr(copy_expr)
+    if (
+        not isinstance(copy, tuple)
+        or len(copy) != 5
+        or copy[:3] != ('extcodecopy', ('address',), ptr)
+    ):
+        return None
+    offset, count = copy[3:]
+    if isinstance(count, str):
+        size_arg = copy_expr['arguments'][3]
+        size_ref = next(
+            (r for r in block['externalReferences'] if r['src'] == size_arg['src']), {}
+        )
+        count = known_lengths.get(size_ref.get('declaration'))
+    if (
+        not isinstance(offset, str)
+        or not isinstance(count, int)
+        or count > (32 if ptr == 0 else 256)
+    ):
+        return None
+    refs = {}
+    for ref in block['externalReferences']:
+        decl = declarations.get(ref['declaration'], {})
+        if (
+            ref.get('suffix')
+            or ref['isSlot']
+            or ref['isOffset']
+            or ref['valueSize'] != 1
+            or decl.get('stateVariable')
+            or not decl.get('name')
+        ):
+            return None
+        refs[ref['src']] = decl
+    builtins = {
+        v['functionName']['src']
+        for v in walk(block['AST'])
+        if v.get('nodeType') == 'YulFunctionCall'
+    }
+    expected_refs = {
+        v['src']
+        for v in walk(block['AST'])
+        if v.get('nodeType') == 'YulIdentifier'
+        and v['name'] != ptr
+        and v['src'] not in builtins
+    }
+    if refs.keys() != expected_refs:
+        return None
+    bindings = {}
+    for node in walk(block['AST']):
+        if node.get('src') in refs:
+            decl = refs[node['src']]
+            if decl['name'] != node.get('name'):
+                return None
+            bindings[decl['name']] = decl.get('typeDescriptions', {}).get('typeString')
+    if bindings.get(offset) != 'uint256':
+        return None
+    fields = []
+    pos = 0
+    for stmt in statements:
+        if stmt['nodeType'] != 'YulAssignment' or len(stmt['variableNames']) != 1:
+            return None
+        name = stmt['variableNames'][0]['name']
+        if name == offset or any(name == f[0] for f in fields):
+            return None
+        target = bindings.get(name)
+        if target not in ('address', 'uint248', 'uint256'):
+            return None
+        width = {'address': 20, 'uint248': 31, 'uint256': 32}[target]
+        load = ('mload', ptr if pos == 0 else ('add', ptr, pos))
+        expected = load if width == 32 else ('shr', (32 - width) * 8, load)
+        if yul_expr(stmt['value']) != expected:
+            return None
+        fields.append((name, target, width))
+        pos += width
+    if pos != count:
+        return None
+
+    def cast(typ, value):
+        return call(
+            n(
+                'ElementaryTypeNameExpression',
+                typeName=n('ElementaryTypeName', name=typ),
+            ),
+            value,
+        )
+
+    def local(name, value):
+        return n(
+            'VariableDeclarationStatement',
+            declarations=[variable(name)],
+            initialValue=value,
+        )
+
+    def assign(name, value):
+        return n(
+            'ExpressionStatement',
+            expression=n(
+                'Assignment',
+                operator='=',
+                leftHandSide=ident(name),
+                rightHandSide=value,
+            ),
+        )
+
+    def member(value, name):
+        return n('MemberAccess', expression=value, memberName=name)
+
+    code = member(cast('address', ident('this')), 'code')
+    code_name = '#extcode'
+    decl = variable(code_name)
+    decl.update(
+        typeName=n('ElementaryTypeName', name='bytes'), storageLocation='memory'
+    )
+    result = [n('VariableDeclarationStatement', declarations=[decl], initialValue=code)]
+    index = '#extindex'
+    word = '#extword'
+    result.extend([local(index, lit(0)), local(word, lit(0))])
+    pos = 0
+    for name, typ, width in fields:
+        pos += width
+        # EXTCODECOPY zero-fills beyond the end. Compare before addition to
+        # avoid interpreting a huge source offset as wrapping back into code.
+        size = member(ident(code_name), 'length')
+        present = binary(
+            '&&',
+            binary('<', ident(offset), size),
+            binary('<', ident(index), binary('-', size, ident(offset))),
+        )
+        byte = n(
+            'IndexAccess',
+            baseExpression=ident(code_name),
+            indexExpression=binary('+', ident(offset), ident(index)),
+        )
+        next_word = binary(
+            '|',
+            binary('<<', ident(word), lit(8)),
+            choose(present, cast('uint256', cast('uint8', byte)), lit(0)),
+        )
+        result.append(assign(word, lit(0)))
+        result.append(
+            n(
+                'WhileStatement',
+                condition=binary('<', ident(index), lit(pos)),
+                body=n(
+                    'Block',
+                    statements=[
+                        assign(word, next_word),
+                        assign(index, binary('+', ident(index), lit(1))),
+                    ],
+                ),
+            )
+        )
+        value = (
+            cast('address', cast('uint160', ident(word)))
+            if typ == 'address'
+            else cast(typ, ident(word))
+        )
+        result.append(assign(name, value))
+    return n('Block', statements=result)
+
+
+def canonical_yul_bool(expr):
+    """Prove the result word is 0 or 1 from its expression tree."""
+    if expr['nodeType'] == 'YulLiteral' and expr['kind'] == 'number':
+        return int(expr['value'], 0) in (0, 1)
+    if expr['nodeType'] != 'YulFunctionCall':
+        return False
+    op = expr['functionName']['name']
+    if op in ('iszero', 'eq', 'lt', 'gt'):
+        return True
+    if op == 'and':
+        return any(canonical_yul_bool(a) for a in expr['arguments'])
+    if op in ('or', 'xor'):
+        return all(canonical_yul_bool(a) for a in expr['arguments'])
+    return False
+
+
+def log_memory_bytes(block, declarations):
+    """LOG4 over the complete contents of a bytes-memory local and four stack words."""
+    stmts = block['AST']['statements']
+    if len(stmts) != 1 or stmts[0].get('nodeType') != 'YulExpressionStatement':
+        return None
+    emit = stmts[0]['expression']
+    if (
+        emit.get('functionName', {}).get('name') != 'log4'
+        or len(emit['arguments']) != 6
+    ):
+        return None
+    start, size, *topics = emit['arguments']
+    length = yul_expr(size)
+    if not isinstance(length, tuple) or len(length) != 2 or length[0] != 'mload':
+        return None
+    if not isinstance(length[1], str) or yul_expr(start) != ('add', length[1], 32):
+        return None
+    refs = {r['src']: r for r in block['externalReferences']}
+    uses = [start['arguments'][0], size['arguments'][0], *topics]
+    if any(v.get('nodeType') != 'YulIdentifier' for v in uses) or set(refs) != {
+        v['src'] for v in uses
+    }:
+        return None
+    if refs[uses[0]['src']]['declaration'] != refs[uses[1]['src']]['declaration']:
+        return None
+    for use, typ in zip(
+        uses, ('bytes', 'bytes', 'bytes32', 'uint256', 'uint256', 'address')
+    ):
+        ref = refs[use['src']]
+        decl = declarations.get(ref['declaration'], {})
+        if (
+            ref['isSlot']
+            or ref['isOffset']
+            or ref.get('suffix')
+            or ref['valueSize'] != 1
+            or decl.get('name') != use['name']
+            or decl.get('stateVariable')
+            or decl.get('typeName', {}).get('name') != typ
+            or (typ == 'bytes' and decl.get('storageLocation') != 'memory')
+        ):
+            return None
+    return n(
+        'ExpressionStatement',
+        expression=call(ident('#yul.log4'), *(ident(v['name']) for v in uses[1:])),
+    )
+
+
+def calldata_word(load, refs, declarations, structs, *, bool_only=False):
+    """Resolve CALLDATALOAD of a scalar word in a calldata struct's head."""
+    if (
+        load.get('functionName', {}).get('name') != 'calldataload'
+        or len(load['arguments']) != 1
+    ):
+        return None
+    head = load['arguments'][0]
+    offset = 0
+    if (
+        head.get('functionName', {}).get('name') == 'add'
+        and len(head['arguments']) == 2
+    ):
+        head, displacement = head['arguments']
+        offset = yul_expr(displacement)
+    if (
+        head.get('nodeType') != 'YulIdentifier'
+        or not isinstance(offset, int)
+        or offset % 32
+    ):
+        return None
+    ref = refs.get(head['src'], {})
+    decl = declarations.get(ref.get('declaration'), {})
+    if decl.get('name') != head['name'] or decl.get('storageLocation') != 'calldata':
+        return None
+    fields = structs.get(decl.get('typeName', {}).get('referencedDeclaration'), {}).get(
+        'members', []
+    )
+    ordinal = offset // 32
+    if ordinal >= len(fields):
+        return None
+    ty = fields[ordinal]['typeDescriptions']['typeIdentifier']
+    if ty != 't_bool' and (
+        bool_only
+        or not (ty.startswith('t_uint') or ty in ('t_address', 't_address_payable'))
+    ):
+        return None
+    if any(f['typeName']['nodeType'] != 'ElementaryTypeName' for f in fields[:ordinal]):
+        return None
+    return (
+        call(
+            ident('#yul.calldataWord'),
+            ident(decl['name']),
+            n('Literal', kind='number', value=str(ordinal)),
+        ),
+        head['src'],
+    )
+
+
+def fresh_array_revert_tail(fn, referenced):
+    """Identify zero-slot bytes and the high bytes of the first array's length.
+
+    On an external entry, memory[0x60:0x80] is the zero slot and the free
+    pointer starts at 0x80. The bounded dynamic-array length occupies its
+    first word. Typed element writes and external calls preserve that header.
+    """
+    if (
+        fn.get('kind') != 'function'
+        or fn.get('modifiers')
+        or fn.get('virtual')
+        or fn.get('baseFunctions')
+        or fn.get('overrides')
+        or fn.get('id') in referenced
+        or fn.get('visibility') not in ('external', 'public')
+        or not fn.get('body')
+    ):
+        return False
+    params, returns = (
+        fn['parameters']['parameters'],
+        fn['returnParameters']['parameters'],
+    )
+    if (
+        len(params) != 1
+        or len(returns) != 1
+        or params[0]['storageLocation'] != 'calldata'
+        or returns[0]['storageLocation'] != 'memory'
+    ):
+        return False
+    if any(
+        v['typeName'].get('nodeType') != 'ArrayTypeName' or v['typeName'].get('length')
+        for v in (params[0], returns[0])
+    ):
+        return False
+    body = fn['body']['statements']
+    # Read an unallocated scalar accumulator and the calldata array length
+    # before allocating the only named return. Neither needs a memory object.
+    if len(body) < 4:
+        return False
+    accumulator, length = body[0:2]
+
+    def word_local(s):
+        ds = s.get('declarations', [])
+        return (
+            len(ds) == 1
+            and ds[0]
+            and ds[0].get('typeDescriptions', {}).get('typeIdentifier') == 't_uint256'
+        )
+
+    init = length.get('initialValue') or {}
+    if (
+        not word_local(accumulator)
+        or accumulator.get('initialValue')
+        or not word_local(length)
+        or init.get('memberName') != 'length'
+        or init['expression'].get('referencedDeclaration') != params[0]['id']
+    ):
+        return False
+    assignment = body[2].get('expression', {})
+    make = assignment.get('rightHandSide', {})
+    if (
+        assignment.get('operator') != '='
+        or assignment.get('leftHandSide', {}).get('referencedDeclaration')
+        != returns[0]['id']
+        or make.get('expression', {}).get('nodeType') != 'NewExpression'
+        or make['expression'].get('typeName', {}).get('nodeType') != 'ArrayTypeName'
+        or len(make.get('arguments', [])) != 1
+        or make['arguments'][0].get('referencedDeclaration')
+        != length['declarations'][0]['id']
+    ):
+        return False
+    nodes = list(walk(fn['body']))
+    asm = [v for v in nodes if v.get('nodeType') == 'InlineAssembly']
+    if (
+        len(asm) != 1
+        or asm[0].get('flags')
+        or not any(node is asm[0] for node in walk(body[3:]))
+    ):
+        return False
+    for v in nodes:
+        if v.get('function') or v.get('nodeType') == 'ModifierInvocation':
+            return False
+        if v.get('nodeType') == 'FunctionCall' and v is not make:
+            t = v['expression'].get('typeDescriptions', {}).get('typeIdentifier', '')
+            if not t.startswith(('t_function_barecall_', 't_function_require_')):
+                return False
+    return True
+
+
+def reject_failed_call(block, declarations, structs, fresh_array):
+    """Recover a constant REVERT guarded by a raw calldata bool and the result's first word."""
+    ops = block['AST']['statements']
+    if len(ops) != 1 or ops[0]['nodeType'] != 'YulIf':
+        return None
+
+    def args(node, name, count):
+        values = node.get('arguments', [])
+        return (
+            values
+            if node.get('functionName', {}).get('name') == name and len(values) == count
+            else None
+        )
+
+    zero = args(ops[0]['condition'], 'iszero', 1)
+    either = args(zero[0], 'or', 2) if zero else None
+    if not either:
+        return None
+    mem = args(either[1], 'mload', 1)
+    if not mem or mem[0].get('nodeType') != 'YulIdentifier':
+        return None
+    refs = {r['src']: r for r in block['externalReferences']}
+    if any(
+        r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+        for r in refs.values()
+    ):
+        return None
+    raw = calldata_word(either[0], refs, declarations, structs, bool_only=True)
+    if not raw or set(refs) != {raw[1], mem[0]['src']}:
+        return None
+    dec = declarations.get(refs[mem[0]['src']]['declaration'], {})
+    fields = structs.get(dec.get('typeName', {}).get('referencedDeclaration'), {}).get(
+        'members', []
+    )
+    if (
+        dec.get('name') != mem[0]['name']
+        or dec.get('storageLocation') != 'memory'
+        or not fields
+        or fields[0]['typeName'].get('name') != 'bool'
+    ):
+        return None
+    branch = ops[0]['body']['statements']
+    if not branch or any(s['nodeType'] != 'YulExpressionStatement' for s in branch):
+        return None
+    # The extra word of aggregate3Value spans the zero slot (28 bytes)
+    # and the high four bytes of its length word. Other frames must prove
+    # every returned byte from explicit writes.
+    written = dict.fromkeys(range(0x64, 0x84), 0) if fresh_array else {}
+    for stmt in branch[:-1]:
+        match yul_expr(stmt['expression']):
+            case ('mstore', int(at), int(word)) if (
+                0 <= at < 4096 and 0 <= word < 1 << 256
+            ):
+                written.update(enumerate(word.to_bytes(32, 'big'), at))
+            case _:
+                return None
+    match yul_expr(branch[-1]['expression']):
+        case ('revert', int(start), int(size)) if start >= 0 and 0 <= size <= 4096:
+            if not all(i in written for i in range(start, start + size)):
+                return None
+        case _:
+            return None
+    payload = bytes(written[i] for i in range(start, start + size))
+    data = call(
+        n(
+            'ElementaryTypeNameExpression',
+            typeName=n('ElementaryTypeName', name='bytes'),
+        ),
+        n('Literal', kind='hexString', hexValue=payload.hex()),
+    )
+    success = n(
+        'MemberAccess', expression=ident(dec['name']), memberName=fields[0]['name']
+    )
+    return n(
+        'IfStatement',
+        condition=binary(
+            '&&',
+            binary('==', raw[0], lit(0)),
+            n('UnaryOperation', operator='!', prefix=True, subExpression=success),
+        ),
+        trueBody=n('RevertStatement', errorCall=call(ident('#yul.rethrow'), data)),
+    )
+
+
+def read_calldata_word(block, declarations, structs):
+    ops = block['AST']['statements']
+    if (
+        len(ops) != 1
+        or ops[0]['nodeType'] != 'YulAssignment'
+        or len(ops[0]['variableNames']) != 1
+    ):
+        return None
+    refs = {r['src']: r for r in block['externalReferences']}
+    if any(
+        r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+        for r in refs.values()
+    ):
+        return None
+    raw = calldata_word(ops[0]['value'], refs, declarations, structs)
+    if not raw:
+        return None
+    word, src = raw
+    lhs = ops[0]['variableNames'][0]
+    dest = declarations.get(refs.get(lhs['src'], {}).get('declaration'), {})
+    if (
+        set(refs) != {src, lhs['src']}
+        or dest.get('name') != lhs['name']
+        or dest.get('stateVariable')
+        or dest.get('typeDescriptions', {}).get('typeIdentifier') != 't_uint256'
+    ):
+        return None
+    return n(
+        'ExpressionStatement',
+        expression=n(
+            'Assignment',
+            operator='=',
+            leftHandSide=ident(lhs['name']),
+            rightHandSide=word,
+        ),
+    )
+
+
+def mapping_scratch_key(stmt, by_id):
+    """The static-key mapping slot helper hashes key || baseSlot in scratch."""
+    assignment = stmt.get('expression') or {}
+    lhs = assignment.get('leftHandSide', {})
+    base = lhs.get('baseExpression', {})
+    key = lhs.get('indexExpression') or {}
+    rhs = assignment.get('rightHandSide', {})
+    mapping = by_id.get(base.get('referencedDeclaration'), {})
+    key_decl = by_id.get(key.get('referencedDeclaration'), {})
+    if (
+        assignment.get('operator') != '='
+        or lhs.get('nodeType') != 'IndexAccess'
+        or base.get('nodeType') != 'Identifier'
+        or not mapping.get('stateVariable')
+        or mapping.get('typeName', {}).get('nodeType') != 'Mapping'
+        or mapping['typeName']['keyType']['typeDescriptions']['typeIdentifier']
+        != 't_uint256'
+        or mapping['typeName']['valueType']['typeDescriptions']['typeIdentifier']
+        != 't_uint256'
+        or key.get('nodeType') != 'Identifier'
+        or key_decl.get('nodeType') != 'VariableDeclaration'
+        or key_decl.get('stateVariable')
+        or key['typeDescriptions']['typeIdentifier'] != 't_uint256'
+        or rhs.get('kind') != 'number'
+    ):
+        return None
+    return ident(key['name'])
+
+
+def scratch_from_internal_caller(ast):
+    """Certify a first scratch word initialized in every direct caller's frame."""
+    declarations = [
+        node for node in walk(ast) if node.get('nodeType') == 'FunctionDefinition'
+    ]
+    by_id = {node['id']: node for node in walk(ast) if 'id' in node}
+
+    def forwarded(arg, param):
+        ty = arg.get('typeDescriptions', {}).get('typeIdentifier', '')
+        variable = by_id.get(arg.get('referencedDeclaration'), {})
+        return (
+            arg.get('nodeType') == 'Identifier'
+            and variable.get('nodeType') == 'VariableDeclaration'
+            and not variable.get('stateVariable')
+            and ty == param.get('typeDescriptions', {}).get('typeIdentifier')
+            and (
+                ty in ('t_bytes_memory_ptr', 't_address', 't_bool', 't_uint256')
+                or ty.startswith('t_contract$')
+            )
+        )
+
+    all_uses = {}
+    for node in walk(ast):
+        if 'referencedDeclaration' in node and 'id' in node:
+            all_uses.setdefault(node['referencedDeclaration'], set()).add(node['id'])
+    initialized_calls = set()
+    mapping_calls = {}
+    for fn in declarations:
+        for parent in walk(fn.get('body')):
+            if parent.get('nodeType') not in ('Block', 'UncheckedBlock'):
+                continue
+            statements = parent['statements']
+            for previous, stmt in zip(statements, statements[1:]):
+                if stmt.get('nodeType') not in ('Return', 'ExpressionStatement'):
+                    continue
+                key = mapping_scratch_key(previous, by_id)
+                if key is None:
+                    if previous.get('nodeType') != 'InlineAssembly':
+                        continue
+                    ops = previous['AST']['statements']
+                    if not ops or ops[-1].get('nodeType') != 'YulExpressionStatement':
+                        continue
+                    store = yul_expr(ops[-1]['expression'])
+                    if not isinstance(store, tuple) or store[:2] != ('mstore', 0):
+                        continue
+                invocation = stmt.get('expression') or {}
+                method = invocation.get('expression', {})
+                fn_args = (
+                    by_id.get(method.get('referencedDeclaration'), {})
+                    .get('parameters', {})
+                    .get('parameters', [])
+                )
+                if (
+                    invocation.get('nodeType') == 'FunctionCall'
+                    and invocation.get('kind') == 'functionCall'
+                    and not invocation.get('names')
+                    and method.get('nodeType') == 'Identifier'
+                    and len(invocation['arguments']) == len(fn_args)
+                    and all(
+                        forwarded(arg, param)
+                        for arg, param in zip(invocation['arguments'], fn_args)
+                    )
+                ):
+                    initialized_calls.add(method['id'])
+                    if key:
+                        mapping_calls[method['id']] = (previous, key)
+    blocks = set()
+    for fn in declarations:
+        uses = all_uses.get(fn.get('id'), set())
+        if (
+            fn.get('visibility') != 'private'
+            or not uses
+            or not uses.issubset(initialized_calls)
+            or fn.get('modifiers')
+        ):
+            continue
+        for stmt in (fn.get('body') or {}).get('statements', []):
+            if stmt.get('nodeType') == 'InlineAssembly':
+                blocks.add(stmt['id'])
+                for site in uses & mapping_calls.keys():
+                    previous, key = mapping_calls[site]
+                    assignment = dict(previous)
+                    remember = n(
+                        'ExpressionStatement',
+                        expression=call(
+                            ident('#yul.scratchStore'),
+                            n('Literal', kind='number', value='0'),
+                            key,
+                        ),
+                    )
+                    previous.clear()
+                    previous.update(n('Block', statements=[assignment, remember]))
+                break
+            if (
+                stmt.get('nodeType') != 'VariableDeclarationStatement'
+                or stmt.get('initialValue')
+                or any(
+                    not decl
+                    or decl.get('typeDescriptions', {}).get('typeIdentifier')
+                    not in ('t_bool', 't_uint256')
+                    for decl in stmt['declarations']
+                )
+            ):
+                break
+    return blocks
+
+
+def lower_block(
+    block, declarations, known_lengths, structs, fresh_array, known_scratch=False
+):
+    if set(block.get('flags', [])) - {'memory-safe'}:
+        raise Unsupported('assembly flags')
+    ops = block['AST']['statements']
+    if (
+        not block['externalReferences']
+        and len(ops) == 1
+        and ops[0].get('nodeType') == 'YulExpressionStatement'
+        and yul_expr(ops[0].get('expression')) == ('invalid',)
+    ):
+        return n('RevertStatement', errorCall=call(ident('#yul.invalid'))), {
+            '#yul.invalid'
+        }
+    guard = reject_failed_call(block, declarations, structs, fresh_array)
+    if guard:
+        return guard, {'#yul.rethrow'}
+    raw = read_calldata_word(block, declarations, structs)
+    if raw:
+        return raw, set()
+    event = log_memory_bytes(block, declarations)
+    if event:
+        return event, set()
+    code = return_prefixed_code(block, declarations)
+    if code:
+        return code, set()
+    bind = bind_raw_slot(block, declarations)
+    if bind:
+        return bind, set()
+    create = raw_create(block, declarations)
+    if create:
+        return create, set()
+    fields = clone_code_fields(block, declarations, known_lengths)
+    if fields:
+        return fields, set()
+    rethrow = raw_rethrow(block, declarations)
+    if rethrow:
+        return rethrow, {'#yul.rethrow'}
+    # Trace the two pointer operands of a bounded CALL separately. They are
+    # not arithmetic words and cannot be used anywhere else in the block.
+    pointers = {}
+    for stmt in ops:
+        invoke = stmt.get('value', {})
+        if invoke.get('functionName', {}).get('name') != 'call':
+            continue
+        args = invoke['arguments']
+        if len(args) != 7 or args[1]['nodeType'] != 'YulIdentifier':
+            continue
+        addr = args[1]
+        start = args[3].get('arguments', [])
+        length = args[4].get('arguments', [])
+        if (
+            len(start) != 2
+            or len(length) != 1
+            or start[0]['nodeType'] != 'YulIdentifier'
+        ):
+            continue
+        data = start[0]['name']
+        if yul_expr(invoke) != (
+            'call',
+            ('gas',),
+            addr['name'],
+            0,
+            ('add', data, 32),
+            ('mload', data),
+            0,
+            32,
+        ):
+            continue
+        pointers[addr['src']] = 'address'
+        for use in (start[0], length[0]):
+            pointers[use['src']] = 'bytes memory'
+    refs = {}
+    for r in block['externalReferences']:
+        decl = declarations.get(r['declaration'], {})
+        typ = decl.get('typeDescriptions', {}).get('typeString')
+        if (
+            not (
+                (r['src'] not in pointers and typ in ('uint256', 'bool'))
+                or (
+                    pointers.get(r['src']) == 'bytes memory'
+                    and typ == 'bytes'
+                    and decl.get('storageLocation') == 'memory'
+                )
+                or (
+                    pointers.get(r['src']) == 'address'
+                    and (typ == 'address' or str(typ).startswith('contract '))
+                )
+            )
+            or r.get('suffix')
+            or r['isSlot']
+            or r['isOffset']
+            or r['valueSize'] != 1
+            or decl.get('stateVariable')
+        ):
+            raise Unsupported(f'assembly outer binding {decl.get("name")} ({typ})')
+        refs[r['src']] = (decl['name'], typ)
+    initialized_scratch = set(range(32)) if known_scratch else set()
+
+    def scratch_offset(node, size):
+        offset = yul_expr(node)
+        if type(offset) is not int or not 0 <= offset <= 64 - size:
+            raise Unsupported('scratch access outside 0x00..0x3f')
+        return offset
+
+    locals_ = set()
+    used = set()
+
+    def binding(node):
+        name = node['name']
+        if node['src'] in refs:
+            bound, typ = refs[node['src']]
+            if bound != name:
+                raise Unsupported('assembly declaration/name mismatch')
+            used.add(node['src'])
+            return typ
+        if name not in locals_:
+            raise Unsupported(f'unbound assembly local {name}')
+        return 'uint256'
+
+    last_return = None
+
+    def expr(node):
+        kind = node['nodeType']
+        if kind == 'YulIdentifier':
+            return (
+                word_bool(ident(node['name']))
+                if binding(node) == 'bool'
+                else ident(node['name'])
+            )
+        if kind == 'YulLiteral' and node['kind'] == 'number':
+            return lit(int(node['value'], 0))
+        if kind != 'YulFunctionCall':
+            raise Unsupported(kind)
+        op = node['functionName']['name']
+        if op == 'returndatasize' and last_return is not None:
+            return n('MemberAccess', expression=ident(last_return), memberName='length')
+        if op == 'mload':
+            offset = scratch_offset(node['arguments'][0], 32)
+            if not initialized_scratch.issuperset(range(offset, offset + 32)):
+                raise Unsupported(
+                    'scratch word depends on memory before the assembly block'
+                )
+            return call(
+                ident('#yul.scratchLoad'),
+                n('Literal', kind='number', value=str(offset)),
+            )
+        args = [expr(arg) for arg in node['arguments']]
+        ops = {'add': '+', 'mul': '*', 'sub': '-', 'and': '&', 'or': '|', 'xor': '^'}
+        if op in ops:
+            return binary(ops[op], *args)
+        if op in ('eq', 'lt', 'gt'):
+            return word_bool(binary({'eq': '==', 'lt': '<', 'gt': '>'}[op], *args))
+        if op == 'byte':
+            index, word = args
+            shift = binary('*', binary('-', lit(31), index), lit(8))
+            return choose(
+                binary('<', index, lit(32)),
+                binary('&', binary('>>', word, shift), lit(255)),
+                lit(0),
+            )
+        if op == 'not':
+            return n('UnaryOperation', operator='~', prefix=True, subExpression=args[0])
+        if op == 'iszero':
+            return word_bool(binary('==', args[0], lit(0)))
+        if op in ('shl', 'shr'):
+            return binary('<<' if op == 'shl' else '>>', args[1], args[0])
+        if op in ('mulmod', 'addmod', 'div', 'mod'):
+            value = (
+                call(ident(op), *args)
+                if op.endswith('mod') and len(args) == 3
+                else binary('/' if op == 'div' else '%', *args)
+            )
+            return choose(binary('==', args[-1], lit(0)), lit(0), value)
+        raise Unsupported(f'assembly builtin {op}')
+
+    def signature(node):
+        if node['nodeType'] == 'YulLiteral' and node['kind'] == 'number':
+            return int(node['value'], 0)
+        if node['nodeType'] == 'YulFunctionCall':
+            return (
+                node['functionName']['name'],
+                *(signature(x) for x in node['arguments']),
+            )
+        return None
+
+    stmts = block['AST']['statements']
+    # Two scratch-word writes followed by a terminal revert have exactly this
+    # Panic(uint256) ABI payload; require the complete layout and control flow.
+    if len(stmts) == 3 and all(
+        s['nodeType'] == 'YulExpressionStatement' for s in stmts
+    ):
+        first, second, last = [s['expression'] for s in stmts]
+        if (
+            signature(first) == ('mstore', 0, 0x4E487B71)
+            and signature(second) == ('mstore', 32, None)
+            and signature(last) == ('revert', 28, 36)
+        ):
+            payload = expr(second['arguments'][1])
+            if used != refs.keys():
+                raise Unsupported('unconsumed panic binding')
+            return n('RevertStatement', errorCall=call(ident('#yul.panic'), payload)), {
+                '#yul.panic'
+            }
+    out = []
+    markers = set()
+    for stmt in stmts:
+        kind = stmt['nodeType']
+        if kind == 'YulIf' and last_return is not None:
+            body = stmt['body']['statements']
+            if (
+                len(body) == 3
+                and [op['nodeType'] for op in body]
+                == [
+                    'YulVariableDeclaration',
+                    'YulExpressionStatement',
+                    'YulExpressionStatement',
+                ]
+                and len(body[0]['variables']) == 1
+            ):
+                ptr = body[0]['variables'][0]['name']
+                if [
+                    yul_expr(body[0]['value']),
+                    yul_expr(body[1]['expression']),
+                    yul_expr(body[2]['expression']),
+                ] == [
+                    ('mload', 64),
+                    ('returndatacopy', ptr, 0, ('returndatasize',)),
+                    ('revert', ptr, ('returndatasize',)),
+                ]:
+                    out.append(
+                        n(
+                            'IfStatement',
+                            condition=binary('!=', expr(stmt['condition']), lit(0)),
+                            trueBody=n(
+                                'RevertStatement',
+                                errorCall=call(
+                                    ident('#yul.rethrow'), ident(last_return)
+                                ),
+                            ),
+                        )
+                    )
+                    markers.add('#yul.rethrow')
+                    continue
+        if kind == 'YulExpressionStatement':
+            op = stmt['expression']
+            opcode = op.get('functionName', {}).get('name')
+            if opcode in ('mstore', 'mstore8'):
+                size = 32 if opcode == 'mstore' else 1
+                addr, value = op['arguments']
+                offset = scratch_offset(addr, size)
+                marker = '#yul.scratchStore' if size == 32 else '#yul.scratchStore8'
+                out.append(
+                    n(
+                        'ExpressionStatement',
+                        expression=call(
+                            ident(marker),
+                            n('Literal', kind='number', value=str(offset)),
+                            expr(value),
+                        ),
+                    )
+                )
+                initialized_scratch.update(range(offset, offset + size))
+                continue
+        if kind not in ('YulVariableDeclaration', 'YulAssignment'):
+            raise Unsupported(
+                f'assembly {kind}: {stmt.get("expression", {}).get("functionName", {}).get("name", "")}'
+            )
+        invoke = stmt['value']
+        if invoke.get('functionName', {}).get('name') == 'call':
+            args = invoke['arguments']
+            if len(args) != 7 or args[1].get('src') not in pointers:
+                raise Unsupported('unrecognized assembly CALL buffer')
+            token = args[1]
+            data = args[3]['arguments'][0]
+            for operand in (token, data, args[4]['arguments'][0]):
+                if operand['src'] not in refs or operand['src'] not in pointers:
+                    raise Unsupported('unresolved assembly CALL pointer')
+                binding(operand)
+            last_return = f'#ret{len(out)}'
+            ok = f'#ok{len(out)}'
+            success = variable(ok)
+            success['typeName']['name'] = 'bool'
+            buf = variable(last_return)
+            buf.update(
+                typeName=n('ElementaryTypeName', name='bytes'), storageLocation='memory'
+            )
+            address = call(
+                n(
+                    'ElementaryTypeNameExpression',
+                    typeName=n('ElementaryTypeName', name='address'),
+                ),
+                ident(token['name']),
+            )
+            target = n(
+                'FunctionCallOptions',
+                expression=n('MemberAccess', expression=address, memberName='call'),
+                names=['gas'],
+                options=[call(ident('gasleft'))],
+            )
+            out.append(
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[success, buf],
+                    initialValue=call(target, ident(data['name'])),
+                )
+            )
+            out.append(
+                n(
+                    'ExpressionStatement',
+                    expression=call(
+                        ident('#yul.scratchReturn'),
+                        n('Literal', kind='number', value='0'),
+                        ident(last_return),
+                    ),
+                )
+            )
+            value = word_bool(ident(ok))
+        else:
+            value = expr(invoke)
+        if kind == 'YulVariableDeclaration':
+            (target,) = stmt['variables']
+            name = target['name']
+            if (
+                name in locals_
+                or name in (name for name, _ in refs.values())
+                or target.get('type')
+            ):
+                raise Unsupported('unsupported Yul declaration')
+            locals_.add(name)
+            out.append(
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[variable(name)],
+                    initialValue=value,
+                )
+            )
+        else:
+            (target,) = stmt['variableNames']
+            if binding(target) == 'bool':
+                # Arbitrary dirty bits cannot be faithfully stored in a Solidity bool.
+                if invoke.get('functionName', {}).get(
+                    'name'
+                ) != 'call' and not canonical_yul_bool(stmt['value']):
+                    raise Unsupported('assembly assignment of noncanonical bool')
+                value = binary('!=', value, lit(0))
+            out.append(
+                n(
+                    'ExpressionStatement',
+                    expression=n(
+                        'Assignment',
+                        operator='=',
+                        leftHandSide=ident(target['name']),
+                        rightHandSide=value,
+                    ),
+                )
+            )
+    if used != refs.keys():
+        raise Unsupported('unconsumed assembly external reference')
+    return n('UncheckedBlock', statements=out), markers
+
