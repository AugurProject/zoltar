index 0000000000000000000000000000000000000000..aecc72e0e958618381555f3b874d1d13f6b02faa
--- /dev/null
+++ b/prototypes/source/invalid_halt.py
@@ -0,0 +1,132 @@
+"""Check exceptional frame exit, rollback and forwarded gas against the receiver's INVALID."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly, walk, yul_expr
+from muldiv import ROOT, compile_solc, importer, replay
+
+
+def run(repo, compiler, anvil):
+    root = repo / 'solidity/contracts'
+    path = 'test/statoblast/OpenOracleAdversarialHarnesses.sol'
+    sources = {
+        p: (root / p).read_text()
+        for p in (
+            path,
+            'statoblast/interfaces/IERC1155Receiver.sol',
+            'statoblast/interfaces/IERC165.sol',
+        )
+    }
+    ast = compile_solc(compiler, sources, {'*': {'': ['ast']}})['sources'][path]['ast']
+    receiver = next(
+        x for x in ast['nodes'] if x.get('name') == 'OpenOracleRejectingETHReceiver'
+    )
+    recv = next(x for x in receiver['nodes'] if x.get('kind') == 'receive')
+    (block,) = [
+        x
+        for x in walk(recv)
+        if x.get('nodeType') == 'InlineAssembly'
+        and any(
+            yul_expr(n.get('expression')) == ('invalid',)
+            for n in x['AST']['statements']
+        )
+    ]
+    start, size, _ = map(int, block['src'].split(':'))
+    actual_assembly = sources[path].encode()[start : start + size].decode()
+    source = """
+pragma solidity 0.8.35;
+contract Probe {
+    uint public touched;
+    function fail(bool exhaust) external {
+        touched = 9;
+        if (exhaust) { ASM }
+        revert();
+    }
+}
+contract Caller {
+    function check(Probe target, bool exhaust) external returns(bool,uint,uint,uint) {
+        bytes memory data = abi.encodeCall(target.fail,(exhaust));
+        uint beforeCall = gasleft();
+        (bool ok, bytes memory output) = address(target).call{gas: 80000}(data);
+        uint spent = beforeCall - gasleft();
+        return (ok, output.length, target.touched(), spent);
+    }
+}""".replace('ASM', actual_assembly)
+    result = compile_solc(
+        compiler,
+        {'P.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                '*': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    evms = result['contracts']['P.sol']
+    target, caller = [f'0x{i:040x}' for i in (0x1234, 0x5678)]
+    with replay.local_chain(anvil) as url:
+        for addr, name in [(target, 'Probe'), (caller, 'Caller')]:
+            replay.rpc(
+                url,
+                'anvil_setCode',
+                [addr, '0x' + evms[name]['evm']['deployedBytecode']['object']],
+            )
+        for exhaust in (0, 1):
+            data = (
+                '0x'
+                + evms['Caller']['evm']['methodIdentifiers']['check(address,bool)']
+                + target[2:].zfill(64)
+                + f'{exhaust:064x}'
+            )
+            output = replay.rpc(
+                url, 'eth_call', [{'to': caller, 'data': data}, 'latest']
+            )[2:]
+            words = [int(output[i : i + 64], 16) for i in range(0, len(output), 64)]
+            if words[:3] != [0, 0, 0] or (words[3] >= 80000) != bool(exhaust):
+                raise AssertionError(words)
+    unit = result['sources']['P.sol']['ast']
+    unit['nodes'] = [node for node in unit['nodes'] if node.get('name') != 'Caller']
+    model = importer.render_module(
+        lower_assembly(unit), path, 'Probe', 'SolidCore.Solidity.InvalidProbe', True
+    )
+    opts = evms['Probe']['evm']['methodIdentifiers']
+    fail = list(bytes.fromhex(opts['fail(bool)']))
+    getter = list(bytes.fromhex(opts['touched()']))
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Invalid.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + f"""
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract InvalidProbe.importedSourceUnit "Probe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for flag in [0,1] do
+    let some r := TypeCheck.CheckedContract.callCalldata? 20000 c Source.State.empty
+      ({fail} ++ List.replicate 31 0 ++ [flag]) | throw (IO.userError "call failed to elaborate")
+    unless !r.success && r.output.isEmpty && r.exhaustsGas == (flag == 1) do
+      throw (IO.userError "incorrect exceptional or reverting frame result")
+    let some stored := TypeCheck.CheckedContract.callCalldata? 20000 c r.state {getter}
+      | throw (IO.userError "getter failed")
+    unless stored.success && stored.output == List.replicate 32 0 do
+      throw (IO.userError "reverted write survived")
+"""
+        )
+        subprocess.run(['lake', 'env', 'lean', '--run', script], cwd=ROOT, check=True)
+    print(
+        '2 receiver frame exits matched Anvil rollback, return data and gas exhaustion'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
