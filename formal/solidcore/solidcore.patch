index 0000000000000000000000000000000000000000..2c8da3509dd237bdb2f6459fc72aa014aec13424
--- /dev/null
+++ b/prototypes/source/project.py
@@ -0,0 +1,88 @@
+"""Retain the complete target contract and its referenced library members."""
+
+from assembly import walk
+
+
+def project(ast, target):
+    nodes = ast['nodes']
+    (root,) = (
+        n
+        for n in nodes
+        if n.get('nodeType') == 'ContractDefinition' and n['name'] == target
+    )
+    owners = {}
+    units = {}
+    containers = {}
+    for top in nodes:
+        units[top['id']] = top
+        if top['nodeType'] == 'ContractDefinition':
+            for member in top['nodes']:
+                units[member['id']] = member
+                containers[member['id']] = top
+                for d in walk(member):
+                    if 'id' in d:
+                        owners[d['id']] = member['id']
+            owners[top['id']] = top['id']
+        else:
+            for d in walk(top):
+                if 'id' in d:
+                    owners[d['id']] = top['id']
+
+    # A qualified enum or struct names its declaring scope without executing
+    # that scope. Keep the type and its container. A direct use of the
+    # contract itself, its bases, or an ordinary executable member still
+    # retains the complete foreign contract (including virtual dispatch).
+    type_members = {
+        'EnumDefinition',
+        'StructDefinition',
+        'UserDefinedValueTypeDefinition',
+    }
+    used = set()
+    shells = set()
+    pending = [root['id']] + [
+        i['id']
+        for i in nodes
+        if i['nodeType'] in ('PragmaDirective', 'UsingForDirective')
+    ]
+    while pending:
+        key = pending.pop()
+        if key in used:
+            continue
+        used.add(key)
+        node = units[key]
+        if key in containers:
+            owner = containers[key]
+            if node['nodeType'] in type_members:
+                shells.add(owner['id'])
+                # Keep the original inheritance environment if present.
+                for base in owner.get('baseContracts', []):
+                    pending.append(base['baseName']['referencedDeclaration'])
+            else:
+                pending.append(owner['id'])
+        if node['nodeType'] == 'ContractDefinition':
+            for member in node['nodes']:
+                if (
+                    node is root
+                    or node['contractKind'] != 'library'
+                    or member['nodeType'] == 'UsingForDirective'
+                ):
+                    pending.append(member['id'])
+            node = {k: v for k, v in node.items() if k != 'nodes'}
+        for item in walk(node):
+            for field in ('referencedDeclaration', 'function', 'declaration'):
+                ref = item.get(field)
+                if isinstance(ref, int) and ref in owners:
+                    pending.append(owners[ref])
+    return {
+        **ast,
+        'nodes': [
+            {
+                **node,
+                'nodes': [member for member in node['nodes'] if member['id'] in used],
+            }
+            if node['nodeType'] == 'ContractDefinition'
+            else node
+            for node in nodes
+            if node['id'] in used or node['id'] in shells
+        ],
+    }
diff --git a/prototypes/source/test_assembly.py b/prototypes/source/test_assembly.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a36cf95f3bfc5612daf3505f5a2bbed122dc36f
--- /dev/null
+++ b/prototypes/source/test_assembly.py
@@ -0,0 +1,109 @@
+"""Check the boundaries of source rewrites against actual analyzed Solidity."""
+
+import copy
+import sys
+import unittest
+
+from assembly import Unsupported, lower_assembly, walk
+from muldiv import compile_solc
+from project import project
+
+compiler = 'solc'
+
+
+class AssemblyTests(unittest.TestCase):
+    def setUp(self):
+        self.ast = compile_solc(
+            compiler,
+            {
+                'Test.sol': """
+pragma solidity 0.8.35;
+contract T {
+    function bubble(bytes memory a, bytes memory b) public pure {
+        assembly { revert(add(a, 32), mload(a)) }
+    }
+    function panic(uint256 code) public pure {
+        assembly { mstore(0, 0x4e487b71) mstore(32, code) revert(28,36) }
+    }
+}
+"""
+            },
+            {'*': {'': ['ast']}},
+        )['sources']['Test.sol']['ast']
+
+    def test_exact_intrinsics(self):
+        names = [
+            d['name']
+            for d in walk(lower_assembly(self.ast))
+            if d.get('nodeType') == 'ErrorDefinition'
+        ]
+        self.assertEqual(names, ['#yul.panic', '#yul.rethrow'])
+
+    def test_rethrow_requires_exact_pointer_and_extent(self):
+        for variant in ['offset', 'distinct', 'slot']:
+            with self.subTest(variant=variant):
+                ast = copy.deepcopy(self.ast)
+                block = next(
+                    d for d in walk(ast) if d.get('nodeType') == 'InlineAssembly'
+                )
+                ptr, size = block['AST']['statements'][0]['expression']['arguments']
+                if variant == 'offset':
+                    ptr['arguments'][1]['value'] = '31'
+                elif variant == 'slot':
+                    block['externalReferences'][0]['isSlot'] = True
+                else:
+                    second = size['arguments'][0]
+                    second['name'] = 'b'
+                    ref = next(
+                        r
+                        for r in block['externalReferences']
+                        if r['src'] == second['src']
+                    )
+                    ref['declaration'] = next(
+                        d['id']
+                        for d in walk(ast)
+                        if d.get('nodeType') == 'VariableDeclaration'
+                        and d['name'] == 'b'
+                    )
+                with self.assertRaises(Unsupported):
+                    lower_assembly(ast)
+
+    def test_panic_requires_exact_payload(self):
+        block = [d for d in walk(self.ast) if d.get('nodeType') == 'InlineAssembly'][1]
+        block['AST']['statements'][-1]['expression']['arguments'][1]['value'] = '35'
+        with self.assertRaises(Unsupported):
+            lower_assembly(self.ast)
+
+
+class ProjectTests(unittest.TestCase):
+    def test_type_only_and_executable_contract_dependencies(self):
+        ast = compile_solc(
+            compiler,
+            {
+                'Project.sol': """
+pragma solidity 0.8.35;
+contract Foreign {
+    struct S { uint a; }
+    function m() external pure returns(uint) { return 1; }
+}
+contract TypeOnly { function read(Foreign.S memory s) public pure returns(uint) { return s.a; } }
+contract Caller { function read(Foreign f) public view returns(uint) { return f.m(); } }
+"""
+            },
+            {'*': {'': ['ast']}},
+        )['sources']['Project.sol']['ast']
+
+        def members(target):
+            declaration = next(
+                d for d in project(ast, target)['nodes'] if d.get('name') == 'Foreign'
+            )
+            return [d.get('name') for d in declaration['nodes']]
+
+        self.assertEqual(members('TypeOnly'), ['S'])
+        self.assertEqual(members('Caller'), ['S', 'm'])
+        self.assertEqual(members('Foreign'), ['S', 'm'])
+
+
+if __name__ == '__main__':
+    compiler = sys.argv.pop(1) if len(sys.argv) > 1 else 'solc'
+    unittest.main()
