+      let ty ← TypeEnv.lookup? ctx.env name
+      let layout ← Ty.toCoreStorageLayout? ty
+      let base ← match slot with
+        | Expr.call (Expr.ident "#yul.slotOf") [Arg.positional (Expr.ident other)] =>
+            if StorageRefEnv.isStorageRef ctx.storageRefEnv other then some (.storageRefSlot other []) else none
