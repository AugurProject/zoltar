index 0000000000000000000000000000000000000000..f110ea49541fa412c59756e605b5af8751dd7f51
--- /dev/null
+++ b/prototypes/source/clone_bindings.py
@@ -0,0 +1,152 @@
+"""Replay the repository's binding reads against a delegatecalled implementation."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import compile_solc, importer, replay, ROOT
+from project import project
+
+HARNESS = """
+contract BindingProbe {
+    function capital() external view returns(address) { return SecurityPoolBoundClones.boundAddress(); }
+    function universe() external view returns(uint248, address) { return SecurityPoolBoundClones.universeBindings(); }
+}
+"""
+
+
+def run(repo, compiler, anvil):
+    source = (
+        repo / 'solidity/contracts/statoblast/SecurityPoolBoundClones.sol'
+    ).read_text() + HARNESS
+    result = compile_solc(
+        compiler,
+        {'Bindings.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                'BindingProbe': [
+                    'evm.deployedBytecode.object',
+                    'evm.methodIdentifiers',
+                ],
+            }
+        },
+    )
+    target = lower_assembly(
+        project(result['sources']['Bindings.sol']['ast'], 'BindingProbe')
+    )
+    module = importer.render_module(
+        target, 'Bindings.sol', 'BindingProbe', 'SolidCore.Solidity.Bindings', True
+    )
+    evm = result['contracts']['Bindings.sol']['BindingProbe']['evm']
+    implementation = '11' * 20
+    clone = '0x' + '22' * 20
+    prefix = bytes.fromhex(
+        '363d3d373d3d3d363d73' + implementation + '5af43d82803e903d91602b57fd5bf3'
+    )
+    tests = []
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url,
+            'anvil_setCode',
+            ['0x' + implementation, '0x' + evm['deployedBytecode']['object']],
+        )
+        for method, widths in [('capital', [20]), ('universe', [31, 20])]:
+            size = sum(widths)
+            for payload in [
+                bytes(size),
+                bytes(range(size)),
+                bytes([255]) * size,
+                bytes(size - 1),
+                bytes(size + 1),
+            ]:
+                code = prefix + payload
+                replay.rpc(url, 'anvil_setCode', [clone, '0x' + code.hex()])
+                try:
+                    output = replay.rpc(
+                        url,
+                        'eth_call',
+                        [
+                            {
+                                'to': clone,
+                                'data': '0x' + evm['methodIdentifiers'][method + '()'],
+                            },
+                            'latest',
+                        ],
+                    )
+                except RuntimeError as exc:
+                    reason = (
+                        'Capital module requires a clone'
+                        if method == 'capital'
+                        else 'Universe module requires a clone'
+                    )
+                    data = reason.encode()
+                    expected = (
+                        '0x08c379a0'
+                        + f'{32:064x}{len(data):064x}'
+                        + data.hex().ljust(((len(data) + 31) // 32) * 64, '0')
+                    )
+                    if len(payload) == size or exc.args[0]['data'] != expected:
+                        raise
+                    outcome = 'error ' + reason
+                else:
+                    values = []
+                    start = 0
+                    for width in widths:
+                        values.append(
+                            int.from_bytes(payload[start : start + width], 'big')
+                        )
+                        start += width
+                    if len(payload) != size or output != '0x' + ''.join(
+                        f'{v:064x}' for v in values
+                    ):
+                        raise AssertionError(output)
+                    outcome = 'ok ' + ','.join(map(str, values))
+                tests.append((method, code, outcome))
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Bindings.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + module
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract Bindings.importedSourceUnit "BindingProbe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (method, code, expected) in (["""
+            + ',\n'.join(
+                f'("{method}", {list(code)}, "{outcome}")'
+                for method, code, outcome in tests
+            )
+            + """] : List (String × List Nat × String)) do
+    let ctx := {Source.Context.empty with self := 2, accountCodes := [(2,code)]}
+    let result := TypeCheck.CheckedContract.callFunctionWithContext 50000 c method ctx Source.State.empty []
+    let actual ← match result with
+      | .ok (.returned _ values) => do
+        let words ← values.mapM fun v => match v with
+          | .word w => pure (toString w)
+          | _ => throw (IO.userError (reprStr v))
+        pure ("ok " ++ String.intercalate "," words)
+      | .ok (.reverted _ (.error e)) => pure ("error " ++ e)
+      | _ => throw (IO.userError ("unexpected call result " ++ method))
+    unless actual == expected do throw (IO.userError s!"{method}: {actual} vs {expected}")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(tests)} clone binding calls matched checked SolidCore and Anvil')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
