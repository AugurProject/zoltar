@@ -0,0 +1,283 @@
+"""Differential test of both Math.mulDiv overloads through checked Solidity source."""
+
+import argparse
+import json
+import random
+import re
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+sys.path[:0] = [str(HERE.parent / 'mul512'), str(ROOT / 'scripts')]
+# The pinned checkout provides the two sibling script modules.
+import replay  # noqa: E402
+import solc_ast_to_lean_source as importer  # noqa: E402
+from assembly import lower_assembly  # noqa: E402
+from project import project  # noqa: E402
+
+WRAPPER = """
+contract MulDivProbe {
+    function bubble(bytes memory data) external pure {
+        DelegateCall.bubbleRevert(data);
+    }
+    function scalar(uint256 x, uint256 y, uint256 d) external pure returns (uint256) {
+        return ScalarOutcomes.mulDiv(x,y,d);
+    }
+    function floor(uint256 x, uint256 y, uint256 d) external pure returns (uint256) {
+        return Math.mulDiv(x,y,d);
+    }
+    function rounded(uint256 x, uint256 y, uint256 d, uint8 mode) external pure returns (uint256) {
+        return Math.mulDiv(x,y,d,Math.Rounding(mode));
+    }
+}
+"""
+
+
+def compile_solc(compiler, sources, outputs, *, evm_version='osaka'):
+    config = {
+        'language': 'Solidity',
+        'sources': {k: {'content': v} for k, v in sources.items()},
+        'settings': {
+            'viaIR': True,
+            'evmVersion': evm_version,
+            'optimizer': {'enabled': True, 'runs': 0},
+            'metadata': {'appendCBOR': False, 'bytecodeHash': 'none'},
+            'outputSelection': outputs,
+        },
+    }
+    result = json.loads(
+        subprocess.check_output(
+            [compiler, '--standard-json'], input=json.dumps(config), text=True
+        )
+    )
+    errors = [
+        e['formattedMessage']
+        for e in result.get('errors', [])
+        if e['severity'] == 'error'
+    ]
+    if errors:
+        raise ValueError('\n'.join(errors))
+    return result
+
+
+def compile_probe(repo, compiler):
+    if '0.8.35+commit.47b9dedd' not in subprocess.check_output(
+        [compiler, '--version'], text=True
+    ):
+        raise ValueError('expected solc 0.8.35')
+    directory = (
+        repo / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/utils'
+    )
+    sources = {
+        p: (directory / p).read_text()
+        for p in ('Panic.sol', 'math/SafeCast.sol', 'math/Math.sol')
+    }
+    sources['DelegateCall.sol'] = (
+        repo / 'solidity/contracts/statoblast/DelegateCall.sol'
+    ).read_text()
+    for name in ('DecimalStrings.sol', 'ScalarOutcomes.sol'):
+        sources[name] = (repo / 'solidity/contracts' / name).read_text()
+    evm_sources = {
+        **sources,
+        'Probe.sol': "pragma solidity 0.8.35; import {Math} from './math/Math.sol'; import {DelegateCall} from './DelegateCall.sol'; import {ScalarOutcomes} from './ScalarOutcomes.sol';"
+        + WRAPPER,
+    }
+    evm = compile_solc(
+        compiler,
+        evm_sources,
+        {
+            'Probe.sol': {
+                'MulDivProbe': ['evm.bytecode.object', 'evm.methodIdentifiers']
+            }
+        },
+    )
+    # Flatten the same four units. No renaming or edits to function bodies.
+    flat = (
+        '\n'.join(
+            re.sub(r'(?m)^(?:// SPDX-License-Identifier:.*|import [^;]+;)', '', s)
+            for s in sources.values()
+        )
+        + WRAPPER
+    )
+    ast = compile_solc(compiler, {'Flat.sol': flat}, {'*': {'': ['ast']}})['sources'][
+        'Flat.sol'
+    ]['ast']
+    return lower_assembly(project(ast, 'MulDivProbe')), evm['contracts']['Probe.sol'][
+        'MulDivProbe'
+    ]['evm']
+
+
+def cases():
+    w = 2**256
+    triples = [
+        (0, 0, 0),
+        (0, 1, 1),
+        (4, 6, 3),
+        (4, 6, 5),
+        (1, 1, 0),
+        (w - 1, w - 1, 0),
+        (w - 1, w - 1, w - 2),
+        (w - 1, w - 1, w - 1),
+        (w - 2, w - 2, w - 3),
+        (2**128, 2**128, 1),
+        (2**128, 2**128, 2),
+        (w - 1, 2, 3),
+    ]
+    rng = random.Random(0xD17)
+    for _ in range(24):
+        a, b = rng.getrandbits(256), rng.getrandbits(256)
+        hi = a * b // w
+        triples.extend([(a, b, hi), (a, b, hi + 1), (a, b, rng.randrange(1, w))])
+    return [
+        (mode, a, b, d)
+        for a, b, d in dict.fromkeys(triples)
+        for mode in (-2, -1, 0, 1, 2, 3)
+    ] + [(4, 1, 2, 3)]
+
+
+def expected(mode, a, b, d):
+    if mode > 3:
+        return 'panic 33'
+    if not d:
+        return (
+            'error mulDiv denominator must be greater than zero'
+            if mode == -2
+            else 'panic 18'
+        )
+    q, r = divmod(a * b, d)
+    q += int(mode in (1, 3) and r != 0)
+    if mode == -2 and q >= 2**256:
+        return 'error mulDiv result would overflow uint256'
+    return 'panic 17' if q >= 2**256 else f'ok {q}'
+
+
+def run(repo, compiler, anvil):
+    ast, evm = compile_probe(repo, compiler)
+    code = importer.render_module(
+        ast, 'Flat.sol', 'MulDivProbe', 'SolidCore.Solidity.MulDiv', True
+    )
+    with tempfile.TemporaryDirectory() as tmp:
+        tmp = Path(tmp)
+        script = tmp / 'Probe.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + code
+            + (HERE / 'MulDiv.lean.in').read_text()
+        )
+        vectors = cases()
+        inp = tmp / 'inputs'
+        inp.write_text(''.join(' '.join(map(str, c)) + '\n' for c in vectors))
+        p = subprocess.run(
+            [
+                'lake',
+                'env',
+                'lean',
+                '-DmaxRecDepth=16384',
+                '-DmaxHeartbeats=20000000',
+                '--run',
+                str(script),
+                str(inp),
+            ],
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            text=True,
+        )
+        if p.returncode:
+            raise RuntimeError(p.stdout)
+        lines = p.stdout.splitlines()
+        actual = lines[: len(vectors)]
+        raw_results = lines[len(vectors) :]
+    with replay.local_chain(anvil) as url:
+        sender = replay.rpc(url, 'eth_accounts', [])[0]
+        tx = replay.rpc(
+            url,
+            'eth_sendTransaction',
+            [
+                {
+                    'from': sender,
+                    'data': '0x' + evm['bytecode']['object'],
+                    'gas': '0x300000',
+                }
+            ],
+        )
+        for _ in range(200):
+            receipt = replay.rpc(url, 'eth_getTransactionReceipt', [tx])
+            if receipt:
+                break
+            time.sleep(0.05)
+        if not receipt or int(receipt['status'], 16) != 1:
+            raise RuntimeError('probe deployment failed')
+        for c, lean in zip(vectors, actual, strict=True):
+            mode, a, b, d = c
+            if mode == -2:
+                func, args = 'scalar(uint256,uint256,uint256)', [a, b, d]
+            elif mode == -1:
+                func, args = 'floor(uint256,uint256,uint256)', [a, b, d]
+            else:
+                func, args = 'rounded(uint256,uint256,uint256,uint8)', [a, b, d, mode]
+            data = (
+                '0x'
+                + evm['methodIdentifiers'][func]
+                + ''.join(f'{v:064x}' for v in args)
+            )
+            try:
+                raw = replay.rpc(
+                    url,
+                    'eth_call',
+                    [{'to': receipt['contractAddress'], 'data': data}, 'latest'],
+                )
+                if len(raw) != 66:
+                    raise ValueError(f'unexpected result: {raw}')
+                result = f'ok {int(raw, 16)}'
+            except RuntimeError as e:
+                raw = e.args[0]['data']
+                if raw.startswith('0x4e487b71') and len(raw) == 74:
+                    result = f'panic {int(raw[10:], 16)}'
+                elif raw.startswith('0x08c379a0') and lean.startswith('error '):
+                    message = lean.removeprefix('error ').encode()
+                    padded = message.hex().ljust(((len(message) + 31) // 32) * 64, '0')
+                    if raw != f'0x08c379a0{32:064x}{len(message):064x}{padded}':
+                        raise AssertionError(f'wrong revert data: {raw}')
+                    result = lean
+                else:
+                    raise
+            if lean != result or result != expected(*c):
+                raise AssertionError(
+                    f'{c}: SolidCore={lean}, EVM={result}, exact={expected(*c)}'
+                )
+        payloads = [bytes(range(size)) for size in [0, 1, 4, 31, 32, 33, 65]]
+        selector = evm['methodIdentifiers']['bubble(bytes)']
+        for payload, lean in zip(payloads, raw_results, strict=True):
+            size = len(payload)
+            tail = payload.hex().ljust(((size + 31) // 32) * 64, '0')
+            data = f'0x{selector}{32:064x}{size:064x}{tail}'
+            try:
+                replay.rpc(
+                    url,
+                    'eth_call',
+                    [{'to': receipt['contractAddress'], 'data': data}, 'latest'],
+                )
+            except RuntimeError as exc:
+                raw = exc.args[0]['data']
+                if raw != '0x' + payload.hex() or lean != f'rethrew {size}':
+                    raise AssertionError(f'rethrow {size}: {raw}, {lean}')
+            else:
+                raise AssertionError('bubble returned successfully')
+    print(f'{len(payloads)} byte-exact DelegateCall.bubbleRevert calls matched')
+    print(
+        f'{len(vectors)} mulDiv calls matched: ScalarOutcomes and both Math overloads, all rounding modes and revert data'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
