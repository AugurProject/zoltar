+def load_code_tails(stmts, decls):
+    """Copy the code after byte zero of two accounts into a fresh bytes result."""
+    markers = set()
+    for i in range(3, len(stmts)):
+        asm = stmts[i]
+        if (
+            not isinstance(asm, dict)
+            or asm.get('nodeType') != 'InlineAssembly'
+            or asm.get('flags') != ['memory-safe']
+        ):
+            continue
+        ops = asm['AST']['statements']
+        if len(ops) != 2 or any(v['nodeType'] != 'YulExpressionStatement' for v in ops):
+            continue
+        sizes = []
+        for st in stmts[i - 3 : i - 1]:
+            if (
+                not isinstance(st, dict)
+                or st.get('nodeType') != 'VariableDeclarationStatement'
+                or len(st['declarations']) != 1
+            ):
+                break
+            dec = st['declarations'][0]
+            val = st.get('initialValue') or {}
+            code = val.get('expression', {})
+            receiver = code.get('expression', {})
+            if (
+                not dec
+                or dec['typeDescriptions']['typeString'] != 'uint256'
+                or val.get('memberName') != 'length'
+                or code.get('memberName') != 'code'
+                or receiver.get('nodeType') != 'Identifier'
+                or receiver['typeDescriptions']['typeString'] != 'address'
+            ):
+                break
+            sizes.append((dec, receiver))
+        if len(sizes) != 2:
+            continue
+        st = stmts[i - 1]
+        if not isinstance(st, dict) or st.get('nodeType') != 'ExpressionStatement':
+            continue
+        expr = st['expression']
+        if expr.get('nodeType') != 'Assignment' or expr.get('operator') != '=':
+            continue
+        dest = expr['leftHandSide']
+        init = expr['rightHandSide']
+        var = decls.get(dest.get('referencedDeclaration'), {})
+        if (
+            dest.get('nodeType') != 'Identifier'
+            or var.get('storageLocation') != 'memory'
+            or var['typeName'].get('name') != 'bytes'
+            or init.get('nodeType') != 'FunctionCall'
+            or init['expression'].get('nodeType') != 'NewExpression'
+            or init['expression']['typeName'].get('name') != 'bytes'
+            or len(init['arguments']) != 1
+        ):
+            continue
+        length = init['arguments'][0]
+        total = length.get('leftExpression', {})
+        if (
+            length.get('operator') != '-'
+            or length['rightExpression'].get('value') != '2'
+            or length['rightExpression'].get('subdenomination')
+            or total.get('operator') != '+'
+            or [
+                total[k].get('referencedDeclaration')
+                for k in ('leftExpression', 'rightExpression')
+            ]
+            != [s[0]['id'] for s in sizes]
+        ):
+            continue
+        (len1, addr1), (len2, addr2) = sizes
+        buf = var['name']
+        l1, l2 = len1['name'], len2['name']
+        a1, a2 = addr1['name'], addr2['name']
+        names = {
+            buf: var['id'],
+            l1: len1['id'],
+            l2: len2['id'],
+            a1: addr1['referencedDeclaration'],
+            a2: addr2['referencedDeclaration'],
+        }
+        if len(names) != 5 or [yul_expr(v['expression']) for v in ops] != [
+            ('extcodecopy', a1, ('add', buf, 32), 1, ('sub', l1, 1)),
+            ('extcodecopy', a2, ('add', ('add', buf, 31), l1), 1, ('sub', l2, 1)),
+        ]:
+            continue
+        uses = {
+            v['src']: names[v['name']]
+            for v in walk(ops)
+            if v.get('nodeType') == 'YulIdentifier' and v['name'] in names
+        }
+        refs = asm['externalReferences']
+        if {r['src']: r['declaration'] for r in refs} != uses or any(
+            r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+            for r in refs
+        ):
+            continue
+        body = []
+        for addr, size, off in [(a1, l1, None), (a2, l2, l1)]:
+            # The original allocation has already checked length addition and
+            # subtraction. An empty account now requests a 2^256-1 byte copy.
+            body.insert(
+                0,
+                n(
+                    'IfStatement',
+                    condition=binary('==', ident(size), lit(0)),
+                    trueBody=n(
+                        'RevertStatement', errorCall=call(ident('#yul.copyOutOfGas'))
+                    ),
+                ),
+            )
+            idx = ident('#codeIndex')
+            target = binary('-', idx, lit(1))
+            if off:
+                target = binary('+', binary('-', ident(off), lit(1)), target)
+
+            def at(base, index):
+                return n('IndexAccess', baseExpression=base, indexExpression=index)
+
+            write = n(
+                'Assignment',
+                operator='=',
+                leftHandSide=at(ident(buf), target),
+                rightHandSide=at(ident('#sourceCode'), idx),
+            )
+            inc = n(
+                'Assignment',
+                operator='=',
+                leftHandSide=idx,
+                rightHandSide=binary('+', idx, lit(1)),
+            )
+            cached = {**var, 'name': '#sourceCode'}
+            cached.pop('id', None)
+            body.append(
+                n(
+                    'Block',
+                    statements=[
+                        n(
+                            'VariableDeclarationStatement',
+                            declarations=[cached],
+                            initialValue=n(
+                                'MemberAccess',
+                                expression=ident(addr),
+                                memberName='code',
+                            ),
+                        ),
+                        n(
+                            'VariableDeclarationStatement',
+                            declarations=[variable('#codeIndex')],
+                            initialValue=lit(1),
+                        ),
+                        n(
+                            'WhileStatement',
+                            condition=binary('<', idx, ident(size)),
+                            body=n(
+                                'Block',
+                                statements=[
+                                    n('ExpressionStatement', expression=write),
+                                    n('ExpressionStatement', expression=inc),
+                                ],
+                            ),
+                        ),
+                    ],
+                )
+            )
+        stmts[i] = n('Block', statements=body)
+        markers.add('#yul.copyOutOfGas')
+    return markers
+
