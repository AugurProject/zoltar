+        selector = n('Literal', kind='number', value='0x' + fn['functionSelector'])
+        builtin['memberName'] = 'encodeWithSelector'
+        expr['arguments'] = [cast('bytes4', cast('uint32', selector)), *args]
+
+    # Replace compile-time selector constants with the four bytes attached to
+    # the *resolved Solidity function declaration*. Never fold an expression
+    # that evaluates a receiver at runtime.
+    for top in result['nodes']:
+        if top.get('nodeType') != 'ContractDefinition':
+            continue
+        rewritten = []
+        for member in top['nodes']:
+            value = member.get('value') or {}
+            receiver = value.get('expression', {})
+            owner = receiver.get('expression', {})
+            fn = units.get(receiver.get('referencedDeclaration'), {})
+            declaring = units.get(owner.get('referencedDeclaration'), {})
+            selector = fn.get('functionSelector', '')
+            if (
+                member.get('constant')
+                and member.get('typeName', {}).get('name') == 'bytes4'
+                and value.get('nodeType') == 'MemberAccess'
+                and value.get('memberName') == 'selector'
+                and receiver.get('nodeType') == 'MemberAccess'
+                and owner.get('nodeType') == 'Identifier'
+                and declaring.get('nodeType') == 'ContractDefinition'
+                and fn.get('nodeType') == 'FunctionDefinition'
+                and re.fullmatch('[0-9a-f]{8}', selector)
+            ):
+                member = {
+                    **member,
+                    'value': {
+                        'nodeType': 'Literal',
+                        'kind': 'number',
+                        'value': '0x' + selector,
+                    },
+                }
+            rewritten.append(member)
+        top['nodes'] = rewritten
+    return result
