@@ -0,0 +1,162 @@
+"""Compare OpenOracle's raw preimage hash before and after typed memory writes."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import Unsupported, lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, fork, anvil):
+    path = 'solidity/contracts/statoblast/openOracle/OpenOracle.sol'
+    original = (repo / path).read_text()
+
+    def struct(name):
+        a = original.index('struct ' + name + ' {')
+        return original[a : original.index('}', a) + 1]
+
+    settle = original.split('function settle(', 1)[1]
+    setup = settle[
+        settle.index('OracleGame memory oracle;') : settle.index('if (preStateHash')
+    ]
+    rehash = settle[
+        settle.index('bytes32 nextStateHash;') : settle.index(
+            'oracleGame[reportId] = nextStateHash'
+        )
+    ]
+    src = (
+        'pragma solidity ^0.8.20;contract P{'
+        + struct('OracleGame')
+        + struct('PreimageHelper')
+        + """
+    function probe(OracleGame calldata params,PreimageHelper calldata helper,uint48 timestamp) external pure returns(bytes32,bytes32,uint,address) {
+    """
+        + setup
+        + """ oracle.settlementTimestamp=timestamp;
+    oracle.currentAmount1=oracle.currentAmount1;
+    """
+        + rehash
+        + 'return(preStateHash,nextStateHash,oracle.currentAmount1,oracle.currentReporter);}}'
+    )
+    outputs = {
+        '*': {
+            '': ['ast'],
+            'P': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+        }
+    }
+
+    def analyzed(text):
+        return compile_solc(compiler, {'P.sol': text}, outputs, evm_version=fork)
+
+    pair = analyzed(src)
+    ast = pair['sources']['P.sol']['ast']
+    model = importer.render_module(
+        lower_assembly(project(ast, 'P')),
+        path,
+        'P',
+        'SolidCore.Solidity.OracleBuffer',
+        True,
+        analyzed_solc_028=fork == 'cancun',
+    )
+    for alteration in [
+        src.replace('return(preStateHash', 'return(bytes32(stagedMem)'),
+        src.replace(
+            'oracle.currentAmount1=oracle.currentAmount1;',
+            'OracleGame memory second=oracle; second.currentAmount1=0;',
+        ),
+    ]:
+        try:
+            lower_assembly(
+                project(analyzed(alteration)['sources']['P.sol']['ast'], 'P')
+            )
+        except Unsupported:
+            pass
+        else:
+            raise AssertionError('raw buffer address or mutable struct alias escaped')
+    evm = pair['contracts']['P.sol']['P']['evm']
+    addr = '0x' + '39' * 20
+
+    def word(n):
+        return n.to_bytes(32, 'big')
+
+    rows = []
+    with replay.local_chain(anvil, fork) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for dirty in [(), (0,), (2,), (4,), (19, 21), (0, 2, 4, 19, 21)]:
+            words = [i + 11 + (2**251 if i in dirty else 0) for i in range(24)]
+            stamp = 123
+            calldata = bytes.fromhex(
+                next(iter(evm['methodIdentifiers'].values()))
+            ) + b''.join(word(i) for i in [*words, stamp])
+            out = bytes.fromhex(
+                replay.rpc(
+                    url,
+                    'eth_call',
+                    [{'to': addr, 'data': '0x' + calldata.hex()}, 'latest'],
+                )[2:]
+            )
+
+            def digest(values):
+                return bytes.fromhex(
+                    replay.rpc(
+                        url, 'web3_sha3', ['0x' + b''.join(map(word, values)).hex()]
+                    )[2:]
+                )
+
+            changed = words.copy()
+            changed[0] %= 2**128
+            changed[4] = stamp
+            if out != digest(words) + digest(changed) + word(changed[0]) + word(
+                words[2] % 2**160
+            ):
+                raise AssertionError((dirty, out))
+            rows.append(f'({list(calldata)},{list(out)})')
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Buffer.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract OracleBuffer.importedSourceUnit "P" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (input,want) in (["""
+            + ',\n'.join(rows)
+            + """] : List (List Nat × List Nat)) do
+    let some r := TypeCheck.CheckedContract.callCalldata? 100000 c Source.State.empty input | throw (IO.userError "missing dispatch")
+    unless r.success && r.output == want do throw (IO.userError s!"wrong struct copy or alias write {r.success} {r.output}")
+"""
+        )
+        subprocess.run(
+            [
+                'lake',
+                'env',
+                'lean',
+                '-s',
+                '131072',
+                '-DmaxRecDepth=32768',
+                '--run',
+                script,
+            ],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(rows)} OpenOracle raw and updated hashes matched Anvil ({fork})')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--oracle-solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, 'osaka', args.anvil)
+    run(args.repo, args.oracle_solc, 'cancun', args.anvil)
