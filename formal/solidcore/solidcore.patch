+        callee = units.get(called.get('referencedDeclaration'), {})
+        # For generated getters the ABI selector and STATICCALL come from
+        # the declared key type (e.g. uint256), even for a narrower argument.
+        if (
+            called.get('nodeType') == 'MemberAccess'
+            and callee.get('stateVariable')
+            and callee.get('visibility') == 'public'
+            and called.get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_function_external')
+        ):
+            getter_type = callee['typeName']
+            for i, arg in enumerate(expr['arguments']):
+                if getter_type.get('nodeType') == 'Mapping':
+                    key = getter_type['keyType']
+                    getter_type = getter_type['valueType']
+                elif getter_type.get('nodeType') == 'ArrayTypeName':
+                    key = n('ElementaryTypeName', name='uint256')
+                    getter_type = getter_type['baseType']
+                else:
+                    break
+                width = re.fullmatch(
+                    r'uint([0-9]+)',
+                    'uint256' if key.get('name') == 'uint' else key.get('name', ''),
+                )
+                actual = re.fullmatch(
+                    r'uint([0-9]+)',
+                    arg.get('typeDescriptions', {}).get('typeString', ''),
+                )
+                if width and actual and int(actual[1]) < int(width[1]):
+                    expr['arguments'][i] = call(
+                        n('ElementaryTypeNameExpression', typeName=key), arg
+                    )
+        if (
+            called.get('nodeType') == 'MemberAccess'
+            and called.get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_function_external')
+            and callee.get('nodeType') == 'FunctionDefinition'
+            and not expr.get('names')
+            and len(expr['arguments']) == len(callee['parameters']['parameters'])
+        ):
+            for i, (arg, formal) in enumerate(
+                zip(expr['arguments'], callee['parameters']['parameters'])
+            ):
+                if (
+                    arg.get('nodeType') == 'Literal'
+                    and arg.get('kind') in ('string', 'unicodeString', 'hexString')
+                    and formal['typeName'].get('name') == 'bytes'
+                ):
+                    expr['arguments'][i] = call(
+                        n(
+                            'ElementaryTypeNameExpression',
+                            typeName=n('ElementaryTypeName', name='bytes'),
+                        ),
+                        arg,
+                    )
+        builtin = expr.get('expression', {})
+        if (
+            builtin.get('nodeType') != 'MemberAccess'
+            or builtin.get('memberName') != 'encodeCall'
+            or builtin.get('expression', {})
+            .get('typeDescriptions', {})
+            .get('typeIdentifier')
+            != 't_magic_abi'
+            or len(expr['arguments']) != 2
+        ):
+            continue
+        pointer, values = expr['arguments']
+        base = pointer.get('expression', {})
+        fn = units.get(pointer.get('referencedDeclaration'), {})
+        base_id = base.get('referencedDeclaration')
+        static_type = units.get(base_id, {}).get('nodeType') == 'ContractDefinition'
+        local_receiver = (
+            base.get('typeDescriptions', {})
+            .get('typeIdentifier', '')
+            .startswith('t_contract$')
+            and units.get(owners.get(base_id), {}).get('nodeType')
+            == 'FunctionDefinition'
+        )
+        if (
+            pointer.get('nodeType') != 'MemberAccess'
+            or base.get('nodeType') != 'Identifier'
+            or not (static_type or local_receiver)
+            or fn.get('nodeType') != 'FunctionDefinition'
+            or not re.fullmatch('[0-9a-f]{8}', fn.get('functionSelector', ''))
+            or values.get('nodeType') != 'TupleExpression'
+            or values.get('isInlineArray')
+        ):
+            continue
+        args = values['components']
+        params = fn['parameters']['parameters']
+        if len(args) != len(params) or any(
+            not arg
+            or param['typeName']['nodeType'] != 'ElementaryTypeName'
+            or arg.get('typeDescriptions', {}).get('typeIdentifier')
+            != param['typeDescriptions']['typeIdentifier']
+            for arg, param in zip(args, params)
+        ):
+            continue
+
+        def cast(ty, value):
+            return call(
+                n(
+                    'ElementaryTypeNameExpression',
+                    typeName=n('ElementaryTypeName', name=ty),
+                ),
+                value,
+            )
