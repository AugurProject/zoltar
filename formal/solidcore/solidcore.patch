index 0000000000000000000000000000000000000000..753b21f5bebb03e1cc3c59caa8d74e5aae4144f2
--- /dev/null
+++ b/prototypes/source/MulDiv.lean.in
@@ -0,0 +1,29 @@
+
+open SolidCore.Solidity
+
+def main (args : List String) : IO Unit := do
+  let [file] := args | throw (IO.userError "usage: Probe <inputs>")
+  let contract ← match TypeCheck.CheckedInput.contract MulDiv.importedSourceUnit "MulDivProbe" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError s!"source lowering: {repr e}")
+  for line in ← IO.FS.lines file do
+    let mode :: inputs := line.splitOn " " | throw (IO.userError "missing mode")
+    let vals ← inputs.mapM fun v => match v.toNat? with
+      | some n => pure (Source.Value.word n)
+      | none => throw (IO.userError "bad word")
+    let (name, vals) := if mode == "-2" then ("scalar", vals) else if mode == "-1" then ("floor", vals) else ("rounded", vals ++ [.word (mode.toNat?.getD 255)])
+    match TypeCheck.CheckedContract.callFunctionWithContext 5000 contract name Source.Context.empty Source.State.empty vals with
+    | .ok (.returned _ [.word n]) => IO.println s!"ok {n}"
+    | .ok (.reverted _ (.error message)) => IO.println s!"error {message}"
+    | .ok (.reverted _ (.panic n)) => IO.println s!"panic {n}"
+    | .ok (.reverted _ e) => throw (IO.userError s!"unexpected revert: {repr e}")
+    | .ok (.returned _ _) => throw (IO.userError "wrong ABI return shape")
+    | .error e => throw (IO.userError s!"call: {repr e}")
+
+  for size in [0, 1, 4, 31, 32, 33, 65] do
+    let bytes := List.range size
+    match TypeCheck.CheckedContract.callFunctionWithContext 5000 contract "bubble" Source.Context.empty Source.State.empty [.bytes bytes] with
+    | .ok (.reverted _ .empty) => if size != 0 then throw (IO.userError "lost revert bytes")
+    | .ok (.reverted _ (.raw out)) => if out != bytes || size == 0 then throw (IO.userError "wrong revert bytes")
+    | _ => throw (IO.userError s!"expected raw revert of length {size}")
+    IO.println s!"rethrew {size}"
diff --git a/prototypes/source/assembly.py b/prototypes/source/assembly.py
new file mode 100644
index 0000000000000000000000000000000000000000..9cd37007f0d064e92707b2394ef7754e51d2c1ba
--- /dev/null
+++ b/prototypes/source/assembly.py
@@ -0,0 +1,317 @@
+"""Lower supported solc inline assembly ASTs to typed Solidity source AST nodes.
+
+Unsupported statements and external references are errors. This pass only reads
+solc's analyzed source tree. It never reads IR or bytecode.
+"""
+
+from copy import deepcopy
+
+
+class Unsupported(ValueError):
+    pass
+
+
+def walk(node):
+    if isinstance(node, dict):
+        yield node
+        for value in node.values():
+            yield from walk(value)
+    elif isinstance(node, list):
+        for value in node:
+            yield from walk(value)
+
+
+def n(node_type, **fields):
+    return {'nodeType': node_type, **fields}
+
+
+def ident(name):
+    return n('Identifier', name=name)
+
+
+def call(target, *args):
+    return n('FunctionCall', expression=target, arguments=list(args))
+
+
+def uint_type():
+    return n('ElementaryTypeName', name='uint256')
+
+
+def lit(value):
+    return call(
+        n('ElementaryTypeNameExpression', typeName=uint_type()),
+        n('Literal', kind='number', value=str(value)),
+    )
+
+
+def binary(op, left, right):
+    return n('BinaryOperation', operator=op, leftExpression=left, rightExpression=right)
+
+
+def choose(cond, yes, no):
+    return n('Conditional', condition=cond, trueExpression=yes, falseExpression=no)
+
+
+def variable(name):
+    return n(
+        'VariableDeclaration',
+        name=name,
+        typeName=uint_type(),
+        storageLocation='default',
+    )
+
+
+def word_bool(expr):
+    return choose(expr, lit(1), lit(0))
+
+
+def raw_rethrow(block, declarations):
+    """Recognize revert(add(data, 32), mload(data)) on one resolved bytes memory value."""
+    stmts = block['AST']['statements']
+    if len(stmts) != 1 or stmts[0]['nodeType'] != 'YulExpressionStatement':
+        return None
+
+    def args(node, op):
+        if node.get('functionName', {}).get('name') == op:
+            return node['arguments']
+        return []
+
+    operands = args(stmts[0]['expression'], 'revert')
+    if len(operands) != 2:
+        return None
+    start, length = args(operands[0], 'add'), args(operands[1], 'mload')
+    if len(start) != 2 or len(length) != 1:
+        return None
+    offset = start[1]
+    if offset.get('kind') != 'number' or int(offset['value'], 0) != 32:
+        return None
+    pointers = [start[0], length[0]]
+    refs = block['externalReferences']
+    if (
+        len(refs) != 2
+        or any(p['nodeType'] != 'YulIdentifier' for p in pointers)
+        or {r['src'] for r in refs} != {p['src'] for p in pointers}
+        or len({r['declaration'] for r in refs}) != 1
+        or any(
+            r.get('suffix') or r['isSlot'] or r['isOffset'] or r['valueSize'] != 1
+            for r in refs
+        )
+    ):
+        return None
+    decl = declarations.get(refs[0]['declaration'], {})
+    if (
+        decl.get('storageLocation') == 'memory'
+        and decl.get('typeName', {}).get('name') == 'bytes'
+        and all(p['name'] == decl['name'] for p in pointers)
+    ):
+        return n(
+            'RevertStatement',
+            errorCall=call(ident('#yul.rethrow'), ident(decl['name'])),
+        )
+    return None
+
+
+def lower_block(block, declarations):
+    if set(block.get('flags', [])) - {'memory-safe'}:
+        raise Unsupported('assembly flags')
+    rethrow = raw_rethrow(block, declarations)
+    if rethrow:
+        return rethrow, {'#yul.rethrow'}
+    refs = {}
+    for r in block['externalReferences']:
+        decl = declarations.get(r['declaration'], {})
+        typ = decl.get('typeDescriptions', {}).get('typeString')
+        if (
+            typ not in ('uint256', 'bool')
+            or r.get('suffix')
+            or r['isSlot']
+            or r['isOffset']
+            or r['valueSize'] != 1
+            or decl.get('stateVariable')
+        ):
+            raise Unsupported(f'assembly outer binding {decl.get("name")} ({typ})')
+        refs[r['src']] = (decl['name'], typ)
+    locals_ = set()
+    used = set()
+
+    def binding(node):
+        name = node['name']
+        if node['src'] in refs:
+            bound, typ = refs[node['src']]
+            if bound != name:
+                raise Unsupported('assembly declaration/name mismatch')
+            used.add(node['src'])
+            return typ
+        if name not in locals_:
+            raise Unsupported(f'unbound assembly local {name}')
+        return 'uint256'
+
+    def expr(node):
+        kind = node['nodeType']
+        if kind == 'YulIdentifier':
+            return (
+                word_bool(ident(node['name']))
+                if binding(node) == 'bool'
+                else ident(node['name'])
+            )
+        if kind == 'YulLiteral' and node['kind'] == 'number':
+            return lit(int(node['value'], 0))
+        if kind != 'YulFunctionCall':
+            raise Unsupported(kind)
+        op = node['functionName']['name']
+        args = [expr(arg) for arg in node['arguments']]
+        ops = {'add': '+', 'mul': '*', 'sub': '-', 'and': '&', 'or': '|', 'xor': '^'}
+        if op in ops:
+            return binary(ops[op], *args)
+        if op in ('eq', 'lt', 'gt'):
+            return word_bool(binary({'eq': '==', 'lt': '<', 'gt': '>'}[op], *args))
+        if op == 'byte':
+            index, word = args
+            shift = binary('*', binary('-', lit(31), index), lit(8))
+            return choose(
+                binary('<', index, lit(32)),
+                binary('&', binary('>>', word, shift), lit(255)),
+                lit(0),
+            )
+        if op == 'not':
+            return n('UnaryOperation', operator='~', prefix=True, subExpression=args[0])
+        if op == 'iszero':
+            return word_bool(binary('==', args[0], lit(0)))
+        if op in ('shl', 'shr'):
+            return binary('<<' if op == 'shl' else '>>', args[1], args[0])
+        if op in ('mulmod', 'addmod', 'div', 'mod'):
+            value = (
+                call(ident(op), *args)
+                if op.endswith('mod') and len(args) == 3
+                else binary('/' if op == 'div' else '%', *args)
+            )
+            return choose(binary('==', args[-1], lit(0)), lit(0), value)
+        raise Unsupported(f'assembly builtin {op}')
+
+    def signature(node):
+        if node['nodeType'] == 'YulLiteral' and node['kind'] == 'number':
+            return int(node['value'], 0)
+        if node['nodeType'] == 'YulFunctionCall':
+            return (
+                node['functionName']['name'],
+                *(signature(x) for x in node['arguments']),
+            )
+        return None
+
+    stmts = block['AST']['statements']
+    # Two scratch-word writes followed by a terminal revert have exactly this
+    # Panic(uint256) ABI payload; require the complete layout and control flow.
+    if len(stmts) == 3 and all(
+        s['nodeType'] == 'YulExpressionStatement' for s in stmts
+    ):
+        first, second, last = [s['expression'] for s in stmts]
+        if (
+            signature(first) == ('mstore', 0, 0x4E487B71)
+            and signature(second) == ('mstore', 32, None)
+            and signature(last) == ('revert', 28, 36)
+        ):
+            payload = expr(second['arguments'][1])
+            if used != refs.keys():
+                raise Unsupported('unconsumed panic binding')
+            return n('RevertStatement', errorCall=call(ident('#yul.panic'), payload)), {
+                '#yul.panic'
+            }
+    out = []
+    for stmt in stmts:
+        kind = stmt['nodeType']
+        if kind not in ('YulVariableDeclaration', 'YulAssignment'):
+            raise Unsupported(
+                f'assembly {kind}: {stmt.get("expression", {}).get("functionName", {}).get("name", "")}'
+            )
+        value = expr(stmt['value'])
+        if kind == 'YulVariableDeclaration':
+            (target,) = stmt['variables']
+            name = target['name']
+            if (
+                name in locals_
+                or name in (name for name, _ in refs.values())
+                or target.get('type')
+            ):
+                raise Unsupported('unsupported Yul declaration')
+            locals_.add(name)
+            out.append(
+                n(
+                    'VariableDeclarationStatement',
+                    declarations=[variable(name)],
+                    initialValue=value,
+                )
+            )
+        else:
+            (target,) = stmt['variableNames']
+            if binding(target) == 'bool':
+                # Arbitrary dirty bits cannot be faithfully stored in a Solidity bool.
+                if stmt['value'].get('functionName', {}).get('name') not in (
+                    'iszero',
+                    'eq',
+                    'lt',
+                    'gt',
+                ):
+                    raise Unsupported('assembly assignment of noncanonical bool')
+                value = binary('!=', value, lit(0))
+            out.append(
+                n(
+                    'ExpressionStatement',
+                    expression=n(
+                        'Assignment',
+                        operator='=',
+                        leftHandSide=ident(target['name']),
+                        rightHandSide=value,
+                    ),
+                )
+            )
+    if used != refs.keys():
+        raise Unsupported('unconsumed assembly external reference')
+    return n('UncheckedBlock', statements=out), set()
+
+
+def lower_assembly(ast):
+    ast = deepcopy(ast)
+    decls = {
+        v['id']: v
+        for v in walk(ast)
+        if v.get('nodeType') == 'VariableDeclaration' and 'id' in v
+    }
+    for contract in ast['nodes']:
+        intrinsics = set()
+
+        def rewrite(node, unchecked=False):
+            if isinstance(node, list):
+                for child in node:
+                    rewrite(child, unchecked)
+            elif isinstance(node, dict):
+                if node.get('nodeType') == 'InlineAssembly':
+                    replacement, names = lower_block(node, decls)
+                    intrinsics.update(names)
+                    if unchecked and replacement['nodeType'] == 'UncheckedBlock':
+                        replacement['nodeType'] = 'Block'
+                    node.clear()
+                    node.update(replacement)
+                    return
+                unchecked = unchecked or node.get('nodeType') == 'UncheckedBlock'
+                for value in node.values():
+                    rewrite(value, unchecked)
+
+        rewrite(contract)
+        for name in sorted(intrinsics):
+            if contract.get('nodeType') != 'ContractDefinition':
+                raise Unsupported('assembly intrinsic outside contract')
+            param = variable('code')
+            if name == '#yul.rethrow':
+                param.update(
+                    name='data',
+                    typeName=n('ElementaryTypeName', name='bytes'),
+                    storageLocation='default',
+                )
+            contract['nodes'].append(
+                n(
+                    'ErrorDefinition',
+                    name=name,
+                    parameters=n('ParameterList', parameters=[param]),
+                )
+            )
+    return ast
