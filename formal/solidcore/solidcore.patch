@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Run with Python 3.10+, solc 0.8.35, Anvil and SolidCore's pinned Lake/Lean.
+From the SolidCore checkout, run:
+    lake build +SolidCore.Solidity.Checked:olean
+    python3 prototypes/mul512/replay.py /path/to/zoltar
+
+The --solc and --anvil flags select local binaries. The kernel theorem covers
+the imported word block. The differential test independently checks lowering
+through SolidCore's Solidity interpreter and execution on a fresh local EVM.
+"""
+import argparse
+from contextlib import contextmanager
+from copy import deepcopy
+import json
+from pathlib import Path
+import random
+import re
+import subprocess
+import time
+from tempfile import TemporaryDirectory
+from threading import Thread
+from urllib.request import urlopen, Request
+
+from import_word import import_block
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+W = 2**256
+
+
+def compile_probe(repo, compiler):
+    version = subprocess.check_output([compiler, '--version'], text=True)
+    if 'Version: 0.8.35+commit.47b9dedd' not in version:
+        raise ValueError('expected native solc 0.8.35')
+    base = repo / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/utils'
+    sources = {key: {'content': (base / key).read_text()}
+               for key in ['math/Math.sol', 'math/SafeCast.sol', 'Panic.sol']}
+    sources['Probe.sol'] = {'content': """// SPDX-License-Identifier: MIT
+pragma solidity 0.8.35;
+import {Math} from './math/Math.sol';
+contract Probe {
+    function probe(uint256 a, uint256 b) external pure returns (uint256, uint256) {
+        return Math.mul512(a, b);
+    }
+}"""}
+    settings = {'viaIR': True, 'evmVersion': 'osaka', 'optimizer': {'enabled': True, 'runs': 0},
+                'metadata': {'appendCBOR': False, 'bytecodeHash': 'none'},
+                'outputSelection': {'math/Math.sol': {'': ['ast']},
+                                    'Probe.sol': {'Probe': ['evm.bytecode.object', 'evm.methodIdentifiers']}}}
+    request = {'language': 'Solidity', 'sources': sources, 'settings': settings}
+    out = json.loads(subprocess.check_output([compiler, '--standard-json'],
+                                             input=json.dumps(request), text=True))
+    errors = [e['formattedMessage'] for e in out.get('errors', []) if e['severity'] == 'error']
+    if errors:
+        raise ValueError('\n'.join(errors))
+    contract, = (c for c in out['sources']['math/Math.sol']['ast']['nodes'] if c.get('name') == 'Math')
+    function, = (f for f in contract['nodes'] if f.get('name') == 'mul512')
+    return function, out['contracts']['Probe.sol']['Probe']['evm']
+
+
+def vectors():
+    edges = [0, 1, 2, 2**64-1, 2**128-1, 2**128, 2**128+1, 2**255-1,
+             2**255, W-3, W-2, W-1]
+    rng = random.Random(512)
+    return [(a,b) for a in edges for b in edges] + [
+        (rng.getrandbits(256), rng.getrandbits(256)) for _ in range(256)]
+
+
+def check_rejections(function):
+    for mutation, expected in [('builtin', 'unsupported builtin'), ('binding', 'unsupported outer binding')]:
+        f = deepcopy(function)
+        block = f['body']['statements'][0]
+        if mutation == 'builtin':
+            block['AST']['statements'][0]['value']['functionName']['name'] = 'mload'
+        else:
+            block['externalReferences'][0]['isSlot'] = True
+        try:
+            import_block(f)
+        except ValueError as e:
+            if expected not in str(e):
+                raise
+        else:
+            raise ValueError(f'importer silently accepted {mutation}')
+
+
+def run_lean(function, pairs, tmp):
+    # The proof below is attached to this concrete ABI and its two named returns.
+    if [[p['name'] for p in function[k]['parameters']] for k in ['parameters','returnParameters']] != [
+            ['a','b'], ['high','low']]:
+        raise ValueError('unexpected mul512 signature')
+    steps, header = import_block(function)
+    code = (HERE/'Probe.lean.in').read_text().replace('__HEADER__',header).replace('__STEPS__',steps)
+    code = (HERE/'WordBlock.lean').read_text() + '\n' + code.replace('__PROOF__',(HERE/'Proof.lean.in').read_text())
+    script, inputs = tmp/'Mul512.lean', tmp/'vectors.txt'
+    script.write_text(code)
+    inputs.write_text(''.join(f'{a} {b}\n' for a,b in pairs))
+    cmd = ['lake','env','lean','-s','131072','-DmaxRecDepth=16384','--trust=0',
+           '-DwarningAsError=true','--run',str(script),str(inputs)]
+    p = subprocess.run(cmd, cwd=ROOT, text=True, stdout=subprocess.PIPE)
+    if p.returncode:
+        raise RuntimeError(p.stdout)
+    lines = p.stdout.splitlines()
+    audit = [s for s in lines if 'exactLimbs' in s]
+    if len(audit) != 1 or not re.fullmatch(
+            r"'.*\.exactLimbs' depends on axioms: \[(?:propext|Classical\.choice|Quot\.sound)(?:, (?:propext|Classical\.choice|Quot\.sound))*\]", audit[0]):
+        raise RuntimeError(f'unexpected kernel audit: {audit}')
+    print(audit[0], flush=True)
+    values = [tuple(map(int,line.split())) for line in lines if line != audit[0]]
+    if len(values) != len(pairs):
+        raise RuntimeError('Lean result count differs from input count')
+    return values
+
+
+@contextmanager
+def local_chain(binary, hardfork='osaka'):
+    process = subprocess.Popen([binary,'--host','127.0.0.1','--port','0','--hardfork',hardfork],
+                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    try:
+        for line in process.stdout:
+            match = re.search(r'Listening on (127\.0\.0\.1:\d+)', line)
+            if match:
+                Thread(target=process.stdout.read, daemon=True).start()
+                yield 'http://' + match[1]
+                return
+        raise RuntimeError('Anvil exited before listening')
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+        process.stdout.close()
+
+
+def rpc(url, method, params):
+    payload = json.dumps({'jsonrpc':'2.0','id':1,'method':method,'params':params}).encode()
+    with urlopen(Request(url, data=payload, headers={'Content-Type':'application/json'}), timeout=15) as r:
+        result = json.load(r)
+    if 'error' in result:
+        raise RuntimeError(result['error'])
+    return result['result']
+
+
+def compare(url, evm, pairs, lean):
+    account = rpc(url, 'eth_accounts', [])[0]
+    tx = rpc(url, 'eth_sendTransaction', [{'from':account, 'data':'0x'+evm['bytecode']['object'],
+                                           'gas':hex(3_000_000)}])
+    deadline = time.monotonic() + 20
+    receipt = rpc(url, 'eth_getTransactionReceipt', [tx])
+    while receipt is None and time.monotonic() < deadline:
+        time.sleep(0.05)
+        receipt = rpc(url, 'eth_getTransactionReceipt', [tx])
+    if receipt is None or int(receipt['status'],16) != 1:
+        raise RuntimeError(f'deployment failed: {receipt}')
+    address = receipt['contractAddress']
+    selector = evm['methodIdentifiers']['probe(uint256,uint256)']
+    for (a,b), got in zip(pairs, lean, strict=True):
+        raw = rpc(url, 'eth_call', [{'to':address,'data':f'0x{selector}{a:064x}{b:064x}'}, 'latest'])
+        if len(raw) != 130:
+            raise ValueError(f'unexpected ABI return: {raw}')
+        solidity = (int(raw[2:66],16), int(raw[66:],16))
+        exact = divmod(a*b,W)
+        if not got == solidity == exact:
+            raise AssertionError(f'{a=} {b=} SolidCore={got} Solidity={solidity} product limbs={exact}')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar',type=Path)
+    cli.add_argument('--solc',default='solc')
+    cli.add_argument('--anvil',default='anvil')
+    args = cli.parse_args()
+    function, evm = compile_probe(args.zoltar, args.solc)
+    check_rejections(function)
+    pairs = vectors()
+    with TemporaryDirectory() as work:
+        results = run_lean(function, pairs, Path(work))
+    with local_chain(args.anvil) as url:
+        compare(url, evm, pairs, results)
+    print(f'{len(pairs)} pairs matched in checked SolidCore, imported word semantics, Anvil and exact arithmetic')
