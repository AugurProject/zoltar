+def split_fresh_bytes(stmts):
+    """Copy the two disjoint halves of bytes memory into fresh buffers."""
+    for pos in range(3, len(stmts)):
+        block = stmts[pos]
+        if not isinstance(block, dict) or block.get('nodeType') != 'InlineAssembly':
+            continue
+        if set(block.get('flags', [])) - {'memory-safe'}:
+            continue
+        ops = block['AST']['statements']
+        if len(ops) != 2 or any(x['nodeType'] != 'YulExpressionStatement' for x in ops):
+            continue
+        defs = stmts[pos - 3 : pos]
+        if any(
+            not isinstance(s, dict)
+            or s.get('nodeType') != 'VariableDeclarationStatement'
+            or len(s['declarations']) != 1
+            or not s['declarations'][0]
+            for s in defs
+        ):
+            continue
+        length, first, second = [s['declarations'][0] for s in defs]
+        calc, new1, new2 = [s.get('initialValue') or {} for s in defs]
+
+        def size_of(expr):
+            if (
+                expr.get('nodeType') == 'MemberAccess'
+                and expr['memberName'] == 'length'
+            ):
+                base = expr['expression']
+                if (
+                    base.get('nodeType') == 'Identifier'
+                    and base.get('typeDescriptions', {}).get('typeIdentifier')
+                    == 't_bytes_memory_ptr'
+                ):
+                    return base
+            return {}
+
+        if (
+            calc.get('operator') != '/'
+            or calc.get('rightExpression', {}).get('value') != '2'
+            or length['typeName'].get('name') != 'uint256'
+        ):
+            continue
+        source = size_of(calc['leftExpression'])
+        if not source:
+            continue
+        if any(
+            v.get('storageLocation') != 'memory' or v['typeName'].get('name') != 'bytes'
+            for v in (first, second)
+        ):
+            continue
+        if any(
+            c.get('nodeType') != 'FunctionCall'
+            or c['expression'].get('nodeType') != 'NewExpression'
+            or c['expression']['typeName'].get('name') != 'bytes'
+            or len(c['arguments']) != 1
+            for c in (new1, new2)
+        ):
+            continue
+        size = new2['arguments'][0]
+        if (
+            new1['arguments'][0].get('referencedDeclaration') != length['id']
+            or size.get('operator') != '-'
+            or size.get('rightExpression', {}).get('referencedDeclaration')
+            != length['id']
+            or size_of(size['leftExpression']).get('referencedDeclaration')
+            != source['referencedDeclaration']
+        ):
+            continue
+        a, b, k, data = [x['name'] for x in (first, second, length, source)]
+        ref_ids = {
+            a: first['id'],
+            b: second['id'],
+            k: length['id'],
+            data: source['referencedDeclaration'],
+        }
+        refs = {r['src']: r for r in block['externalReferences']}
+        reads = [
+            x
+            for x in walk(ops)
+            if x.get('nodeType') == 'YulIdentifier' and x['name'] in ref_ids
+        ]
+        if (
+            len(ref_ids) != 4
+            or {x['src'] for x in reads} != set(refs)
+            or any(refs[x['src']]['declaration'] != ref_ids[x['name']] for x in reads)
+        ):
+            continue
+        if any(
+            r['isSlot'] or r['isOffset'] or r.get('suffix') or r['valueSize'] != 1
+            for r in refs.values()
+        ):
+            continue
+        start = ('add', data, 32)
+        if [yul_expr(x['expression']) for x in ops] != [
+            ('mcopy', ('add', a, 32), start, k),
+            ('mcopy', ('add', b, 32), ('add', start, k), ('sub', ('mload', data), k)),
+        ]:
+            continue
+
+        def at(name, index):
+            return n('IndexAccess', baseExpression=ident(name), indexExpression=index)
+
+        def copy_loop(target, offset):
+            index = ident('#copy_index')
+            rhs_index = binary('+', offset, index) if offset else index
+            write = n(
+                'Assignment',
+                operator='=',
+                leftHandSide=at(target, index),
+                rightHandSide=at(data, rhs_index),
+            )
+            increment = n(
+                'Assignment',
+                operator='=',
+                leftHandSide=index,
+                rightHandSide=binary('+', index, lit(1)),
+            )
+            return n(
+                'Block',
+                statements=[
+                    n(
+                        'VariableDeclarationStatement',
+                        declarations=[variable('#copy_index')],
+                        initialValue=lit(0),
+                    ),
+                    n(
+                        'WhileStatement',
+                        condition=binary(
+                            '<',
+                            index,
+                            n(
+                                'MemberAccess',
+                                expression=ident(target),
+                                memberName='length',
+                            ),
+                        ),
+                        body=n(
+                            'Block',
+                            statements=[
+                                n('ExpressionStatement', expression=write),
+                                n('ExpressionStatement', expression=increment),
+                            ],
+                        ),
+                    ),
+                ],
+            )
+
+        stmts[pos] = n('Block', statements=[copy_loop(a, None), copy_loop(b, ident(k))])
+
