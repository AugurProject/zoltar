+"""Compare the byte-buffer overload of Math.tryModExp with the Osaka precompile."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    directory = (
+        repo / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/utils'
+    )
+    sources = {
+        p: (directory / p).read_text()
+        for p in ('Panic.sol', 'math/SafeCast.sol', 'math/Math.sol')
+    }
+    wrapper = """
+contract Power {
+    function power(bytes memory b, bytes memory e, bytes memory m) external view returns(bool,bytes memory) {
+        return Math.tryModExp(b,e,m);
+    }
+}
+"""
+    flat = (
+        '\n'.join(
+            re.sub(r'(?m)^(?:// SPDX-License-Identifier:.*|import [^;]+;)', '', s)
+            for s in sources.values()
+        )
+        + wrapper
+    )
+    compiled = compile_solc(
+        compiler,
+        {'Flat.sol': flat},
+        {
+            '*': {
+                '': ['ast'],
+                'Power': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    ast = compiled['sources']['Flat.sol']['ast']
+    evm = compiled['contracts']['Flat.sol']['Power']['evm']
+    model = importer.render_module(
+        lower_assembly(project(ast, 'Power')),
+        'Flat.sol',
+        'Power',
+        'SolidCore.Solidity.BytePower',
+        True,
+    )
+
+    def word(n):
+        return n.to_bytes(32, 'big')
+
+    def dynamic(b):
+        return word(len(b)) + b + b'\0' * (-len(b) % 32)
+
+    addr = '0x' + '73' * 20
+    rows = []
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for b, e, m in [
+            (b'', b'', b''),
+            (b'\x04', b'\x03', b'\x00\x00'),
+            (b'', b'', b'\x07'),
+            (b'\x02', b'\x08', b'\x05'),
+            (bytes(range(32)), b'\x02', bytes(range(33))),
+            (b'\x02', b'\x03', b'\x01' + bytes(1024)),
+        ]:
+            parts = [dynamic(x) for x in (b, e, m)]
+            calldata = (
+                bytes.fromhex(evm['methodIdentifiers']['power(bytes,bytes,bytes)'])
+                + b''.join(word(96 + sum(map(len, parts[:i]))) for i in range(3))
+                + b''.join(parts)
+            )
+            out = bytes.fromhex(
+                replay.rpc(
+                    url,
+                    'eth_call',
+                    [
+                        {'to': addr, 'data': '0x' + calldata.hex(), 'gas': '0x989680'},
+                        'latest',
+                    ],
+                )[2:]
+            )
+            success = int.from_bytes(out[:32], 'big')
+            packed = b''.join(word(len(x)) for x in (b, e, m)) + b + e + m
+            if any(m) and len(m) <= 1024:
+                value = pow(
+                    int.from_bytes(b, 'big'),
+                    int.from_bytes(e, 'big'),
+                    int.from_bytes(m, 'big'),
+                ).to_bytes(len(m), 'big')
+                expected = True
+            else:
+                expected = False
+                value = packed[: len(m)] if any(m) else b''
+            if success != expected or out != word(expected) + word(64) + dynamic(value):
+                raise AssertionError((len(m), success, out[:96]))
+            # For the oversized operand verify the real EVM outcome above.
+            # The shorter scripted failure below exercises the same overlap
+            # with a smaller Lean AST and statement-fuel budget.
+            if len(m) <= 1024:
+                rows.append((b, e, m, expected, value, value))
+    b, e, m = b'\x02', b'\x05', bytes(range(1, 34))
+    prefix = word(1) + word(1) + word(33) + b + e + m
+    for ok, returned in [
+        (False, b''),
+        (False, b'\xff'),
+        (True, b'\x42\x82'),
+        (True, bytes(range(40))),
+    ]:
+        copied = min(len(m), len(returned))
+        rows.append(
+            (b, e, m, ok, returned, returned[:copied] + prefix[copied : len(m)])
+        )
+    data = ',\n'.join(
+        '('
+        + ','.join(
+            [
+                str(list(b)),
+                str(list(e)),
+                str(list(m)),
+                str(ok).lower(),
+                str(list(output)),
+                str(list(want)),
+            ]
+        )
+        + ')'
+        for b, e, m, ok, output, want in rows
+    )
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'Power.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract BytePower.importedSourceUnit "Power" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (b,e,m,ok,output,want) in (["""
+            + data
+            + """] : List (List Nat × List Nat × List Nat × Bool × List Nat × List Nat)) do
+    let args := [Source.Value.bytes b,.bytes e,.bytes m]
+    let some tree := Source.ABI.Contract.callWithSelfDispatch 40000 c.core (.name "power") Source.State.empty args
+      | throw (IO.userError "missing function")
+    let packed := Shared.Precompile.modexpInput b e m
+    let responder := Source.responderOfResults [{kind := .staticcall,target := 5,calldata := packed,gas? := some 50000,success := ok,output}] []
+    let ans ← match tree with
+      | .request (.resource .gas) k =>
+        match k (Source.wordToU256 50000) with
+        | t@(.request (.external _ (.call q)) _) =>
+          unless q.calldata == Source.bytesToByteArray packed && q.kind == .staticcall && q.recipient.toNat == 5 do
+            throw (IO.userError "wrong precompile request")
+          pure (Source.SolI.runWith responder t)
+        | _ => throw (IO.userError "missing staticcall")
+      | .done _ => pure (Source.SolI.runWith responder tree)
+      | _ => throw (IO.userError "unexpected query")
+    match ans with
+    | .ok (.returned _ [.word success,.bytes bs]) =>
+      unless success == (if ok then 1 else 0) && bs == want do throw (IO.userError s!"wrong output {m.length} {success} {bs}")
+    | _ => throw (IO.userError "no result")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        '6 Osaka modexp calls and 4 short, failed or overlong source responses checked'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, args.anvil)
