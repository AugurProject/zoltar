+"""Execute the two MCOPYs and their allocating declarations from CreationCodeStorage.store."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+from assembly import lower_assembly
+from muldiv import ROOT, importer, replay, compile_solc
+
+
+def run(repo, compiler, anvil):
+    path = 'solidity/contracts/statoblast/CreationCodeStorage.sol'
+    source = (repo / path).read_text()
+    ast = compile_solc(compiler, {'C.sol': source}, {'*': {'': ['ast']}})['sources'][
+        'C.sol'
+    ]['ast']
+    lib = next(n for n in ast['nodes'] if n.get('name') == 'CreationCodeStorage')
+    statements = next(n for n in lib['nodes'] if n.get('name') == 'store')['body'][
+        'statements'
+    ]
+    end = next(i for i, n in enumerate(statements) if n['nodeType'] == 'InlineAssembly')
+
+    def span(n):
+        start, size, _ = map(int, n['src'].split(':'))
+        return start, start + size
+
+    code = source.encode()[
+        span(statements[end - 3])[0] : span(statements[end])[1]
+    ].decode()
+    probe = (
+        'pragma solidity 0.8.35; contract Split { function split(bytes memory creationCode) external pure returns(bytes memory, bytes memory) {'
+        + code
+        + ' return (first,second); } }'
+    )
+    result = compile_solc(
+        compiler,
+        {'Split.sol': probe},
+        {
+            '*': {
+                '': ['ast'],
+                'Split': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    module = importer.render_module(
+        lower_assembly(result['sources']['Split.sol']['ast']),
+        path,
+        'Split',
+        'SolidCore.Solidity.SplitProbe',
+        True,
+    )
+    evm = result['contracts']['Split.sol']['Split']['evm']
+
+    def tail(b):
+        return f'{len(b):064x}' + b.hex().ljust(64 * ((len(b) + 31) // 32), '0')
+
+    inputs = [bytes(range(n)) for n in (0, 1, 2, 31, 32, 33, 64, 65)]
+    address = '0x' + '33' * 20
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [address, '0x' + evm['deployedBytecode']['object']]
+        )
+        for b in inputs:
+            mid = len(b) // 2
+            first = tail(b[:mid])
+            second = tail(b[mid:])
+            expected = f'0x{64:064x}{64 + len(first) // 2:064x}' + first + second
+            data = (
+                '0x' + evm['methodIdentifiers']['split(bytes)'] + f'{32:064x}' + tail(b)
+            )
+            actual = replay.rpc(
+                url, 'eth_call', [{'to': address, 'data': data}, 'latest']
+            )
+            if expected != actual:
+                raise AssertionError((b, actual))
+    with tempfile.TemporaryDirectory() as directory:
+        script = Path(directory) / 'Split.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + module
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract SplitProbe.importedSourceUnit "Split" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for b in ("""
+            + str([list(b) for b in inputs])
+            + """ : List (List Nat)) do
+    match TypeCheck.CheckedContract.callFunctionWithContext 50000 c "split" Source.Context.empty Source.State.empty [.bytes b] with
+    | .ok (.returned _ [.bytes a, .bytes d]) =>
+        unless a == b.take (b.length / 2) && d == b.drop (b.length / 2) do throw (IO.userError "wrong bytes")
+    | x => throw (IO.userError (reprStr x))
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(f'{len(inputs)} source MCOPY split results matched Anvil')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
