+  | Stmt.expr (Expr.call (Expr.ident (marker@"#yul.scratchReturn")) [.positional (.literal (.number text)), .positional value]) => do
+      let offset ← parseNumberNat? text
+      let kind : SolidCore.Solidity.Source.ScratchWrite :=
+        if marker == "#yul.scratchStore" then .word
+        else if marker == "#yul.scratchStore8" then .byte else .returnPrefix
+      return .scratchWrite kind offset (← Expr.toCore? storageNames value)
+  | Stmt.expr (Expr.call (Expr.ident "#yul.log2") [.positional data, .positional t0, .positional t1]) => do
