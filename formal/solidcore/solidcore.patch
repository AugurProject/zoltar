@@ -0,0 +1,155 @@
+"""Replay the vendored three-word Math.tryModExp on each pinned compiler."""
+
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, fork, anvil):
+    directory = (
+        repo / 'solidity/contracts/statoblast/openOracle/openzeppelin/contracts/utils'
+    )
+    src = '\n'.join(
+        re.sub(
+            r'(?m)^(?:// SPDX-License-Identifier:.*|import [^;]+;)',
+            '',
+            (directory / p).read_text(),
+        )
+        for p in ['Panic.sol', 'math/SafeCast.sol', 'math/Math.sol']
+    )
+    src += """
+contract Power {
+    function power(uint b,uint e,uint m,uint prior) external view returns(bool,uint) {
+        assembly ("memory-safe") { mstore(0, prior) }
+        return Math.tryModExp(b,e,m);
+    }
+}
+"""
+    compiled = compile_solc(
+        compiler,
+        {'P.sol': src},
+        {
+            '*': {
+                '': ['ast'],
+                'Power': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+        evm_version=fork,
+    )
+    evm = compiled['contracts']['P.sol']['Power']['evm']
+    model = importer.render_module(
+        lower_assembly(project(compiled['sources']['P.sol']['ast'], 'Power')),
+        'P.sol',
+        'Power',
+        'SolidCore.Solidity.WordPower',
+        True,
+        analyzed_solc_028=fork == 'cancun',
+    )
+    addr = '0x' + '41' * 20
+    prior = 2**255 + 99
+
+    def word(x):
+        return x.to_bytes(32, 'big')
+
+    rows = []
+    with replay.local_chain(anvil, fork) as url:
+        replay.rpc(
+            url, 'anvil_setCode', [addr, '0x' + evm['deployedBytecode']['object']]
+        )
+        for b, e, m in [
+            (0, 0, 0),
+            (7, 3, 0),
+            (0, 0, 1),
+            (0, 0, 13),
+            (3, 22, 17),
+            (2**256 - 1, 2**200 + 5, 2**256 - 189),
+        ]:
+            data = (
+                '0x'
+                + evm['methodIdentifiers']['power(uint256,uint256,uint256,uint256)']
+                + b''.join(map(word, (b, e, m, prior))).hex()
+            )
+            out = bytes.fromhex(
+                replay.rpc(url, 'eth_call', [{'to': addr, 'data': data}, 'latest'])[2:]
+            )
+            result = pow(b, e, m) if m else 0
+            if out != word(bool(m)) + word(result):
+                raise AssertionError((b, e, m, out))
+            rows.append((b, e, m, bool(m), word(result), result))
+    for success, reply in [
+        (False, b''),
+        (False, b'\x09'),
+        (True, b'\x99'),
+        (True, bytes(range(42))),
+    ]:
+        rows.append(
+            (
+                2,
+                3,
+                5,
+                success,
+                reply,
+                int.from_bytes(reply[:32] + word(prior)[len(reply[:32]) :], 'big'),
+            )
+        )
+    table = ',\n'.join(
+        f'({b},{e},{m},{str(ok).lower()},{list(output)},{want})'
+        for b, e, m, ok, output, want in rows
+    )
+    with tempfile.TemporaryDirectory() as tmp:
+        script = Path(tmp) / 'WordPower.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract WordPower.importedSourceUnit "Power" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (b,e,m,ok,output,want) in (["""
+            + table
+            + """] : List (Nat × Nat × Nat × Bool × List Nat × Nat)) do
+    let some tree := Source.ABI.Contract.callWithSelfDispatch 40000 c.core (.name "power") Source.State.empty [.word b,.word e,.word m,.word """
+            + str(prior)
+            + """] | throw (IO.userError "missing power")
+    let payload := [32,32,32,b,e,m].flatMap (Source.wordToBytesBE 32)
+    let responder := Source.responderOfResults [{kind := .staticcall,target := 5,calldata := payload,gas? := some 50000,success := ok,output}] []
+    let result ← match tree with
+      | .request (.resource .gas) k =>
+        if m == 0 then throw (IO.userError "unexpected call on zero modulus")
+        pure (Source.SolI.runWith responder (k (Source.wordToU256 50000)))
+      | .done _ =>
+        unless m == 0 do throw (IO.userError "missing precompile request")
+        pure (Source.SolI.runWith responder tree)
+      | _ => throw (IO.userError "unexpected effect")
+    match result with
+    | .ok (.returned _ [.word s,.word value]) =>
+      unless s == (if ok then 1 else 0) && value == want do throw (IO.userError s!"wrong modexp result {value}")
+    | _ => throw (IO.userError "wrong request or result")
+"""
+        )
+        subprocess.run(
+            ['lake', 'env', 'lean', '-DmaxRecDepth=16384', '--run', script],
+            cwd=ROOT,
+            check=True,
+        )
+    print(
+        f'6 scalar modexp inputs matched Anvil and 4 bounded response overlays passed ({fork})'
+    )
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('repo', type=Path)
+    cli.add_argument('--solc', required=True)
+    cli.add_argument('--oracle-solc', required=True)
+    cli.add_argument('--anvil', required=True)
+    args = cli.parse_args()
+    run(args.repo, args.solc, 'osaka', args.anvil)
+    run(args.repo, args.oracle_solc, 'cancun', args.anvil)
