+"""Compare the deployed code carrier reader with independent Anvil calls."""
+
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+from assembly import lower_assembly
+from muldiv import ROOT, compile_solc, importer, replay
+from project import project
+
+
+def run(repo, compiler, anvil):
+    path = 'solidity/contracts/statoblast/CreationCodeStorage.sol'
+    source = (
+        (repo / path).read_text()
+        + """
+contract Reader {
+    function load(address a,address b) external view returns(bytes memory) {
+        return CreationCodeStorage.load(a,b);
+    }
+}
+"""
+    )
+    result = compile_solc(
+        compiler,
+        {'Reader.sol': source},
+        {
+            '*': {
+                '': ['ast'],
+                'Reader': ['evm.deployedBytecode.object', 'evm.methodIdentifiers'],
+            }
+        },
+    )
+    model = importer.render_module(
+        lower_assembly(project(result['sources']['Reader.sol']['ast'], 'Reader')),
+        path,
+        'Reader',
+        'SolidCore.Solidity.ReadCode',
+        True,
+    )
+    evm = result['contracts']['Reader.sol']['Reader']['evm']
+    addresses = [f'0x{i:040x}' for i in (0x1000, 0x2000, 0x3000)]
+    samples = [
+        (b'\0', b'\0'),
+        (b'\xff\x01', b'\x7f'),
+        (bytes(range(34)), bytes(range(65))),
+        (b'', b''),
+        (b'\0', b''),
+        (b'', b'12'),
+        (b'12', b''),
+    ]
+    with replay.local_chain(anvil) as url:
+        replay.rpc(
+            url,
+            'anvil_setCode',
+            [addresses[0], '0x' + evm['deployedBytecode']['object']],
+        )
+        for a, b in samples:
+            for address, code in zip(addresses[1:], (a, b)):
+                replay.rpc(url, 'anvil_setCode', [address, '0x' + code.hex()])
+            data = (
+                '0x'
+                + evm['methodIdentifiers']['load(address,address)']
+                + ''.join(x[2:].zfill(64) for x in addresses[1:])
+            )
+            try:
+                out = replay.rpc(
+                    url,
+                    'eth_call',
+                    [{'to': addresses[0], 'data': data, 'gas': '0x80000'}, 'latest'],
+                )
+            except RuntimeError as e:
+                if a and b:
+                    raise
+                if len(a) + len(b) < 2:
+                    if '4e487b71' not in str(e).lower():
+                        raise
+                elif 'InvalidOperandOOG' not in str(e):
+                    raise
+                continue
+            payload = a[1:] + b[1:]
+            if (
+                not a
+                or not b
+                or out
+                != '0x'
+                + f'{32:064x}{len(payload):064x}'
+                + payload.hex().ljust(64 * ((len(payload) + 31) // 32), '0')
+            ):
+                raise AssertionError((a, b, out))
+    with tempfile.TemporaryDirectory() as directory:
+        script = Path(directory) / 'Reader.lean'
+        script.write_text(
+            'import SolidCore.Solidity.Checked\n'
+            + model
+            + """
+open SolidCore.Solidity
+def main : IO Unit := do
+  let c ← match TypeCheck.CheckedInput.contract ReadCode.importedSourceUnit "Reader" with
+    | .ok c => pure c
+    | .error e => throw (IO.userError (reprStr e))
+  for (a,b) in ("""
+            + str([(list(a), list(b)) for a, b in samples])
+            + """ : List (List Nat × List Nat)) do
+    let ctx := {Source.Context.empty with accountCodes := [(8192,a),(12288,b)]}
+    match TypeCheck.CheckedContract.callFunctionWithContext 80000 c "load" ctx Source.State.empty [.word 8192,.word 12288] with
+    | .ok (.returned _ [.bytes out]) =>
+        unless !a.isEmpty && !b.isEmpty && out == a.drop 1 ++ b.drop 1 do throw (IO.userError "wrong code")
+    | .ok (.reverted _ (.panic 17)) =>
+        unless a.length + b.length < 2 do throw (IO.userError "unexpected panic")
+    | .ok (.reverted _ (.exceptional .outOfGas)) =>
+        unless (a.isEmpty || b.isEmpty) && a.length + b.length >= 2 do throw (IO.userError "unexpected exceptional halt")
+    | result => throw (IO.userError s!"unexpected code reader result {a.length} {b.length} {repr result}")
+"""
+        )
+        subprocess.run(['lake', 'env', 'lean', '--run', script], cwd=ROOT, check=True)
+    print(f'{len(samples)} code tail reads matched Anvil')
+
+
+if __name__ == '__main__':
+    cli = argparse.ArgumentParser(description=__doc__)
+    cli.add_argument('zoltar', type=Path)
+    cli.add_argument('--solc', default='solc')
+    cli.add_argument('--anvil', default='anvil')
+    args = cli.parse_args()
+    run(args.zoltar, args.solc, args.anvil)
