import Inv39Model
open SolidCore.Solidity SolidCore.Solidity.Source
namespace Inv39.Coverage
def mutations : List String := ["initialize","mint","burn","permit","transferWithAuthorization","receiveWithAuthorization","cancelAuthorization","transfer","approve","transferFrom"]
def views : List String := ["zoltar","universeId","repNumber","getTotalTheoreticalSupply","nonces","DOMAIN_SEPARATOR","authorizationState","name","symbol","decimals","totalSupply","balanceOf","allowance"]
/-- Excludes interpreter-internal aliases, which are not Solidity public entry points. -/
def publicNames := (model.core.functions.filter (fun f => !f.name.startsWith "__internal_")).map FunctionDef.name
theorem publicSurface : publicNames = ["zoltar","universeId","repNumber","initialize","mint","burn","getTotalTheoreticalSupply","nonces","DOMAIN_SEPARATOR","permit","transferWithAuthorization","receiveWithAuthorization","cancelAuthorization","authorizationState","name","symbol","decimals","totalSupply","balanceOf","transfer","allowance","approve","transferFrom"] := by native_decide
theorem classified : ∀ name ∈ publicNames, name ∈ mutations ∨ name ∈ views := by
  rw [publicSurface]
  decide
/-- Source-level check of view/pure exclusions on all declared public/external methods,
including inherited interfaces; autogenerated scalar getters are read-only by construction. -/
def sourceClassified : Bool := Inv39Generated.importedContracts.all fun decl => decl.items.all fun item =>
  match item with
  | .function f =>
    let public_ := match f.visibility with | some .public_ | some .external_ => true | _ => false
    match f.kind,f.name with
    | .function,some name => if public_ then
        match f.mutability with
        | .view | .pure => views.contains name
        | _ => mutations.contains name
      else true
    | _,_ => true
  | _ => true
theorem sourceClassification : sourceClassified=true := by native_decide
end Inv39.Coverage
