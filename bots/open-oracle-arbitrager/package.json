{
	"name": "@zoltar/open-oracle-arbitrager",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Independent OpenOracle monitoring and arbitrage execution service",
	"imports": {
		"#cli/*": "./src/cli/*.ts",
		"#config/*": "./src/config/*.ts",
		"#contracts/*": "./src/contracts/*.ts",
		"#core/*": "./src/core/*.ts",
		"#dashboard/*": "./src/dashboard/*.ts",
		"#ethereum": "./src/infrastructure/ethereum.ts",
		"#execution/*": "./src/execution/*.ts",
		"#monitoring/*": "./src/monitoring/*.ts",
		"#state/*": "./src/state/*.ts"
	},
	"scripts": {
		"compile-contracts": "bun ./scripts/compile-contracts.mts",
		"build:docs": "bun ./scripts/build-doc-runtime.mts",
		"generate:abi": "bun ./scripts/generate-executor-abi.mts",
		"check:generated": "bun ./scripts/compile-contracts.mts --check && bun ./scripts/generate-executor-abi.mts --check && bun ./scripts/build-doc-runtime.mts --check",
		"check:docs": "bun ./scripts/check-docs.mts && bun ./scripts/check-market-fixture.mts",
		"typecheck": "bun x tsc --project tsconfig.json --noEmit",
		"test": "bun ./scripts/compile-contracts.mts --check && bun test ./tests --timeout 300000",
		"format": "bun x @biomejs/biome format --write package.json tsconfig.json bunfig.toml README.md src tests scripts docs/*.ts docs/*.html docs/*.css docs/*.json config && bun x prettier --write 'contracts/**/*.sol'",
		"format:check": "bun x @biomejs/biome format package.json tsconfig.json bunfig.toml README.md src tests scripts docs/*.ts docs/*.html docs/*.css docs/*.json config && bun x prettier --check 'contracts/**/*.sol'",
		"check": "bun run typecheck && bun run check:generated && bun run test && bun run check:docs && bun run format:check",
		"run": "bun ./src/cli/run.ts",
		"deploy-executor": "bun run compile-contracts && bun ./src/cli/deploy-executor.ts",
		"reconcile": "bun ./src/cli/reconcile-position.ts",
		"manifest": "bun ./src/config/execution-manifest.ts"
	},
	"dependencies": {
		"@noble/hashes": "2.2.0",
		"@zoltar/bot-shared": "file:../shared",
		"@zoltar/shared": "file:../../shared",
		"micro-eth-signer": "0.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"bun-types": "1.3.11",
		"happy-dom": "20.10.6",
		"prettier": "3.8.4",
		"prettier-plugin-solidity": "2.3.1",
		"solc": "0.8.35",
		"typescript": "5.8.2"
	}
}
