{
	"extends": "../../shared/tsconfig.strict.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["bun-types", "node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
