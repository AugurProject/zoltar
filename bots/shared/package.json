{
	"name": "@zoltar/bot-shared",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./config/canonical-deployment": "./src/config/canonical-deployment.ts",
		"./config/durable-replacement": "./src/config/durable-replacement.ts",
		"./config/profiles": "./src/config/profiles.ts",
		"./config/persistent-path": "./src/config/persistent-path.ts",
		"./contracts/abi": "./src/contracts/abi.generated.ts",
		"./config/signer": "./src/config/signer.ts",
		"./dashboard/assets": "./src/dashboard/assets.ts",
		"./dashboard/components": "./src/dashboard/components.ts",
		"./dashboard/connectivity-error": "./src/dashboard/connectivity-error.ts",
		"./dashboard/forms": "./src/dashboard/forms.ts",
		"./dashboard/header": "./src/dashboard/header.ts",
		"./dashboard/polling": "./src/dashboard/polling.ts",
		"./dashboard/resume-preflight": "./src/dashboard/resume-preflight.ts",
		"./dashboard/section-navigation": "./src/dashboard/section-navigation.ts",
		"./dashboard/security": "./src/dashboard/security.ts",
		"./dashboard/universe-explorer": "./src/dashboard/universe-explorer.ts",
		"./ethereum": "./src/ethereum.ts",
		"./ethereum/rpc-transport": "./src/ethereum/rpc-transport.ts",
		"./execution/signer-operation-gate": "./src/execution/signer-operation-gate.ts",
		"./execution/canonical-finality": "./src/execution/canonical-finality.ts",
		"./execution/bot-process-locks": "./src/execution/bot-process-locks.ts",
		"./execution/process-lock": "./src/execution/process-lock.ts",
		"./infrastructure/compare": "./src/infrastructure/compare.ts",
		"./infrastructure/json-validation": "./src/infrastructure/json-validation.ts",
		"./execution/transaction-submission": "./src/execution/transaction-submission.ts",
		"./monitoring/universe-policy": "./src/monitoring/universe-policy.ts",
		"./monitoring/block-sync": "./src/monitoring/block-sync.ts",
		"./monitoring/connectivity": "./src/monitoring/connectivity.ts",
		"./monitoring/centralized-markets": "./src/monitoring/centralized-markets.ts",
		"./monitoring/constant-product-markets": "./src/monitoring/constant-product-markets.ts",
		"./monitoring/deployed-contracts": "./src/monitoring/deployed-contracts.ts",
		"./monitoring/head-watcher": "./src/monitoring/head-watcher.ts",
		"./monitoring/log-availability": "./src/monitoring/log-availability.ts",
		"./monitoring/market-consensus": "./src/monitoring/market-consensus.ts",
		"./monitoring/read-quorum": "./src/monitoring/read-quorum.ts",
		"./monitoring/rpc-quorum-policy": "./src/monitoring/rpc-quorum-policy.ts",
		"./monitoring/resilience": "./src/monitoring/resilience.ts"
	},
	"scripts": {
		"check": "bun run typecheck && bun run lint && bun run check:generated && bun run test && bun run format:check",
		"check:generated": "bun run ensure-contract-artifacts && bun ../../tooling/contracts/generate-bot-abis.mts --check",
		"ensure-contract-artifacts": "bun ../../tooling/contracts/ensure-contract-artifacts.mts",
		"generate:abi": "bun run ensure-contract-artifacts && bun ../../tooling/contracts/generate-bot-abis.mts",
		"format": "bun x @biomejs/biome format --write biome.json package.json tsconfig.json src tests",
		"format:check": "bun x @biomejs/biome format biome.json package.json tsconfig.json src tests",
		"lint": "bun x @biomejs/biome lint package.json tsconfig.json src tests && bun ../../tooling/repo/lint-no-restricted-import-types.mts .",
		"test": "bun run ensure-contract-artifacts && bun test ./tests",
		"typecheck": "bun run ensure-contract-artifacts && bun x tsc --project tsconfig.json --noEmit"
	},
	"dependencies": {
		"ccxt": "4.5.70",
		"@zoltar/core-shared": "file:../../shared/core"
	},
	"overrides": {
		"undici": "7.29.0",
		"@zoltar/core-shared": "file:../../shared/core"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"bun-types": "1.4.2",
		"typescript": "5.8.2"
	}
}
