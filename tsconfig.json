{
	"extends": "./shared/tsconfig.source-paths.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"types": [],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"noEmit": true
	},
	"include": ["shared/*/ts/**/*.ts", "ui/*/ts/**/*.ts", "ui/*/ts/**/*.tsx"]
}
