{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@zoltar/core-shared/*": ["shared/core/ts/*"],
			"@zoltar/zoltar-shared/*": ["shared/zoltar/ts/*"],
			"@zoltar/open-oracle-shared/*": ["shared/openOracle/ts/*"],
			"@zoltar/statoblast-shared/*": ["shared/statoblast/ts/*"],
			"@zoltar/trading-shared/*": ["shared/trading/ts/*"]
		},
		"sourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true,
		"strict": true,
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": ["ESNext", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"types": [],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"noEmit": true
	},
	"include": ["shared/*/ts/**/*.ts", "ui/coreShared/ts/**/*.ts", "ui/coreShared/ts/**/*.tsx", "ui/zoltar/ts/**/*.ts", "ui/zoltar/ts/**/*.tsx", "ui/statoblast/ts/**/*.ts", "ui/statoblast/ts/**/*.tsx"]
}
