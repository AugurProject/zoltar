{
	"extends": "./shared/tsconfig.strict.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@zoltar/core-shared/*": ["shared/core/ts/*"],
			"@zoltar/zoltar-shared/*": ["shared/zoltar/ts/*"],
			"@zoltar/open-oracle-shared/*": ["shared/openOracle/ts/*"],
			"@zoltar/statoblast-shared/*": ["shared/statoblast/ts/*"],
			"@zoltar/trading-shared/*": ["shared/trading/ts/*"],
			"@zoltar/ui-core-shared/*": ["ui/coreShared/ts/*"],
			"@zoltar/ui-zoltar-shared/*": ["ui/zoltarShared/ts/*"],
			"@zoltar/ui-statoblast-shared/*": ["ui/statoblastShared/ts/*"]
		},
		"sourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "DOM"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"types": [],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"noEmit": true
	},
	"include": ["shared/*/ts/**/*.ts", "ui/*/ts/**/*.ts", "ui/*/ts/**/*.tsx"]
}
