	},
	"functionSignatures": {
		"executeStagedOperation": "executeStagedOperation(uint256)",
		"getActiveStagedOperations": "getActiveStagedOperations(uint256,uint256)",
		"getPendingOperationSlot": "getPendingOperationSlot()",
		"getQueuedOperationCostAttoEth": "getQueuedOperationCostAttoEth()",
		"openOracleCallback": "openOracleCallback(uint256,uint256,uint256,uint256,address,address)",
		"recoverSettledPendingReport": "recoverSettledPendingReport()",
		"requestPrice": "requestPrice(uint256,uint256)",
		"requestPriceIfNeededAndStageOperation": "requestPriceIfNeededAndStageOperation(uint8,address,uint256,uint256,uint256,uint256)",
		"setRepEthPrice": "setRepEthPrice(uint256)",
		"setSecurityPool": "setSecurityPool(address)",
