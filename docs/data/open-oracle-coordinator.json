		"lastSettlementTimestamp": "view",
		"maxSettlementBaseFeeMultiplierBps": "view",
		"minLiquidationPriceDistanceBps": "view",
		"minimumToken1ReportAttoEth": "view",
		"multiplier": "view",
		"openOracle": "view",
		"openOracleCallback": "nonpayable",
		"openOracleSecurityMultiplierBps": "view",
		"pendingOperationSlotId": "view",
		"pendingReportId": "view",
		"pendingReportMaxSettlementBaseFeeAttoEthPerGas": "view",
		"pendingReportSponsor": "view",
		"protocolFee": "view",
		"protocolFeeRecipient": "view",
		"recoverSettledPendingReport": "nonpayable",
		"reputationToken": "view",
		"requestPrice": "payable",
		"requestPriceIfNeededAndStageOperation": "payable",
		"securityPool": "view",
		"setRepEthPrice": "nonpayable",
		"setSecurityPool": "nonpayable",
		"settlementTime": "view",
		"stagedOperationCounter": "view",
