{
	"plugins": ["prettier-plugin-solidity"],
	"overrides": [
		{
			"files": "**/*.html",
			"options": {
				"htmlWhitespaceSensitivity": "css",
				"printWidth": 100000,
				"proseWrap": "never",
				"singleAttributePerLine": false,
				"tabWidth": 4,
				"useTabs": true
			}
		},
		{
			"files": "**/*.sol",
			"options": {
				"parser": "slang",
				"printWidth": 120,
				"tabWidth": 4,
				"useTabs": true,
				"singleQuote": true,
				"bracketSpacing": true
			}
		}
	]
}
