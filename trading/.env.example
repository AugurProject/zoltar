# Local Anvil defaults. Do not put private keys or secrets in this file.
TRADING_RPC_URL=http://127.0.0.1:8545
# Optional: set this to an unlocked RPC account. When omitted, deployment uses eth_accounts[0].
# TRADING_DEPLOYER=0x1111111111111111111111111111111111111111
ZOLTAR_DEPLOYMENT_MANIFEST=/absolute/path/to/local-zoltar-deployment.json
TRADING_FEE_BPS=30
# Optional build-time source copied to untracked ui/dist/deployment.json.
# TRADING_UI_DEPLOYMENT=/absolute/path/to/trading/deployments/local.json
