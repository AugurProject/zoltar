{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://zoltar.example/schemas/open-oracle-execution-manifest-v1.json",
	"title": "Zoltar OpenOracle arbitrager execution manifest",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "network", "chainId", "contracts"],
	"properties": {
		"version": {
			"const": 1
		},
		"network": {
			"enum": ["mainnet", "sepolia"]
		},
		"chainId": {
			"type": "integer",
			"minimum": 1
		},
		"contracts": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["role", "address", "runtimeCodeHash"],
				"properties": {
					"role": {
						"enum": ["coordinator", "executor", "open-oracle", "token", "uniswap-factory", "uniswap-quoter", "uniswap-router", "weth"]
					},
					"address": {
						"type": "string",
						"pattern": "^0x[0-9a-fA-F]{40}$"
					},
					"runtimeCodeHash": {
						"type": "string",
						"pattern": "^0x[0-9a-fA-F]{64}$"
					}
				}
			}
		}
	}
}
